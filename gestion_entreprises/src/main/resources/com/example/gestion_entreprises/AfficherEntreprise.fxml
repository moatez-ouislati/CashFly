<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.gestion_entreprises.controllers.AfficherE">

    <top>
        <HBox spacing="10">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <TextField fx:id="txtSearch" prefWidth="250" promptText="Rechercher..." />

            <ComboBox fx:id="cbSort" prefWidth="200" promptText="Trier par" style="-fx-background-color: #ffffff;" />

            <Button onAction="#sortEntreprise" style="-fx-background-color: #013b63;" text="Trier" textFill="WHITE">
            <font>
               <Font name="System Bold" size="12.0" />
            </font></Button>
            <Button onAction="#refresh" style="-fx-background-color: #d96623;" text="Actualiser" textFill="WHITE">
            <font>
               <Font name="System Bold" size="12.0" />
            </font></Button>
            <Button onAction="#retour" style="-fx-background-color: #B10F0F;" text="Retour" textFill="WHITE">
            <font>
               <Font name="System Bold" size="12.0" />
            </font></Button>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <FlowPane fx:id="cardsContainer"
                          hgap="20"
                          vgap="20"
                          prefWrapLength="1100"/>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <VBox fx:id="weatherCard" spacing="10">
            <padding>
                <Insets bottom="20" left="20" right="20" top="20" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="20">

                <ImageView fx:id="weatherIcon" fitHeight="80" fitWidth="80" />

                <VBox spacing="5">
                    <Label fx:id="labelTemperature" style="-fx-text-fill:white;                                   -fx-font-size:26;                                   -fx-font-weight:bold;" text="-- °C" />

                    <Label fx:id="labelDescription" style="-fx-text-fill:white;                                   -fx-font-size:16;" text="Description" />
                </VBox>

                <VBox spacing="5">
                    <Label fx:id="labelHumidity" style="-fx-text-fill:white;" text="Humidité : -" />

                    <Label fx:id="labelWind" style="-fx-text-fill:white;" text="Vent : -" />
                </VBox>

            </HBox>

        </VBox>
    </bottom>

</BorderPane>
