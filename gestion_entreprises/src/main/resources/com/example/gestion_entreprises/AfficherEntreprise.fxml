<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.gestion_entreprises.controllers.AfficherE">

    <children>

        <!-- TOP BAR -->
        <HBox layoutX="20" layoutY="20" spacing="10">
            <TextField fx:id="txtSearch" prefWidth="250" promptText="Rechercher par nom..." />

            <ComboBox fx:id="cbSort" prefWidth="170" promptText="Trier par" style="-fx-background-color: #14B8A6;" />

            <Button onAction="#sortEntreprise" prefHeight="26.0" prefWidth="75.0" style="-fx-background-color: #172d9d;" text="Trier" textFill="#efeaea" />
            <Button onAction="#updateEntreprise" prefHeight="26.0" prefWidth="96.0" style="-fx-background-color: #14B8A6;" text="Modifier" textFill="#fffefe" />
            <Button onAction="#retour" prefHeight="26.0" prefWidth="89.0" style="-fx-background-color: #bc160d;" text="Retour" textFill="WHITE" />
        </HBox>

        <!-- TABLE -->
        <TableView fx:id="tableEntreprise" layoutX="20" layoutY="70" prefHeight="500" prefWidth="1060">

            <columns>
                <TableColumn fx:id="colId" prefWidth="80" text="ID" />
                <TableColumn fx:id="colNom" prefWidth="180" text="Nom" />
                <TableColumn fx:id="colSecteur" prefWidth="160" text="Secteur" />
                <TableColumn fx:id="colForme" prefWidth="160" text="Forme Juridique" />
                <TableColumn fx:id="colDate" prefWidth="160" text="Date Création" />
                <TableColumn fx:id="colCapital" prefWidth="160" text="Capital" />
                <TableColumn fx:id="colProprietaire" prefWidth="160" text="ID Propriétaire" />
            </columns>
        </TableView>

        <!-- ACTION BUTTONS -->
        <HBox layoutX="20" layoutY="590" spacing="15">
            <Button onAction="#deleteEntreprise" prefHeight="38.0" prefWidth="118.0" style="-fx-background-color: #bc160d;" stylesheets="@buttons.css" text="Supprimer" textFill="WHITE" />

            <Button onAction="#refresh" prefHeight="42.0" prefWidth="127.0" style="-fx-background-color: #172d9d;" stylesheets="@buttons.css" text="Actualiser" textFill="WHITE" />
        </HBox>

    </children>
</AnchorPane>
