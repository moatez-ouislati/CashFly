<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="558.0" prefWidth="701.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.gestion_entreprises.controllers.NotificationController">

    <children>

        <Label layoutX="30.0" layoutY="25.0" text="Notifications">
            <font>
                <Font size="20"/>
            </font>
        </Label>

        <Label layoutX="80.0" layoutY="100.0" text="Type :" />
        <ComboBox fx:id="noteType"
                  layoutX="240.0"
                  layoutY="95.0"
                  prefWidth="220.0"/>

        <Label layoutX="80.0" layoutY="160.0" text="Message :" />
        <TextField fx:id="textField"
                   layoutX="240.0"
                   layoutY="155.0"
                   prefWidth="220.0"/>

        <Label layoutX="80.0" layoutY="220.0" text="Date :" />
        <DatePicker fx:id="datePicker"
                    layoutX="240.0"
                    layoutY="215.0"
                    prefWidth="220.0"/>

        <Button fx:id="btnAdd"
                layoutX="240.0"
                layoutY="300.0"
                text="Ajouter"
                onAction="#addNotification"/>

        <Button layoutX="340.0"
                layoutY="300.0"
                text="Retour"
                onAction="#retourMenu"/>

    </children>
</AnchorPane>