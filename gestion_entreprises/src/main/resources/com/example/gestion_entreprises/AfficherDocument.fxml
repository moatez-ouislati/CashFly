<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TreeTableColumn?>
<?import javafx.scene.control.TreeTableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.gestion_entreprises.controllers.AfficherD">

    <children>

        <!-- TOP BAR -->
        <HBox layoutX="20" layoutY="20" spacing="10">

            <TextField fx:id="txtSearch" prefWidth="250" promptText="Rechercher entreprise ou document..." />

            <Button onAction="#updateDocument" style="-fx-background-color: #172d9d;" text="Modifier document" textFill="#fcf8f8" />


            <Button onAction="#supprimerDocument" style="-fx-background-color: #bc160d;" text="Supprimer document" textFill="WHITE" />

            <Button onAction="#refresh" style="-fx-background-color: #374151;" text="Actualiser" textFill="#faf7f7" />

            <Button onAction="#retour" style="-fx-background-color: #14B8A6;" text="Retour" textFill="WHITE" />
        </HBox>

        <!-- TREE TABLE -->
        <TreeTableView fx:id="treeTable" layoutX="20" layoutY="70" prefHeight="560" prefWidth="1060">

            <columns>

                <TreeTableColumn fx:id="colNom" prefWidth="350" text="Entreprise / Document" />

                <TreeTableColumn fx:id="colType" prefWidth="150" text="Type" />

                <TreeTableColumn fx:id="colStatut" prefWidth="120" text="Statut" />

                <TreeTableColumn fx:id="colDate" prefWidth="180" text="Date upload" />

            </columns>
        </TreeTableView>

    </children>
</AnchorPane>
