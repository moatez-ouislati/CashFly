<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.gestion_entreprises.controllers.AfficherD">

    <children>

        <VBox spacing="20" layoutX="20" layoutY="20" prefWidth="1060">

            <!-- 🔎 Top Bar -->
            <HBox spacing="10">
                <TextField fx:id="txtSearch"
                           prefWidth="250"
                           promptText="Rechercher document..." />

                <Button text="Actualiser"
                        onAction="#refresh"
                        style="-fx-background-color: #013b63;"
                        textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="13.0"/>
                    </font>
                </Button>

                <Button text="Retour"
                        onAction="#retour"
                        style="-fx-background-color: #B10F0F;"
                        textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="13.0"/>
                    </font>
                </Button>
            </HBox>

            <!-- 🔹 Entreprises Horizontal Scroll -->
            <ScrollPane fitToHeight="true"
                        hbarPolicy="AS_NEEDED"
                        vbarPolicy="NEVER"
                        prefHeight="80"
                        style="-fx-background-color:transparent;">

                <HBox fx:id="entrepriseContainer"
                      spacing="12"
                      style="-fx-padding:10;"/>
            </ScrollPane>

            <!-- 🔹 Documents List -->
            <ScrollPane layoutX="20" layoutY="70" prefHeight="600" prefWidth="1060">
                <content>
                    <FlowPane fx:id="cardContainer"
                              hgap="20"
                              vgap="20"
                              prefWrapLength="1000"/>
                </content>
            </ScrollPane>

        </VBox>

    </children>
</AnchorPane>