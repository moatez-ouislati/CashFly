# Copy this file to .env.local and fill in your values

###> symfony/framework-bundle ###
APP_SECRET=your_secret_key_here
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://root:@localhost:3306/cashflydb?serverVersion=10.4.32-MariaDB&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> AI Services ###
# HuggingFace token (free) - get from https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# OpenAI key (recommendations) - get from https://platform.openai.com/api-keys
OPENAI_KEY=your_openai_key_here

# OpenRouter key (backup AI) - get from https://openrouter.ai/keys
OPENROUTER_KEY=your_openrouter_key_here
###< AI Services ###