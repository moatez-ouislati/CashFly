<footer class="w-full border-t border-white/5 bg-black/40 backdrop-blur-md flex flex-col md:flex-row justify-between items-center px-12 py-10 w-full font-headline text-[10px] uppercase tracking-[0.3em]">
<div class="text-sm font-black text-white mb-6 md:mb-0 tracking-[0.5em] text-neon">
        CASHFLY
    </div>
<div class="flex flex-col md:flex-row items-center gap-10">
<div class="flex gap-10">
<a class="text-slate-500 hover:text-primary transition-all" href="#">Privacy Protocol</a>
<a class="text-slate-500 hover:text-primary transition-all" href="#">User Terms</a>
<a class="text-slate-500 hover:text-primary transition-all" href="#">Network Status</a>
</div>
<p class="text-slate-600 mt-6 md:mt-0">© 2024 CashFly Technologies. Nexus Operational.</p>
