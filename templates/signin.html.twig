<label class="block text-[10px] font-bold text-primary/70 uppercase tracking-[0.2em] ml-1" for="email">Neural ID / Email</label>
<div class="relative group">
<span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 group-focus-within:text-primary transition-colors text-lg">alternate_email</span>
<input class="w-full bg-white/5 border border-white/10 focus:border-primary/50 focus:ring-1 focus:ring-primary/20 rounded-lg py-4 pl-12 pr-4 text-white placeholder-slate-600 transition-all duration-300" id="email" placeholder="agent@network.sys" type="email"/>
</div>
</div>
<div class="space-y-2">
<div class="flex justify-between items-center">
<label class="block text-[10px] font-bold text-primary/70 uppercase tracking-[0.2em] ml-1" for="password">Security Code</label>
<a class="text-[10px] font-bold text-primary/50 hover:text-primary transition-colors duration-200 uppercase tracking-widest" href="#">Reset Link</a>
</div>
<div class="relative group">
<span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-500 group-focus-within:text-primary transition-colors text-lg">vitals</span>
<input class="w-full bg-white/5 border border-white/10 focus:border-primary/50 focus:ring-1 focus:ring-primary/20 rounded-lg py-4 pl-12 pr-12 text-white placeholder-slate-600 transition-all duration-300" id="password" placeholder="••••••••" type="password"/>
<button class="absolute right-4 top-1/2 -translate-y-1/2 text-slate-500 hover:text-primary transition-colors" type="button">
<span class="material-symbols-outlined text-lg">visibility</span>
</button>
</div>
</div>
<!-- CTA Button -->
<a href="{{ path('app_front') }}" class="w-full bg-primary hover:bg-primary/90 text-deep-space font-black py-4 rounded-lg futuristic-glow transform active:scale-[0.98] transition-all duration-300 flex items-center justify-center gap-3 group uppercase tracking-widest text-xs">
    Initialize Dashboard
    <span class="material-symbols-outlined text-xl group-hover:translate-x-1 transition-transform duration-300">double_arrow</span>
</a>
</form>
<!-- Social Logins -->
<div class="mt-12 relative">
<div class="absolute inset-0 flex items-center">
<div class="w-full border-t border-white/5"></div>
</div>
<div class="relative flex justify-center text-[10px]">
<span class="px-4 bg-[#0d1c32]/0 backdrop-blur-sm text-slate-500 font-bold uppercase tracking-[0.3em]">External Sync</span>
</div>
</div>
<div class="mt-8 grid grid-cols-2 gap-4">
<button class="flex items-center justify-center gap-3 bg-white/5 border border-white/10 hover:border-primary/30 hover:bg-white/10 text-white py-3.5 rounded-lg transition-all duration-200 active:scale-[0.98]">
<img alt="Google" class="w-5 h-5 opacity-80" data-alt="clean multi-color google icon on a transparent background" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBvqqWnT12N6xCAJHAxgsL64ROQh157VXXX8ptZwdLaKKDib_v-ug7PH6tN4YLh88xfoWhK-B9RDWsxAc8p0KCHicXdPq-WRTngGGnxpC9NuB4671j81Fv-0t0P11Sup7Iv3fn3FBf7BOQ6SQwasQ3MIw5fUPTM1nY30IOMkZd47IJUz_oRu9fcMf5O9XNghxquKX4pCApOnBPLYV4D1P7l045hA216AMno5hKUZ5Od622PKYSsd_3ycpZ7sQXM2TINriHcf5_xa6s"/>
<span class="text-xs font-bold uppercase tracking-wider">Google</span>
</button>
<button class="flex items-center justify-center gap-3 bg-white/5 border border-white/10 hover:border-primary/30 hover:bg-white/10 text-white py-3.5 rounded-lg transition-all duration-200 active:scale-[0.98]">
<span class="material-symbols-outlined text-xl opacity-80" data-weight="fill">ios</span>
<span class="text-xs font-bold uppercase tracking-wider">Apple</span>
</button>
</div>
<!-- Redirect to Sign Up -->
<p class="mt-10 text-center text-slate-500 text-xs">
                Unregistered node? 
                <a class="text-primary font-bold hover:text-white transition-colors ml-1 uppercase tracking-widest border-b border-primary/30" href="#">Establish Link</a>
</p>
</div>
<!-- Trust Indicator -->
<div class="mt-10 flex items-center justify-center gap-8 opacity-30 grayscale hover:grayscale-0 hover:opacity-100 transition-all duration-500">
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-primary text-sm">enhanced_encryption</span>
<span class="text-[9px] uppercase font-bold tracking-[0.2em] text-white">QUANTUM-SAFE</span>
</div>
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-primary text-sm">hub</span>
<span class="text-[9px] uppercase font-bold tracking-[0.2em] text-white">DECENTRALIZED</span>
</div>
<div class="flex items-center gap-2">
<span class="material-symbols-outlined text-primary text-sm">security</span>
<span class="text-[9px] uppercase font-bold tracking-[0.2em] text-white">SIPC PROTECTED</span>
</div>
