<!DOCTYPE html>

<html class="dark" lang="en"><head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0" name="viewport"/>
<title>Sign In | CashFly</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet"/>
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
<script id="tailwind-config">
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              "primary": "#00F0FF", // Neon Cyan from Design System
              "deep-space": "#050B18",
              "surface-glass": "rgba(255, 255, 255, 0.03)",
              "border-glass": "rgba(255, 255, 255, 0.1)",
              "glow-cyan": "rgba(0, 240, 255, 0.3)"
            },
            fontFamily: {
              "headline": ["Space Grotesk", "sans-serif"],
              "body": ["Space Grotesk", "sans-serif"],
              "label": ["Space Grotesk", "sans-serif"]
            },
            borderRadius: {
              "DEFAULT": "0.5rem",
              "lg": "1rem",
              "xl": "1.5rem",
              "full": "9999px"
            },
            animation: {
              'pulse-slow': 'pulse 4s cubic-bezier(0.4, 0, 0.6, 1) infinite',
            }
          },
        },
      }
    </script>
<style>
      .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      }
      .bg-deep-space {
        background-color: #050B18;
        background-image: 
          radial-gradient(at 0% 0%, rgba(0, 240, 255, 0.1) 0px, transparent 50%),
          radial-gradient(at 100% 100%, rgba(0, 240, 255, 0.05) 0px, transparent 50%);
      }
      .glass-panel {
        background: rgba(255, 255, 255, 0.03);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        box-shadow: 0 0 40px rgba(0, 0, 0, 0.4);
      }
      .futuristic-glow {
        box-shadow: 0 0 20px rgba(0, 240, 255, 0.4);
      }
      .text-neon {
        text-shadow: 0 0 10px rgba(0, 240, 255, 0.5);
      }
    </style>
</head>
<body class="font-body bg-deep-space min-h-screen flex flex-col text-slate-200">
<main class="flex-grow flex items-center justify-center px-6 py-12 relative overflow-hidden">
<!-- Futuristic background elements -->
<div class="absolute top-1/4 -left-20 w-[30rem] h-[30rem] bg-primary/20 rounded-full blur-[150px] animate-pulse-slow"></div>
<div class="absolute bottom-1/4 -right-20 w-[40rem] h-[40rem] bg-blue-600/10 rounded-full blur-[180px]"></div>
<div class="w-full max-w-md relative z-10">
