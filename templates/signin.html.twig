<div class="text-center mb-12">
<div class="inline-flex items-center justify-center w-20 h-20 bg-primary/10 rounded-2xl border border-primary/30 futuristic-glow mb-6 transform rotate-3">
<span class="material-symbols-outlined text-primary text-5xl" data-weight="fill">rocket_launch</span>
</div>
<h1 class="text-4xl font-bold tracking-[0.2em] text-white mb-2 font-headline uppercase text-neon">CashFly</h1>
<p class="text-primary/60 text-[10px] font-bold tracking-[0.4em] uppercase">Hyper-Speed Asset Management</p>
</div>
<!-- Login Card -->
<div class="glass-panel p-8 md:p-10 rounded-xl">
<div class="mb-10">
<h2 class="text-2xl font-semibold text-white tracking-tight">Access Terminal</h2>
<p class="text-slate-400 text-sm mt-2">Initialize secure link to your wealth nodes.</p>
