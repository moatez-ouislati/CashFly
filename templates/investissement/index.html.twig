{% extends 'base.html.twig' %}

{% block title %}Investissements | CashFly{% endblock %}

{% block header_title %}Investissements{% endblock %}
{% block header_subtitle %}Suivez vos propositions et investissements actifs.{% endblock %}

{% block body %}
<div class="mb-8 flex flex-col lg:flex-row justify-between items-center gap-6 bg-surface-container-lowest p-6 rounded-3xl shadow-sm border border-outline-variant/10">
    <form method="get" class="flex flex-col md:flex-row items-center gap-4 w-full lg:w-auto flex-grow">
        <div class="relative w-full md:w-80 group">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">search</span>
            <input type="text" name="search" value="{{ search }}" placeholder="Rechercher une entreprise..." class="w-full pl-12 pr-4 py-3 bg-surface-container-low border-none focus:ring-2 focus:ring-primary/20 rounded-2xl text-sm font-medium transition-all">
        </div>
        
        <div class="relative w-full md:w-60 group">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">filter_list</span>
            <select name="statut" onchange="this.form.submit()" class="w-full pl-12 pr-4 py-3 bg-surface-container-low border-none focus:ring-2 focus:ring-primary/20 rounded-2xl text-sm font-medium transition-all appearance-none">
                <option value="">Tous les statuts</option>
                <option value="EN_ATTENTE" {% if statut == 'EN_ATTENTE' %}selected{% endif %}>En attente</option>
                <option value="ACTIF" {% if statut == 'ACTIF' %}selected{% endif %}>Actif</option>
                <option value="TERMINE" {% if statut == 'TERMINE' %}selected{% endif %}>Terminé</option>
                <option value="ANNULE" {% if statut == 'ANNULE' %}selected{% endif %}>Annulé</option>
            </select>
        </div>

        {% if search or statut %}
            <a href="{{ path('app_investissement_index') }}" class="text-xs font-bold text-error uppercase tracking-widest hover:underline flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">close</span>
                Effacer
            </a>
        {% endif %}
    </form>

    {% if is_granted('ROLE_INVESTISSEUR') %}
        <a href="{{ path('app_investissement_new') }}" class="flex items-center gap-2 px-6 py-4 bg-primary text-white font-black rounded-xl shadow-xl shadow-primary/20 hover:bg-primary-container transition-all active:scale-95 whitespace-nowrap">
            <span class="material-symbols-outlined">add_card</span>
            Nouvel Investissement
        </a>
    {% endif %}
</div>

<div class="grid grid-cols-1 gap-6">
    {% for inv in investissements %}
        <div class="bg-surface-container-lowest rounded-3xl p-6 shadow-sm border border-outline-variant/10 hover:shadow-md transition-all flex flex-col md:flex-row justify-between items-center gap-6">
            <div class="flex items-center gap-6 w-full md:w-auto">
                <div class="w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center text-primary shrink-0">
                    <span class="material-symbols-outlined text-3xl">business</span>
                </div>
                <div>
                    <h3 class="text-xl font-black text-on-surface">{{ inv.entreprise.nom }}</h3>
                    <p class="text-xs font-bold text-outline uppercase tracking-widest">
                        {% if is_granted('ROLE_INVESTISSEUR') %}
                            PME Cible
                        {% else %}
                            Investisseur: {{ inv.investisseur.prenom }} {{ inv.investisseur.nom }}
                        {% endif %}
                    </p>
                </div>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-3 gap-8 w-full md:w-auto text-center md:text-left">
                <div>
                    <p class="text-[10px] font-bold text-outline uppercase tracking-widest mb-1">Montant</p>
                    <p class="text-lg font-black text-on-surface">{{ inv.montant|number_format(2, ',', ' ') }} TND</p>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-outline uppercase tracking-widest mb-1">Rendement</p>
                    <p class="text-lg font-black text-tertiary">{{ inv.tauxRendementPrevu|default('0') }}%</p>
                </div>
                <div class="hidden md:block">
                    <p class="text-[10px] font-bold text-outline uppercase tracking-widest mb-1">Date</p>
                    <p class="text-sm font-bold text-secondary">{{ inv.dateInvestissement|date('d M Y') }}</p>
                </div>
            </div>

            <div class="flex items-center gap-4 w-full md:w-auto justify-between md:justify-end">
                <span class="px-4 py-2 rounded-full text-[10px] font-black uppercase tracking-widest
                    {% if inv.statut == 'ACTIF' %}bg-green-100 text-green-700
                    {% elseif inv.statut == 'EN_ATTENTE' %}bg-amber-100 text-amber-700
                    {% elseif inv.statut == 'ANNULE' %}bg-red-100 text-red-700
                    {% else %}bg-slate-100 text-slate-700{% endif %}">
                    {{ inv.statut }}
                </span>
                <a href="{{ path('app_investissement_show', {'id': inv.id}) }}" class="p-4 bg-surface-container-high text-on-surface rounded-2xl hover:bg-slate-200 transition-all">
                    <span class="material-symbols-outlined">chevron_right</span>
                </a>
            </div>
        </div>
    {% else %}
        <div class="text-center py-20 bg-surface-container-lowest rounded-3xl border-2 border-dashed border-outline-variant/30">
            <span class="material-symbols-outlined text-6xl text-outline mb-4">account_balance_wallet</span>
            <p class="text-secondary font-medium">Aucun investissement trouvé.</p>
        </div>
    {% endfor %}
</div>
{% endblock %}
