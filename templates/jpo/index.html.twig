{% extends 'base.html.twig' %}

{% block title %}Portes Ouvertes | CashFly{% endblock %}

{% block header_title %}Journées Portes Ouvertes{% endblock %}
{% block header_subtitle %}Découvrez les événements à venir et inscrivez-vous.{% endblock %}

{% block body %}
<div class="mb-12 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
    <form method="get" class="flex flex-wrap gap-4 w-full lg:w-auto">
        <input type="text" name="search" value="{{ search }}" placeholder="Rechercher un événement..." class="px-6 py-4 bg-surface-container-lowest border border-outline-variant/20 rounded-xl text-sm focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all min-w-[300px]">
        
        <input type="date" name="date" value="{{ date }}" class="px-6 py-4 bg-surface-container-lowest border border-outline-variant/20 rounded-xl text-sm focus:ring-2 focus:ring-primary/40 transition-all">

        <button type="submit" class="p-4 bg-primary text-white rounded-xl hover:bg-primary-container transition-all">
            <span class="material-symbols-outlined">search</span>
        </button>
    </form>

    {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_PROPRIETAIRE') %}
        <a href="{{ path('app_jpo_new') }}" class="flex items-center gap-2 px-8 py-4 bg-primary text-white font-black rounded-xl shadow-xl shadow-primary/20 hover:bg-primary-container transition-all active:scale-95 whitespace-nowrap">
            <span class="material-symbols-outlined">event_available</span>
            Créer un événement
        </a>
    {% endif %}
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
    {% for event in events %}
        <div class="bg-surface-container-lowest rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all border border-outline-variant/10 group">
            <div class="relative h-48 bg-slate-100 flex items-center justify-center">
                {% if event.imagePath %}
                    <img src="{{ asset('uploads/jpo/' ~ event.imagePath) }}" class="w-full h-full object-cover" alt="{{ event.titre }}">
                {% else %}
                    <span class="material-symbols-outlined text-6xl text-outline/30">event</span>
                {% endif %}
                <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm p-3 rounded-2xl shadow-lg text-center min-w-[60px]">
                    <p class="text-[10px] font-black uppercase text-primary leading-tight">{{ event.dateEvenement|date('M') }}</p>
                    <p class="text-xl font-black text-on-surface">{{ event.dateEvenement|date('d') }}</p>
                </div>
            </div>

            <div class="p-8">
                <div class="flex items-center gap-2 text-[10px] font-black text-primary uppercase tracking-widest mb-3">
                    <span class="material-symbols-outlined text-sm">location_on</span>
                    {{ event.lieu }}
                </div>
                
                <h3 class="text-xl font-black text-on-surface mb-3 line-clamp-1">{{ event.titre }}</h3>
                <p class="text-secondary text-sm line-clamp-2 mb-6 h-10">{{ event.description|default('Aucune description disponible.') }}</p>
                
                <div class="flex items-center justify-between mb-8">
                    <div class="flex items-center gap-2 text-outline">
                        <span class="material-symbols-outlined text-lg">group</span>
                        <span class="text-xs font-bold">{{ event.currentParticipants }}/{{ event.maxParticipants }} participants</span>
                    </div>
                    <div class="w-24 h-1.5 bg-slate-100 rounded-full overflow-hidden">
                        <div class="h-full bg-primary transition-all duration-500" style="width: {{ (event.currentParticipants / event.maxParticipants * 100)|round }}%"></div>
                    </div>
                </div>

                <a href="{{ path('app_jpo_show', {'id': event.id}) }}" class="w-full py-4 text-center block bg-surface-container-high text-on-surface text-xs font-black uppercase tracking-widest rounded-xl hover:bg-primary hover:text-white transition-all">
                    Voir les détails
                </a>
            </div>
        </div>
    {% else %}
        <div class="col-span-full text-center py-20 bg-surface-container-lowest rounded-3xl border-2 border-dashed border-outline-variant/30">
            <span class="material-symbols-outlined text-6xl text-outline mb-4">event_busy</span>
            <p class="text-secondary font-medium">Aucun événement trouvé.</p>
        </div>
    {% endfor %}
</div>
{% endblock %}
