{% extends 'base.html.twig' %}

{% block title %}Participants - {{ event.titre }} — CashFly{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/jpo.css') }}">
<style>
    .admin-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        background: var(--bg-card);
        border-radius: 12px;
        overflow: hidden;
    }

    .admin-table th,
    .admin-table td {
        padding: 15px;
        text-align: left;
        border-bottom: 1px solid var(--border);
    }

    .admin-table th {
        background: rgba(0, 229, 255, 0.05);
        color: var(--cyan);
        font-weight: 700;
        font-size: 12px;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .admin-table tr:hover {
        background: rgba(255, 255, 255, 0.02);
    }

    .btn-small {
        padding: 6px 12px;
        font-size: 11px;
    }

    .status-select {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--border);
        color: var(--text);
        padding: 5px;
        border-radius: 6px;
        font-size: 12px;
        outline: none;
    }

    .status-select option {
        background: #0b1827;
    }
</style>
{% endblock %}

{% block body %}
<div class="page">
    <header class="header header--transparent">
        <div class="logo">
            <img src="{{ path('cashfly_logo') }}" alt="CashFly Logo"
                style="height: 48px; width: auto; margin-right: 12px;">
            <div>
                <div class="logo-text">CASHFLY</div>
                <div class="logo-sub">ADMIN JPO</div>
            </div>
        </div>
        <div class="header-actions">
            <a href="{{ path('jpo_admin_events_list') }}" class="back-link"><i class="ph ph-arrow-left"></i> RETOUR</a>
            <a href="{{ path('app_logout') }}" class="logout-btn" title="Déconnexion">
                <i class="ph ph-sign-out"></i>
            </a>
        </div>
    </header>

    <div class="section-title">Participants: <span>{{ event.titre }}</span></div>
    <div class="section-sub">{{ participants|length }} participants inscrits sur {{ event.maxParticipants }} places.
    </div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>Utilisateur</th>
                <th>Entreprise</th>
                <th>Statut</th>
                <th>Badge</th>
                <th>Inscription</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for p in participants %}
            <tr>
                <td>
                    <div style="font-weight: 600;">{{ p.user.nom ~ ' ' ~ p.user.prenom }}</div>
                    <div style="font-size: 11px; color: var(--text-dim);">{{ p.user.email }}</div>
                </td>
                <td>{{ p.entreprise ? p.entreprise.nom : '—' }}</td>
                <td>
                    <form method="POST" style="margin: 0;">
                        <input type="hidden" name="participation_id" value="{{ p.entity.idParticipation }}">
                        <input type="hidden" name="action" value="update_status">
                        <select name="statut" class="status-select" onchange="this.form.submit()">
                            <option value="confirmé" {{ p.entity.statut=='confirmé' ? 'selected' : '' }}>Confirmé
                            </option>
                            <option value="en_attente" {{ p.entity.statut=='en_attente' ? 'selected' : '' }}>En attente
                            </option>
                            <option value="annulé" {{ p.entity.statut=='annulé' ? 'selected' : '' }}>Annulé</option>
                            <option value="présent" {{ p.entity.statut=='présent' ? 'selected' : '' }}>Présent</option>
                        </select>
                    </form>
                </td>
                <td>
                    <form method="POST" style="margin: 0;">
                        <input type="hidden" name="participation_id" value="{{ p.entity.idParticipation }}">
                        <input type="hidden" name="action" value="toggle_badge">
                        <button type="submit"
                            class="btn {{ p.entity.isBadgeGenere ? 'btn-primary' : 'btn-secondary' }} btn-small"
                            style="padding: 4px 8px;">
                            <i class="ph {{ p.entity.isBadgeGenere ? 'ph-check-square' : 'ph-square' }}"></i>
                            {{ p.entity.isBadgeGenere ? 'Généré' : 'Non généré' }}
                        </button>
                    </form>
                </td>
                <td style="font-size: 12px;">{{ p.entity.dateInscription|date('d/m/Y H:i') }}</td>
                <td>
                    <form method="POST" style="margin: 0;"
                        onsubmit="event.preventDefault(); window.uiConfirm('Supprimer ce participant ?', () => this.submit(), 'SUPPRIMER', 'ANNULER', 'Confirmation', true)">
                        <input type="hidden" name="participation_id" value="{{ p.entity.idParticipation }}">
                        <input type="hidden" name="action" value="delete">
                        <button type="submit" class="btn btn-secondary btn-small" style="color: #ef4444;"><i
                                class="ph ph-trash"></i> Retirer</button>
                    </form>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="6" style="text-align: center; color: var(--text-dim);">Aucun participant.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
