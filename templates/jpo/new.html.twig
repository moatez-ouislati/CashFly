{% extends 'base.html.twig' %}

{% block title %}Nouvelle JPO | CashFly{% endblock %}

{% block header_title %}Créer un Événement JPO{% endblock %}
{% block header_subtitle %}Organisez une journée portes ouvertes pour votre entreprise.{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto bg-surface-container-lowest p-10 rounded-3xl shadow-sm border border-outline-variant/10">
    <div class="flex justify-between items-center mb-8">
        <h3 class="text-xs font-black uppercase tracking-widest text-on-surface">Détails de l'événement</h3>
        <a href="{{ path('app_jpo_index') }}" class="flex items-center gap-2 text-secondary px-4 py-2 rounded-lg font-bold text-sm hover:text-primary transition-all">
            <span class="material-symbols-outlined text-lg">arrow_back</span>
            Retour à la liste
        </a>
    </div>

    {{ form_start(form) }}
        <div class="text-error text-sm mb-6">
            {{ form_errors(form) }}
        </div>

        <div class="space-y-8">
            <div class="space-y-1.5">
                {{ form_label(form.titre) }}
                {{ form_widget(form.titre, {'attr': {'class': 'w-full bg-surface-container-low border-none focus:ring-2 focus:ring-primary/40 rounded-xl py-4 px-6 text-on-surface transition-all'}}) }}
                {{ form_errors(form.titre, {'attr': {'class': 'text-error text-[10px] font-bold uppercase tracking-widest ml-1 mt-1'}}) }}
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <div class="space-y-1.5">
                    {{ form_label(form.dateEvenement) }}
                    {{ form_widget(form.dateEvenement, {'attr': {'class': 'w-full bg-surface-container-low border-none focus:ring-2 focus:ring-primary/40 rounded-xl py-4 px-6 text-on-surface transition-all'}}) }}
                    {{ form_errors(form.dateEvenement, {'attr': {'class': 'text-error text-[10px] font-bold uppercase tracking-widest ml-1 mt-1'}}) }}
                </div>
                <div class="space-y-1.5">
                    {{ form_label(form.lieu) }}
                    {{ form_widget(form.lieu, {'attr': {'class': 'w-full bg-surface-container-low border-none focus:ring-2 focus:ring-primary/40 rounded-xl py-4 px-6 text-on-surface transition-all'}}) }}
                    {{ form_errors(form.lieu, {'attr': {'class': 'text-error text-[10px] font-bold uppercase tracking-widest ml-1 mt-1'}}) }}
                </div>
            </div>

            <div class="space-y-1.5">
                {{ form_label(form.maxParticipants) }}
                {{ form_widget(form.maxParticipants, {'attr': {'class': 'w-full bg-surface-container-low border-none focus:ring-2 focus:ring-primary/40 rounded-xl py-4 px-6 text-on-surface transition-all'}}) }}
                {{ form_errors(form.maxParticipants, {'attr': {'class': 'text-error text-[10px] font-bold uppercase tracking-widest ml-1 mt-1'}}) }}
            </div>

            <div class="space-y-1.5">
                {{ form_label(form.description) }}
                {{ form_widget(form.description, {'attr': {'class': 'w-full bg-surface-container-low border-none focus:ring-2 focus:ring-primary/40 rounded-xl py-4 px-6 text-on-surface transition-all', 'rows': 5}}) }}
                {{ form_errors(form.description, {'attr': {'class': 'text-error text-[10px] font-bold uppercase tracking-widest ml-1 mt-1'}}) }}
            </div>
        </div>

        <div class="mt-12 flex justify-end">
            <button class="bg-primary text-white px-10 py-5 rounded-xl font-black text-sm hover:bg-primary-container transition-all flex items-center gap-3 group shadow-xl shadow-primary/20 active:scale-95">
                Publier l'événement
                <span class="material-symbols-outlined text-lg group-hover:rotate-12 transition-transform">event_available</span>
            </button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
