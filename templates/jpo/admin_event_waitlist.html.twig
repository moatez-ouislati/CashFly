{% extends 'base.html.twig' %}

{% block title %}Liste d'attente - {{ event.titre }} — CashFly{% endblock %}

{% block stylesheets %}
<link rel="stylesheet" href="{{ asset('styles/jpo.css') }}">
<style>
    .admin-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        background: var(--bg-card);
        border-radius: 12px;
        overflow: hidden;
    }

    .admin-table th,
    .admin-table td {
        padding: 15px;
        text-align: left;
        border-bottom: 1px solid var(--border);
    }

    .admin-table th {
        background: rgba(0, 229, 255, 0.05);
        color: var(--cyan);
        font-weight: 700;
        font-size: 12px;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .admin-table tr:hover {
        background: rgba(255, 255, 255, 0.02);
    }

    .btn-small {
        padding: 6px 12px;
        font-size: 11px;
    }

    .badge-status {
        padding: 4px 8px;
        border-radius: 4px;
        font-size: 10px;
        font-weight: 700;
        display: inline-block;
    }

    .badge-en_attente {
        background: rgba(234, 179, 8, 0.2);
        color: #facc15;
    }

    .position-badge {
        background: var(--cyan);
        color: #060e1a;
        padding: 2px 8px;
        border-radius: 10px;
        font-weight: 800;
        font-size: 12px;
    }
</style>
{% endblock %}

{% block body %}
<div class="page">
    <header class="header header--transparent">
        <div class="logo">
            <img src="{{ path('cashfly_logo') }}" alt="CashFly Logo"
                style="height: 48px; width: auto; margin-right: 12px;">
            <div>
                <div class="logo-text">CASHFLY</div>
                <div class="logo-sub">ADMIN JPO</div>
            </div>
        </div>
        <div class="header-actions">
            <a href="{{ path('jpo_admin_events_list') }}" class="back-link"><i class="ph ph-arrow-left"></i> RETOUR</a>
            <a href="{{ path('app_logout') }}" class="logout-btn" title="Déconnexion">
                <i class="ph ph-sign-out"></i>
            </a>
        </div>
    </header>

    <div class="section-title">Liste d'attente: <span>{{ event.titre }}</span></div>
    <div class="section-sub">Places disponibles: {{ event.maxParticipants - event.currentParticipants }}</div>

    <table class="admin-table">
        <thead>
            <tr>
                <th>Type / Position</th>
                <th>Utilisateur</th>
                <th>Date demande</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for w in waitlist %}
            <tr>
                <td>
                    {% if w.type == 'pending' %}
                    <span class="badge-status badge-en_attente">EN ATTENTE</span>
                    {% else %}
                    <span class="position-badge">#{{ w.entity.position }}</span>
                    <span style="font-size: 10px; color: var(--text-dim); margin-left: 4px;">LISTE D'ATTENTE</span>
                    {% endif %}
                </td>
                <td>
                    <div style="font-weight: 600;">{{ w.user.nom ~ ' ' ~ w.user.prenom }}</div>
                    <div style="font-size: 11px; color: var(--text-dim);">{{ w.user.email }}</div>
                </td>
                <td style="font-size: 12px;">{{ w.date|date('d/m/Y H:i') }}</td>
                <td>
                    <div style="display: flex; gap: 8px;">
                        {% if w.type == 'pending' %}
                        <form method="POST" action="{{ path('jpo_admin_event_participants', {id: event.idEvenement}) }}"
                            style="margin: 0;">
                            <input type="hidden" name="participation_id" value="{{ w.entity.idParticipation }}">
                            <input type="hidden" name="action" value="update_status">
                            <input type="hidden" name="statut" value="confirmé">
                            <button type="submit" class="btn btn-primary btn-small">
                                <i class="ph ph-check-circle"></i> Confirmer
                            </button>
                        </form>
                        <form method="POST" action="{{ path('jpo_admin_event_participants', {id: event.idEvenement}) }}"
                            style="margin: 0;"
                            onsubmit="event.preventDefault(); window.uiConfirm('Annuler cette inscription ?', () => this.submit(), 'ANNULER', 'RETOUR', 'Confirmation', true)">
                            <input type="hidden" name="participation_id" value="{{ w.entity.idParticipation }}">
                            <input type="hidden" name="action" value="update_status">
                            <input type="hidden" name="statut" value="annulé">
                            <button type="submit" class="btn btn-secondary btn-small" style="color: #ef4444;">
                                <i class="ph ph-x-circle"></i> Annuler
                            </button>
                        </form>
                        {% else %}
                        <form method="POST" style="margin: 0;">
                            <input type="hidden" name="waitlist_id" value="{{ w.entity.idAttente }}">
                            <input type="hidden" name="action" value="promote">
                            <button type="submit" class="btn btn-primary btn-small" {{ event.currentParticipants>=
                                event.maxParticipants ? 'disabled' : '' }}>
                                <i class="ph ph-user-plus"></i> Promouvoir
                            </button>
                        </form>
                        <form method="POST" style="margin: 0;"
                            onsubmit="event.preventDefault(); window.uiConfirm('Retirer cet utilisateur de la liste d\'attente ?', () => this.submit(), 'RETIRER', 'ANNULER', 'Confirmation', true)">
                            <input type="hidden" name="waitlist_id" value="{{ w.entity.idAttente }}">
                            <input type="hidden" name="action" value="remove">
                            <button type="submit" class="btn btn-secondary btn-small" style="color: #ef4444;"><i
                                    class="ph ph-x-circle"></i> Retirer</button>
                        </form>
                        {% endif %}
                    </div>
                </td>
            </tr>
            {% else %}
            <tr>
                <td colspan="4" style="text-align: center; color: var(--text-dim);">Personne ne patiente pour cet
                    événement.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
