{% extends 'base.html.twig' %}

{% block title %}Trésorerie | CashFly{% endblock %}

{% block stylesheets %}
{{ parent() }}
<script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
{% endblock %}

{% block header_title %}Gestion de la Trésorerie{% endblock %}
{% block header_subtitle %}Gérez vos comptes bancaires et vos soldes d'entreprise.{% endblock %}

{% block body %}
<div class="mb-8 flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6">
    <form id="filter-form" class="flex flex-wrap items-end gap-4 bg-surface-container-lowest p-6 rounded-2xl shadow-sm border border-outline-variant/10 w-full lg:w-auto">
        <div class="flex flex-col gap-1.5 min-w-[200px]">
            <label class="text-[10px] font-black uppercase tracking-widest text-outline ml-1">Recherche</label>
            <div class="relative">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-lg">search</span>
                <input type="text" name="search" value="{{ search }}" placeholder="Nom, numéro de compte..." class="w-full bg-surface-container-low border-none rounded-xl text-xs font-bold py-2.5 pl-10 pr-4 focus:ring-2 focus:ring-primary/40 text-on-surface placeholder-outline/50">
            </div>
        </div>
        <div class="flex flex-col gap-1.5">
            <label class="text-[10px] font-black uppercase tracking-widest text-outline ml-1">PME</label>
            <select name="entreprise" onchange="this.form.submit()" class="bg-surface-container-low border-none rounded-xl text-xs font-bold py-2.5 px-4 focus:ring-2 focus:ring-primary/40 min-w-[150px] {{ entrepriseId ? 'text-primary ring-1 ring-primary/20' : 'text-on-surface' }}">
                <option value="">Toutes les PMEs</option>
                {% for ent in entreprises %}
                    <option value="{{ ent.id }}" {{ entrepriseId == ent.id ? 'selected' : '' }}>{{ ent.nom }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="flex flex-col gap-1.5">
            <label class="text-[10px] font-black uppercase tracking-widest text-outline ml-1">Type Compte</label>
            <select name="type_compte" onchange="this.form.submit()" class="bg-surface-container-low border-none rounded-xl text-xs font-bold py-2.5 px-4 focus:ring-2 focus:ring-primary/40 min-w-[150px] {{ type_compte|default('') ? 'text-primary ring-1 ring-primary/20' : 'text-on-surface' }}">
                <option value="">Tous les types</option>
                <option value="courant" {{ type_compte|default('') == 'courant' ? 'selected' : '' }}>Courant</option>
                <option value="epargne" {{ type_compte|default('') == 'epargne' ? 'selected' : '' }}>Épargne</option>
                <option value="devise" {{ type_compte|default('') == 'devise' ? 'selected' : '' }}>Devise</option>
            </select>
        </div>
        <div class="flex gap-2">
            <button type="submit" class="p-2.5 bg-primary text-white rounded-xl hover:bg-primary-container transition-all shadow-md shadow-primary/10">
                <span class="material-symbols-outlined text-lg">filter_alt</span>
            </button>
            <a href="{{ path('app_tresorerie_index') }}" class="p-2.5 bg-surface-container-high text-on-surface rounded-xl hover:bg-slate-200 transition-all border border-outline-variant/10">
                <span class="material-symbols-outlined text-lg">restart_alt</span>
            </a>
        </div>
    </form>
    <div class="flex flex-wrap gap-4">
        <a href="{{ path('app_tresorerie_export', app.request.query.all) }}" class="flex items-center gap-2 px-6 py-4 bg-tertiary text-white font-black rounded-xl border border-outline-variant/10 shadow-xl shadow-tertiary/20 hover:bg-tertiary/90 transition-all active:scale-95 whitespace-nowrap">
            <span class="material-symbols-outlined">download</span>
            Exporter Excel
        </a>
        <a href="{{ path('app_tresorerie_virement') }}" class="flex items-center gap-2 px-6 py-4 bg-surface-container-high text-on-surface font-black rounded-xl border border-outline-variant/10 hover:bg-slate-200 transition-all active:scale-95 whitespace-nowrap">
            <span class="material-symbols-outlined">swap_horiz</span>
            Virement Interne
        </a>
        <a href="{{ path('app_tresorerie_new', {'entreprise': selected_entreprise.id|default('')}) }}" class="flex items-center gap-2 px-6 py-4 bg-primary text-white font-black rounded-xl shadow-xl shadow-primary/20 hover:bg-primary-container transition-all active:scale-95 whitespace-nowrap">
            <span class="material-symbols-outlined">add</span>
            Nouveau Compte
        </a>
    </div>
</div>

{% if selected_entreprise %}
    <div class="mb-6 flex items-center gap-3 px-6 py-3 bg-primary/5 border border-primary/10 rounded-2xl">
        <span class="material-symbols-outlined text-primary">business</span>
        <span class="text-sm font-bold text-on-surface">Affichage des comptes pour <span class="text-primary">{{ selected_entreprise.nom }}</span></span>
    </div>
{% endif %}

{# Alertes de trésorerie #}
{% if tresorerieForecast.alerts|length > 0 %}
    <div class="mb-8 space-y-3">
        {% for alert in tresorerieForecast.alerts %}
            <div class="flex items-center gap-4 px-6 py-4 rounded-2xl border {% if alert.type == 'critical' %}bg-red-50 border-red-200 text-red-800{% else %}bg-yellow-50 border-yellow-200 text-yellow-800{% endif %}">
                <span class="material-symbols-outlined text-2xl">{% if alert.type == 'critical' %}warning{% else %}info{% endif %}</span>
                <div class="flex-1">
                    <p class="font-bold text-sm">{{ alert.message|raw }}</p>
                </div>
                <a href="{{ path('app_tresorerie_show', {'id': alert.tresorerie.id}) }}" class="px-4 py-2 bg-white rounded-xl text-xs font-bold border hover:bg-gray-50 transition-all">
                    Voir détails
                </a>
            </div>
        {% endfor %}
    </div>
{% endif %}

{# Prévision de trésorerie #}
{% if tresorerieForecast.total_balance > 0 %}
    <div class="mb-8 bg-gradient-to-r from-primary/5 to-tertiary/5 border border-outline-variant/20 rounded-3xl p-8">
        <div class="flex items-center gap-3 mb-6">
            <span class="material-symbols-outlined text-2xl text-primary">trending_up</span>
            <h3 class="text-lg font-black text-on-surface">Prévision de Trésorerie (30 jours)</h3>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
            <div class="bg-white/60 rounded-2xl p-4 text-center">
                <p class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant mb-2">Solde Total</p>
                <p class="text-2xl font-black text-primary">{{ tresorerieForecast.total_balance|number_format(2, ',', ' ') }} TND</p>
            </div>
            <div class="bg-white/60 rounded-2xl p-4 text-center">
                <p class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant mb-2">Revenus/Jour</p>
                <p class="text-2xl font-black text-tertiary">+{{ tresorerieForecast.average_daily_revenu|number_format(2, ',', ' ') }}</p>
            </div>
            <div class="bg-white/60 rounded-2xl p-4 text-center">
                <p class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant mb-2">Dépenses/Jour</p>
                <p class="text-2xl font-black text-error">-{{ tresorerieForecast.average_daily_depense|number_format(2, ',', ' ') }}</p>
            </div>
            <div class="bg-white/60 rounded-2xl p-4 text-center">
                <p class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant mb-2">Solde Prévu J+30</p>
                {% set projected30 = tresorerieForecast.total_balance + (tresorerieForecast.average_daily_revenu * 30) - (tresorerieForecast.average_daily_depense * 30) %}
                <p class="text-2xl font-black {% if projected30 >= 0 %}text-tertiary{% else %}text-error{% endif %}">
                    {{ projected30|number_format(2, ',', ' ') }}
                </p>
            </div>
        </div>
        
        {# Graphique ApexCharts des projections #}
        <div class="bg-white/40 rounded-2xl p-4">
            <div class="flex items-center justify-between mb-3">
                <p class="text-xs font-bold text-on-surface-variant">Projection quotidienne</p>
                <div class="flex items-center gap-4 text-[10px]">
                    <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-primary/30"></span> Solde</span>
                    <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-tertiary/30"></span> Revenus</span>
                    <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-error/30"></span> Dépenses</span>
                </div>
            </div>
            <div id="cashflow-chart" class="h-64"></div>
        </div>
    </div>

    <script>
    document.addEventListener('DOMContentLoaded', function() {
        {% set categories = [] %}
        {% set balanceData = [] %}
        {% set revenuData = [] %}
        {% set depenseData = [] %}

        {% for proj in tresorerieForecast.global_projections %}
            {% set categories = categories|merge([proj.date]) %}
            {% set balanceData = balanceData|merge([proj.balance]) %}
            {% set revenuData = revenuData|merge([proj.expected_revenu]) %}
            {% set depenseData = depenseData|merge([proj.expected_depense]) %}
        {% endfor %}

        var options = {
            chart: {
                type: 'area',
                height: 256,
                toolbar: { show: false },
                fontFamily: 'Inter, sans-serif',
                foreColor: '#414754'
            },
            colors: ['#2563eb', '#00696a', '#dc2626'],
            fill: {
                type: 'gradient',
                gradient: {
                    shadeIntensity: 1,
                    opacityFrom: 0.4,
                    opacityTo: 0.1,
                    stops: [0, 90, 100]
                }
            },
            stroke: { curve: 'smooth', width: 2 },
            series: [
                { name: 'Solde', data: {{ balanceData|json_encode|raw }} },
                { name: 'Revenus/Jour', data: {{ revenuData|json_encode|raw }} },
                { name: 'Dépenses/Jour', data: {{ depenseData|json_encode|raw }} }
            ],
            xaxis: {
                categories: {{ categories|json_encode|raw }},
                labels: { style: { fontSize: '10px' } },
                axisBorder: { show: false },
                axisTicks: { show: false }
            },
            yaxis: {
                labels: {
                    formatter: function(val) { return val.toLocaleString('fr-FR') + ' TND'; },
                    style: { fontSize: '10px' }
                }
            },
            grid: {
                borderColor: '#e8eeff',
                strokeDashArray: 4
            },
            tooltip: {
                theme: 'light',
                y: { formatter: function(val) { return val.toLocaleString('fr-FR') + ' TND'; } }
            },
            legend: { show: false },
            dataLabels: { enabled: false }
        };

        var chart = new ApexCharts(document.querySelector("#cashflow-chart"), options);
        chart.render();
    });
    </script>
{% endif %}

{# Métier Avancé: Ratio de Liquidité #}
{% if liquiditeRatio %}
    <div class="mb-8 bg-gradient-to-r from-{{ liquiditeRatio.color }}-50 to-surface-container-low rounded-3xl p-8 border border-{{ liquiditeRatio.color }}-200">
        <div class="flex items-center gap-3 mb-6">
            <span class="material-symbols-outlined text-2xl text-{{ liquiditeRatio.color }}-600">water_drop</span>
            <div>
                <h3 class="text-lg font-black text-on-surface">Métier Avancé: Ratio de Liquidité</h3>
                <p class="text-xs text-secondary">Ratio courant = Actifs / Passifs</p>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
            <div class="bg-white/60 rounded-2xl p-4 text-center">
                <p class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant mb-2">Ratio Global</p>
                <p class="text-3xl font-black text-{{ liquiditeRatio.color }}-600">{{ liquiditeRatio.ratio }}</p>
                <span class="inline-block mt-2 px-3 py-1 bg-{{ liquiditeRatio.color }}-100 text-{{ liquiditeRatio.color }}-700 text-[10px] font-black uppercase rounded-full">
                    {{ liquiditeRatio.status_label }}
                </span>
            </div>
            <div class="bg-white/60 rounded-2xl p-4 text-center">
                <p class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant mb-2">Actifs Courants</p>
                <p class="text-2xl font-black text-green-600">{{ liquiditeRatio.actifs|number_format(2, ',', ' ') }}</p>
                <p class="text-[10px] text-secondary mt-1">TND</p>
            </div>
            <div class="bg-white/60 rounded-2xl p-4 text-center">
                <p class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant mb-2">Passifs Courants</p>
                <p class="text-2xl font-black text-red-600">{{ liquiditeRatio.passifs|number_format(2, ',', ' ') }}</p>
                <p class="text-[10px] text-secondary mt-1">TND</p>
            </div>
            <div class="bg-white/60 rounded-2xl p-4 text-center">
                <p class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant mb-2">Légende</p>
                <div class="space-y-1 text-[10px] text-left mt-2">
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded bg-green-500"></span>
                        <span class="text-on-surface">Excellent (>1.5)</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded bg-amber-500"></span>
                        <span class="text-on-surface">Acceptable (1.0-1.5)</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="w-3 h-3 rounded bg-red-500"></span>
                        <span class="text-on-surface">Critique (<1.0)</span>
                    </div>
                </div>
            </div>
        </div>

        {% if liquiditeRatio.entreprises|length > 1 %}
            <div class="bg-white/40 rounded-2xl p-4">
                <p class="text-xs font-bold text-on-surface-variant mb-3">Ratio par entreprise</p>
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    {% for ent in liquiditeRatio.entreprises %}
                        <div class="text-center p-3 bg-white/50 rounded-xl">
                            <p class="text-[10px] text-secondary mb-1 truncate">{{ ent.nom }}</p>
                            <p class="text-xl font-black text-{{ ent.color }}-600">{{ ent.ratio }}</p>
                            <div class="w-full bg-gray-200 rounded-full h-1.5 mt-2">
                                <div class="bg-{{ ent.color }}-500 h-1.5 rounded-full" style="width: {{ min(ent.ratio * 50, 100) }}%"></div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </div>
{% endif %}

{% for message in app.flashes('success') %}
    <div class="bg-green-100 text-green-700 border border-green-200 p-4 rounded-xl mb-6 text-sm font-bold flex items-center gap-2">
        <span class="material-symbols-outlined">check_circle</span>
        {{ message }}
    </div>
{% endfor %}

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {% for tresorerie in tresoreries %}
        <div class="bg-surface-container-lowest rounded-3xl p-8 shadow-sm group border border-outline-variant/10 hover:border-primary/30 transition-all">
            <div class="flex justify-between items-start mb-6">
                <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined text-2xl">account_balance</span>
                </div>
                <div class="text-right">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-outline">Solde Actuel</p>
                    <p class="text-xl font-black text-on-surface">{{ tresorerie.solde|number_format(2, ',', ' ') }} {{ tresorerie.devise }}</p>
                </div>
            </div>
            
            <h3 class="text-lg font-black text-on-surface mb-1">{{ tresorerie.nomCompte }}</h3>
            <p class="text-[10px] font-bold text-primary uppercase tracking-widest mb-4">{{ tresorerie.typeCompte }}</p>
            
            <div class="space-y-3 mb-8">
                <div class="flex items-center gap-3 text-sm text-secondary">
                    <span class="material-symbols-outlined text-sm">business</span>
                    PME: {{ tresorerie.entreprise.nom }}
                </div>
                <div class="flex items-center gap-3 text-sm text-secondary">
                    <span class="material-symbols-outlined text-sm">history</span>
                    MàJ: {{ tresorerie.derniereMaj ? tresorerie.derniereMaj|date('d M, H:i') : 'Jamais' }}
                </div>
            </div>
            
            <div class="flex flex-wrap gap-2">
                <a href="{{ path('app_operation_index', {'tresorerie': tresorerie.id}) }}" class="flex-1 py-3 text-center bg-primary text-white text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-primary-container transition-all shadow-md shadow-primary/10">
                    Opérations
                </a>
                <button onclick="this.classList.toggle('text-yellow-500'); this.classList.toggle('bg-yellow-50')" class="p-3 bg-surface-container-high text-on-surface rounded-xl hover:bg-slate-200 transition-all" title="Marquer comme Favori">
                    <span class="material-symbols-outlined text-sm">star</span>
                </button>
                <a href="{{ path('app_tresorerie_show', {'id': tresorerie.id}) }}" class="p-3 bg-surface-container-high text-on-surface rounded-xl hover:bg-slate-200 transition-all" title="Détails">
                    <span class="material-symbols-outlined text-sm">info</span>
                </a>
                <a href="{{ path('app_tresorerie_edit', {'id': tresorerie.id}) }}" class="p-3 bg-primary/5 text-primary rounded-xl hover:bg-primary/10 transition-all" title="Modifier">
                    <span class="material-symbols-outlined text-sm">edit</span>
                </a>
                <form method="post" action="{{ path('app_tresorerie_delete', {'id': tresorerie.id}) }}" onsubmit="return confirm('Confirmer la suppression ?');" class="inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ tresorerie.id) }}">
                    <button class="p-3 text-error bg-error/5 rounded-xl hover:bg-error/10 transition-all" title="Supprimer">
                        <span class="material-symbols-outlined text-sm">delete</span>
                    </button>
                </form>
            </div>
        </div>
    {% else %}
        <div class="col-span-full text-center py-20 bg-surface-container-lowest rounded-3xl border-2 border-dashed border-outline-variant/30">
            <span class="material-symbols-outlined text-6xl text-outline mb-4">account_balance</span>
            <p class="text-secondary font-medium">Aucun compte trouvé.</p>
        </div>
    {% endfor %}
</div>
{% endblock %}
