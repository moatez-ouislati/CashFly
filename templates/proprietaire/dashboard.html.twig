{% extends 'userDashboard.html.twig' %}
{% block title %}Dashboard Propriétaire — CashFly{% endblock %}

{% block body %}
<div class="page-header">
    <h1>Bonjour, {{ user.prenom }} 👋</h1>
    <p>Bienvenue sur votre espace propriétaire</p>
</div>
<a href="{{ path('proprietaire_clients') }}" class="btn">
    Voir les investisseurs
</a>

<div class="card">
    <div style="display:flex; align-items:center; gap:1rem; margin-bottom:1.5rem;">
        <div class="avatar avatar-lg">
            {% if user.faceImage %}
                <img src="{{ asset('uploads/faces/' ~ user.faceImage) }}" alt="">
            {% else %}
         {{ user.prenom|slice(0,1)|upper }}{{ user.nom|slice(0,1)|upper }} 
            {% endif %}
        </div>
        <div>
            <h2 style="font-family:'Syne',sans-serif; font-weight:700;">{{ user.fullName }}</h2>
            <span class="role-pill role-prop">Propriétaire</span>
        </div>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:.75rem 2rem;">
        {% set info = [
            ['Email', user.email],
            ['CIN', user.cin],
            ['Téléphone', user.tel],
            ['Statut du compte', user.isActive ? '✅ Actif' : '❌ Inactif'],
        ] %}
        {% for row in info %}
        <div>
            <div style="font-size:.75rem; text-transform:uppercase; letter-spacing:.07em; color:var(--muted); margin-bottom:.2rem;">{{ row[0] }}</div>
            <div style="font-weight:500;">{{ row[1] }}</div>
        </div>
        {% endfor %}
    </div>

    <div style="margin-top:1.5rem;">
        <a href="{{ path('proprietaire_profile') }}" class="btn btn-primary">Modifier mon profil</a>
    </div>

</div>
{% endblock %}
