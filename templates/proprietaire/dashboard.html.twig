{% extends 'base.html.twig' %}

{% block title %}Dashboard Propriétaire — CashFly{% endblock %}

{% block body %}
<div class="p-6 max-w-7xl mx-auto">
    <!-- Header Section -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
        <div>
            <h1 class="text-3xl md:text-4xl font-black tracking-tight text-on-surface mb-2">
                Bonjour, <span class="text-primary">{{ user.prenom }}</span> 👋
            </h1>
            <p class="text-on-surface-variant text-lg">Heureux de vous revoir sur votre tableau de bord.</p>
        </div>
        
        <a href="{{ path('proprietaire_clients') }}" class="inline-flex items-center gap-2 px-6 py-3 bg-white border border-outline-variant/30 text-primary font-bold rounded-2xl shadow-sm hover:shadow-md hover:bg-primary hover:text-white transition-all transform hover:-translate-y-1">
            <span class="material-symbols-outlined">folder_open</span>
            Voir les investisseurs
        </a>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white p-6 rounded-3xl border border-outline-variant/30 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 bg-primary/10 text-primary rounded-2xl flex items-center justify-center">
                <span class="material-symbols-outlined">business</span>
            </div>
            <div>
                <p class="text-2xl font-black text-on-surface">{{ user.getEntreprises()|length }}</p>
                <p class="text-[10px] font-bold text-on-surface-variant uppercase tracking-widest">Entreprises</p>
            </div>
        </div>
        <a href="{{ path('proprietaire_investments') }}" class="bg-white p-6 rounded-3xl border border-outline-variant/30 shadow-sm flex items-center gap-4 hover:shadow-md transition-all">
            <div class="w-12 h-12 bg-green-50 text-green-600 rounded-2xl flex items-center justify-center">
                <span class="material-symbols-outlined">payments</span>
            </div>
            <div>
                <p class="text-2xl font-black text-on-surface">Voir</p>
                <p class="text-[10px] font-bold text-on-surface-variant uppercase tracking-widest">Investissements</p>
            </div>
        </a>
        <div class="bg-white p-6 rounded-3xl border border-outline-variant/30 shadow-sm flex items-center gap-4">
            <div class="w-12 h-12 bg-orange-50 text-orange-600 rounded-2xl flex items-center justify-center">
                <span class="material-symbols-outlined">account_balance</span>
            </div>
            <div>
                {% set totalCap = 0 %}
                {% for ent in user.getEntreprises() %}{% set totalCap = totalCap + ent.capital %}{% endfor %}
                <p class="text-2xl font-black text-on-surface">{{ totalCap|number_format(0, '.', ' ') }} TND</p>
                <p class="text-[10px] font-bold text-on-surface-variant uppercase tracking-widest">Capital Total</p>
            </div>
        </div>
    </div>

    <!-- Main Profile Card -->
    <div class="bg-surface-container-lowest border border-outline-variant/30 rounded-3xl p-6 md:p-10 shadow-sm relative overflow-hidden">
        <!-- Decorative background blur -->
        <div class="absolute -top-24 -right-24 w-64 h-64 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>

        <div class="flex flex-col md:flex-row items-center gap-6 mb-8 relative z-10">
            <!-- Avatar -->
            <div class="relative group">
                <div class="absolute inset-0 bg-primary/20 blur-xl rounded-full group-hover:bg-primary/30 transition-all"></div>
                <div class="w-24 h-24 md:w-32 md:h-32 bg-white rounded-3xl border-4 border-white shadow-lg flex items-center justify-center text-4xl font-black text-primary overflow-hidden relative z-10">
                    {% if user.faceImage %}
                        <img src="{{ asset('uploads/faces/' ~ user.faceImage) }}" alt="Avatar" class="w-full h-full object-cover">
                    {% else %}
                        {{ user.prenom|slice(0,1)|upper }}{{ user.nom|slice(0,1)|upper }}
                    {% endif %}
                </div>
            </div>
            
            <div class="text-center md:text-left">
                <h2 class="text-3xl font-black text-on-surface mb-2">{{ user.fullName }}</h2>
                <span class="inline-block bg-primary/10 text-primary px-4 py-1.5 rounded-xl text-xs font-bold tracking-widest uppercase border border-primary/20 shadow-sm">
                    Propriétaire
                </span>
            </div>
        </div>

        <!-- Info Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 relative z-10 mb-8">
            <!-- Email -->
            <div class="bg-indigo-50/50 border border-indigo-100 p-5 rounded-2xl">
                <div class="flex items-center gap-2 text-indigo-600 mb-2">
                    <span class="material-symbols-outlined text-[18px]">mail</span>
                    <span class="text-xs font-bold uppercase tracking-wider">Email</span>
                </div>
                <p class="font-bold text-on-surface truncate" title="{{ user.email }}">{{ user.email }}</p>
            </div>
            
            <!-- CIN -->
            <div class="bg-emerald-50/50 border border-emerald-100 p-5 rounded-2xl">
                <div class="flex items-center gap-2 text-emerald-600 mb-2">
                    <span class="material-symbols-outlined text-[18px]">badge</span>
                    <span class="text-xs font-bold uppercase tracking-wider">CIN</span>
                </div>
                <p class="font-bold text-on-surface">{{ user.cin }}</p>
            </div>
            
            <!-- Phone -->
            <div class="bg-amber-50/50 border border-amber-100 p-5 rounded-2xl">
                <div class="flex items-center gap-2 text-amber-600 mb-2">
                    <span class="material-symbols-outlined text-[18px]">call</span>
                    <span class="text-xs font-bold uppercase tracking-wider">Téléphone</span>
                </div>
                <p class="font-bold text-on-surface">{{ user.tel }}</p>
            </div>
            
            <!-- Status -->
            <div class="bg-rose-50/50 border border-rose-100 p-5 rounded-2xl">
                <div class="flex items-center gap-2 text-rose-600 mb-2">
                    <span class="material-symbols-outlined text-[18px]">shield</span>
                    <span class="text-xs font-bold uppercase tracking-wider">Statut</span>
                </div>
                <p class="font-bold flex items-center gap-2 {{ user.isActive ? 'text-emerald-600' : 'text-rose-600' }}">
                    {{ user.isActive ? 'Actif' : 'Inactif' }}
                    {% if user.isActive %}<span class="material-symbols-outlined text-[18px]">check_circle</span>{% endif %}
                </p>
            </div>
        </div>

        <!-- Actions -->
        <div class="relative z-10">
            <a href="{{ path('proprietaire_profile') }}" class="inline-flex items-center gap-2 px-6 py-3 bg-primary text-white font-bold rounded-xl shadow-md shadow-primary/30 hover:bg-primary-dark transition-all transform hover:-translate-y-1">
                <span class="material-symbols-outlined">settings</span>
                Modifier mon profil
            </a>
        </div>
    </div>
</div>
{% endblock %}