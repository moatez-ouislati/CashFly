{% extends 'base.html.twig' %}

{% block title %}Investisseurs — CashFly{% endblock %}

{% block stylesheets %}
<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        --bg-body: #f1f5f9;
        --text-main: #0f172a;
    }

    .page-wrapper {
        padding: 2.5rem;
        background-color: var(--bg-body);
        min-height: 100vh;
    }

    .page-header h1 {
        font-family: 'Syne', sans-serif;
        font-weight: 800;
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-size: 2.8rem;
    }

    /* Search Input Enhanced */
    .search-box {
        position: relative;
        margin: 2rem 0;
        max-width: 100%;
    }

    .search-box input {
        width: 100%;
        padding: 1.2rem 1.5rem 1.2rem 3.5rem;
        border-radius: 20px;
        border: 2px solid transparent;
        background: white;
        box-shadow: 0 10px 25px rgba(0,0,0,0.04);
        font-size: 1.1rem;
        transition: all 0.3s ease;
    }

    .search-box input:focus {
        outline: none;
        border-color: #6366f1;
        box-shadow: 0 15px 30px rgba(99, 102, 241, 0.1);
    }

    /* Grid & Cards */
    .invest-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 2rem;
    }

    .invest-card {
        background: white;
        border-radius: 30px;
        padding: 2.2rem;
        box-shadow: 0 15px 35px rgba(0,0,0,0.03);
        transition: all 0.4s ease;
        border: 1px solid rgba(255,255,255,0.8);
    }

    .invest-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 45px rgba(99, 102, 241, 0.08);
    }

    .avatar-circle {
        width: 85px;
        height: 85px;
        border-radius: 25px;
        background: #eef2ff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        font-weight: 800;
        color: #6366f1;
        overflow: hidden;
    }

    .avatar-circle img { width: 100%; height: 100%; object-fit: cover; }

    .role-pill {
        background: #f5f3ff;
        color: #7c3aed;
        padding: 6px 14px;
        border-radius: 12px;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .stats-info {
        background: #f8fafc;
        border-radius: 20px;
        padding: 1.2rem;
        margin: 1.5rem 0;
    }

    .btn-action {
        width: 100%;
        background: var(--primary-gradient);
        color: white !important;
        padding: 1rem;
        border-radius: 18px;
        text-align: center;
        text-decoration: none;
        font-weight: 700;
        display: block;
        transition: 0.3s;
    }

    .btn-action:hover { opacity: 0.9; transform: scale(1.02); }
</style>
{% endblock %}

{% block body %}
<div class="page-wrapper">
    <div class="page-header">
        <h1>Investisseurs</h1>
        <p style="color: #64748b;">Recherche en temps réel parmis nos investisseurs certifiés.</p>
    </div>

    <div class="search-box">
        <span style="position:absolute; left: 1.3rem; top:50%; transform:translateY(-50%); font-size:1.3rem;">🔍</span>
        <input type="text" id="searchInput" placeholder="Rechercher par nom ou budget...">
    </div>

    <div id="results" class="invest-grid">
        {% for user in users %}
            <div class="invest-card">
                <div class="d-flex align-items-center gap-4 mb-4">
                    <div class="avatar-circle">
                        {% if user.faceImage %}
                            <img src="{{ asset('uploads/faces/' ~ user.faceImage) }}">
                        {% else %}
                            {{ user.prenom|slice(0,1)|upper }}{{ user.nom|slice(0,1)|upper }}
                        {% endif %}
                    </div>
                    <div>
                        <h3 class="m-0" style="font-weight: 800;">{{ user.fullName }}</h3>
                        <span class="role-pill">Investisseur</span>
                    </div>
                </div>

                <div class="stats-info">
                    <div class="d-flex justify-content-between mb-2">
                        <span style="opacity:0.7;">Expérience:</span>
                        <span class="fw-bold">{{ user.yearsExperience ?? '—' }} ans</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span style="opacity:0.7;">Budget:</span>
                        <span class="fw-bold" style="color:#6366f1;">{{ user.budget ?? '—' }} TND</span>
                    </div>
                </div>

                <a class="btn-action" target="_blank" href="https://wa.me/216{{ user.tel }}">
                    💬 Contacter
                </a>
            </div>
        {% endfor %}
    </div>
</div>

<script>
// Logic mte3ek mriguel maghir matmessou
const input = document.getElementById('searchInput');
const results = document.getElementById('results');
const initialContent = results.innerHTML;
let timeout = null;
let controller = null;

input.addEventListener('input', () => {
    clearTimeout(timeout);
    timeout = setTimeout(() => {
        if (input.value.trim() === '') {
            results.innerHTML = initialContent;
            return;
        }
        if (controller) controller.abort();
        controller = new AbortController();

        fetch(`/proprietaire/clients?q=${input.value}`, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            signal: controller.signal
        })
        .then(res => res.json())
        .then(data => {
            results.innerHTML = '';
            if (!data.length) {
                results.innerHTML = '<div style="grid-column:1/-1; text-align:center; padding:3rem; opacity:0.6;">Aucun résultat trouvé</div>';
                return;
            }
            data.forEach(user => {
                results.innerHTML += `
                    <div class="invest-card">
                        <div class="d-flex align-items-center gap-4 mb-4">
                            <div class="avatar-circle">
                                ${user.faceImage ? `<img src="/uploads/faces/${user.faceImage}">` : `<span>${user.prenom[0].toUpperCase()}${user.nom[0].toUpperCase()}</span>`}
                            </div>
                            <div><h3 class="m-0">${user.fullName}</h3><span class="role-pill">Investisseur</span></div>
                        </div>
                        <div class="stats-info">
                            <div class="d-flex justify-content-between mb-2"><span>Expérience:</span><span class="fw-bold">${user.yearsExperience ?? '—'} ans</span></div>
                            <div class="d-flex justify-content-between"><span>Budget:</span><span class="fw-bold" style="color:#6366f1;">${user.budget ?? '—'} TND</span></div>
                        </div>
                        <a class="btn-action" target="_blank" href="https://wa.me/216${user.tel}">💬 Contacter</a>
                    </div>`;
            });
        })
        .catch(err => { if (err.name !== 'AbortError') console.error(err); });
    }, 400);
});
</script>
{% endblock %}
