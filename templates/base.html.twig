                    <a href="{{ path('app_api_economic') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route == 'app_api_economic' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">show_chart</span>
                        <span class="text-sm font-medium">Eco. Tunisie</span>
                    </a>

                    <a href="{{ path('app_api_recommendations') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route == 'app_api_recommendations' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">smart_toy</span>
                        <span class="text-sm font-medium">Recommandations IA</span>
                    </a>

                    <a href="{{ path('app_risk_analysis') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route == 'app_risk_analysis' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">shield</span>
                        <span class="text-sm font-medium">Analyse de Risque</span>
                    </a>

                    <a href="{{ path('app_ai_advisor') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route == 'app_ai_advisor' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">forum</span>
                        <span class="text-sm font-medium">AI Advisor</span>
                    </a>

                    <a href="{{ path('investisseur_profile') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route == 'investisseur_profile' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">person</span>
                        <span class="text-sm font-medium">Profil</span>
                    </a>
                {% endif %}
                {% if not isAdmin or (isAdmin and faceVerified) %}
                {% endif %}
            </nav>

            <div class="p-3 border-t border-outline-variant/20">
                <a href="{{ path('app_logout') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl text-error hover:bg-error/10 transition-all duration-300">
                    <span class="material-symbols-outlined">logout</span>
                    <span class="text-sm font-medium">Déconnexion</span>
                </a>
            </div>
        </aside>
        {% endif %}

        <!-- Main Content Area -->
        <main class="{% if not isAdmin or (isAdmin and faceVerified) %}ml-64{% endif %} p-8 min-h-screen">
            {% if not isAdmin or (isAdmin and faceVerified) %}
            <header class="flex justify-between items-center mb-10">
                <div>
                    {% block page_header %}{% endblock %}
                </div>
                <div class="flex items-center gap-4">
                    <div class="text-right">
                        <p class="text-sm font-bold text-on-surface">{{ app.user.fullName }}</p>
                        <p class="text-[10px] text-on-surface-variant uppercase tracking-widest">
                            {% if is_granted('ROLE_ADMIN') %}Administrateur
                            {% elseif is_granted('ROLE_PROPRIETAIRE') %}Propriétaire
                            {% else %}Investisseur{% endif %}
                        </p>
                    </div>
                    <div class="w-12 h-12 rounded-full border-2 border-primary/20 p-0.5">
                        {% if app.user.faceImage %}
                            <img src="{{ asset('uploads/faces/' ~ app.user.faceImage) }}" class="w-full h-full rounded-full object-cover">
                        {% else %}
                            <div class="w-full h-full rounded-full bg-surface-container-high flex items-center justify-center text-primary font-bold">
                                {{ app.user.prenom|slice(0,1)|upper }}{{ app.user.nom|slice(0,1)|upper }}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </header>
            {% endif %}

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 p-4 rounded-xl {% if label == 'success' %}bg-tertiary/10 text-tertiary border border-tertiary/20{% else %}bg-error/10 text-error border border-error/20{% endif %} flex items-center gap-3">
                        <span class="material-symbols-outlined">{% if label == 'success' %}check_circle{% else %}error{% endif %}</span>
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    {% else %}
        {% block public_body %}
            <div class="container mx-auto px-4 py-8">
                {% block content %}{% endblock %}
            </div>
        {% endblock %}
    {% endif %}

    {% block javascripts %}{% endblock %}
    {# --- JPO GLOBAL UI MODALS --- #}
    <div class="popup-overlay modal-overlay--hidden" id="uiGlobalConfirm" style="z-index: 20002;">
        <div class="popup-modal popup-modal--small modal--centered">
            <i class="ph ph-warning-circle modal-icon--large modal-icon--warning" id="uiGlobalConfirmIcon"></i>
            <div class="confirm-title modal-title--bold" id="uiGlobalConfirmTitle">Confirmation</div>
            <p class="confirm-text modal-text--standard" id="uiGlobalConfirmText"></p>
            <div class="confirm-actions modal-actions--centered">
                <button class="btn btn-secondary modal-btn--flex" id="uiGlobalConfirmCancel">ANNULER</button>
                <button class="btn btn-primary modal-btn--flex modal-btn--cyan" id="uiGlobalConfirmOk">OUI</button>
            </div>
        </div>
    </div>

    <div class="popup-overlay modal-overlay--hidden" id="uiGlobalAlert" style="z-index: 20003;">
        <div class="popup-modal popup-modal--small modal--centered">
            <i class="ph ph-info modal-icon--large modal-icon--info" id="uiGlobalAlertIcon"></i>
            <div class="confirm-title modal-title--bold" id="uiGlobalAlertTitle">Information</div>
            <p class="confirm-text modal-text--standard" id="uiGlobalAlertText"></p>
            <div class="confirm-actions modal-actions--centered">
                <button class="btn btn-primary modal-btn--min-120" id="uiGlobalAlertOk">OK</button>
            </div>
        </div>
    </div>

    <script>
        window.uiConfirm = function (message, onConfirm, okText = 'OUI', cancelText = 'ANNULER', title = 'Confirmation', isDanger = false) {
            const overlay = document.getElementById('uiGlobalConfirm');
            if (!overlay) return alert(message) && onConfirm();
            document.getElementById('uiGlobalConfirmText').innerText = message;
            document.getElementById('uiGlobalConfirmTitle').innerText = title;
            const btnOk = document.getElementById('uiGlobalConfirmOk');
            const btnCancel = document.getElementById('uiGlobalConfirmCancel');

            btnOk.innerText = okText;
            btnCancel.innerText = cancelText;

            if (isDanger) {
                btnOk.classList.add('modal-btn--danger');
                btnOk.classList.remove('modal-btn--cyan');
            } else {
                btnOk.classList.remove('modal-btn--danger');
                btnOk.classList.add('modal-btn--cyan');
            }

            overlay.style.display = 'flex';

            const handleClose = (result) => {
                overlay.style.display = 'none';
                btnOk.onclick = null;
                btnCancel.onclick = null;
                if (result && typeof onConfirm === 'function') onConfirm();
            };

            btnOk.onclick = () => handleClose(true);
            btnCancel.onclick = () => handleClose(false);
        };

        window.uiAlert = function (message, title = 'Information', isSuccess = false) {
            const overlay = document.getElementById('uiGlobalAlert');
            if (!overlay) return alert(message);
            document.getElementById('uiGlobalAlertText').innerText = message;
            document.getElementById('uiGlobalAlertTitle').innerText = title;
            const icon = document.getElementById('uiGlobalAlertIcon');

            icon.classList.remove('modal-icon--success', 'modal-icon--error', 'modal-icon--info');

            if (isSuccess) {
                icon.className = 'ph ph-check-circle modal-icon--large modal-icon--success';
            } else if (title.toLowerCase().includes('erreur') || title.toLowerCase().includes('error') || title.toLowerCase().includes('attention')) {
                icon.className = 'ph ph-x-circle modal-icon--large modal-icon--error';
            } else {
                icon.className = 'ph ph-info modal-icon--large modal-icon--info';
            }
            overlay.style.display = 'flex';

            const btnOk = document.getElementById('uiGlobalAlertOk');
            btnOk.onclick = () => overlay.style.display = 'none';
        };
    </script>
</body>
</html>
