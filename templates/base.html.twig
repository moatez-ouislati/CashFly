<!DOCTYPE html>
<html>

<head>
    <meta charset="UTF-8">
    <title>{% block title %}Welcome!{% endblock %}</title>
    <link rel="icon"
        href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
    {% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/jpo.css') }}">
    {% endblock %}

    {% block javascripts %}
    {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}

    {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphpHotReload %}
    <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
    <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
    <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {% endif %}
</head>

<body>
    <script data-turbo-eval="false">
        // Apply theme instantly on first load
        const savedTheme = localStorage.getItem('cashfly_theme') || 'dark';
        if (savedTheme === 'light') {
            document.documentElement.classList.add('light-mode');
        }
    </script>
    {% block body %}{% endblock %}
    <script>
        (function () {
            function toggleTheme() {
                const isLight = document.documentElement.classList.toggle('light-mode');
                localStorage.setItem('cashfly_theme', isLight ? 'light' : 'dark');
                const icons = document.querySelectorAll('.theme-icon');
                icons.forEach(icon => {
                    icon.className = isLight ? 'ph ph-moon theme-icon' : 'ph ph-sun theme-icon';
                });
            }

            function injectThemeToggle() {
                if (document.getElementById('themeToggleBtn')) return;

                const headerActions = document.querySelector('.header-actions');
                const isLight = document.documentElement.classList.contains('light-mode');
                const iconClass = isLight ? 'ph-moon' : 'ph-sun';

                if (headerActions) {
                    const btn = document.createElement('button');
                    btn.id = 'themeToggleBtn';
                    btn.onclick = toggleTheme;
                    btn.title = 'Basculer le thème';
                    btn.style.cssText = 'background: transparent; border: 1px solid var(--border); border-radius: 8px; color: var(--text-dim); width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; margin-left: 10px; order: -1;';

                    btn.innerHTML = `<i class="ph ${iconClass} theme-icon" style="font-size: 20px;"></i>`;

                    btn.onmouseover = () => { btn.style.color = 'var(--cyan)'; btn.style.borderColor = 'var(--cyan)'; };
                    btn.onmouseout = () => { btn.style.color = 'var(--text-dim)'; btn.style.borderColor = 'var(--border)'; };

                    headerActions.insertBefore(btn, headerActions.firstChild);
                } else {
                    const btn = document.createElement('button');
                    btn.id = 'themeToggleBtn';
                    btn.onclick = toggleTheme;
                    btn.style.cssText = 'position: fixed; top: 20px; right: 20px; z-index: 1000; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); border-radius: 50%; color: var(--text-dim); width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; cursor: pointer; backdrop-filter: blur(10px);';
                    btn.innerHTML = `<i class="ph ${iconClass} theme-icon" style="font-size: 24px;"></i>`;
                    document.body.appendChild(btn);
                }
            }

            // Inject immediately since this script runs after body block
            injectThemeToggle();

            // Run on Turbo transitions
            document.addEventListener('turbo:load', injectThemeToggle);
            document.addEventListener('turbo:render', injectThemeToggle);
        })();
    </script>

    {# --- GLOBAL UI MODALS --- #}
    <div class="popup-overlay modal-overlay--hidden" id="uiGlobalConfirm">
        <div class="popup-modal popup-modal--small modal--centered">
            <i class="ph ph-warning-circle modal-icon--large modal-icon--warning" id="uiGlobalConfirmIcon"></i>
            <div class="confirm-title modal-title--bold" id="uiGlobalConfirmTitle">Confirmation</div>
            <p class="confirm-text modal-text--standard" id="uiGlobalConfirmText"></p>
            <div class="confirm-actions modal-actions--centered">
                <button class="btn btn-secondary modal-btn--flex" id="uiGlobalConfirmCancel">ANNULER</button>
                <button class="btn btn-primary modal-btn--flex modal-btn--cyan" id="uiGlobalConfirmOk">OUI</button>
            </div>
        </div>
    </div>

    <div class="popup-overlay modal-overlay--hidden" id="uiGlobalAlert">
        <div class="popup-modal popup-modal--small modal--centered">
            <i class="ph ph-info modal-icon--large modal-icon--info" id="uiGlobalAlertIcon"></i>
            <div class="confirm-title modal-title--bold" id="uiGlobalAlertTitle">Information</div>
            <p class="confirm-text modal-text--standard" id="uiGlobalAlertText"></p>
            <div class="confirm-actions modal-actions--centered">
                <button class="btn btn-primary modal-btn--min-120" id="uiGlobalAlertOk">OK</button>
            </div>
        </div>
    </div>

    {# --- AI SUGGESTION MODAL --- #}
    <div class="popup-overlay modal-overlay--hidden" id="uiGlobalSuggestion" style="z-index: 10001;">
        <div class="popup-modal modal--centered"
            style="max-width: 450px; padding: 0; overflow: hidden; border: 1px solid var(--cyan);">
            <div
                style="background: linear-gradient(135deg, var(--cyan), #00d2ff); padding: 25px; color: #060e1a; text-align: center;">
                <i class="ph ph-sparkle" style="font-size: 32px;"></i>
                <div style="font-weight: 800; font-size: 18px; margin-top: 10px; letter-spacing: 1px;">DÉCOUVERTE
                    INTELLIGENTE</div>
            </div>
            <div style="padding: 25px;">
                <p id="suggestionHook"
                    style="font-style: italic; color: var(--text-dim); font-size: 14px; line-height: 1.5; margin-bottom: 20px; text-align: center; border-left: 3px solid var(--cyan); padding-left: 15px;">
                </p>

                <div
                    style="background: rgba(255,255,255,0.03); border-radius: 12px; padding: 15px; border: 1px solid var(--border); transition: transform 0.2s;">
                    <img id="suggestionImage" src="" alt="Event"
                        style="width: 100%; height: 150px; object-fit: cover; border-radius: 8px; margin-bottom: 15px; display: none;">
                    <div id="suggestionTitle"
                        style="font-weight: 700; font-size: 16px; margin-bottom: 8px; color: var(--cyan);"></div>
                    <div style="display: flex; gap: 15px; font-size: 12px; color: var(--text-dim);">
                        <span><i class="ph ph-calendar"></i> <span id="suggestionDate"></span></span>
                        <span><i class="ph ph-map-pin"></i> <span id="suggestionLocation"></span></span>
                    </div>
                </div>

                <div style="display: flex; gap: 10px; margin-top: 25px;">
                    <button class="btn btn-secondary" id="suggestionSkip" style="flex: 1;">PLUS TARD</button>
                    <button class="btn btn-primary" id="suggestionGo" style="flex: 1.5;">DÉCOUVRIR <i
                            class="ph ph-arrow-right"></i></button>
                </div>
            </div>
        </div>
    </div>

    <script data-turbo-eval="false">
        window.uiConfirm = function (message, onConfirm, okText = 'OUI', cancelText = 'ANNULER', title = 'Confirmation', isDanger = false) {
            const overlay = document.getElementById('uiGlobalConfirm');
            document.getElementById('uiGlobalConfirmText').innerText = message;
            document.getElementById('uiGlobalConfirmTitle').innerText = title;
            const btnOk = document.getElementById('uiGlobalConfirmOk');
            const btnCancel = document.getElementById('uiGlobalConfirmCancel');

            btnOk.innerText = okText;
            btnCancel.innerText = cancelText;

            if (isDanger) {
                btnOk.classList.add('modal-btn--danger');
                btnOk.classList.remove('modal-btn--cyan');
            } else {
                btnOk.classList.remove('modal-btn--danger');
                btnOk.classList.add('modal-btn--cyan');
            }

            overlay.style.display = 'flex';

            const handleClose = (result) => {
                overlay.style.display = 'none';
                btnOk.removeEventListener('click', okHandler);
                btnCancel.removeEventListener('click', cancelHandler);
                if (result && typeof onConfirm === 'function') onConfirm();
            };

            const okHandler = () => handleClose(true);
            const cancelHandler = () => handleClose(false);

            btnOk.addEventListener('click', okHandler);
            btnCancel.addEventListener('click', cancelHandler);
        };

        window.uiAlert = function (message, title = 'Information', isSuccess = false) {
            const overlay = document.getElementById('uiGlobalAlert');
            document.getElementById('uiGlobalAlertText').innerText = message;
            document.getElementById('uiGlobalAlertTitle').innerText = title;
            const icon = document.getElementById('uiGlobalAlertIcon');

            icon.classList.remove('modal-icon--success', 'modal-icon--error', 'modal-icon--info');

            if (isSuccess) {
                icon.className = 'ph ph-check-circle modal-icon--large modal-icon--success';
            } else if (title.toLowerCase().includes('erreur') || title.toLowerCase().includes('error') || title.toLowerCase().includes('attention')) {
                icon.className = 'ph ph-x-circle modal-icon--large modal-icon--error';
            } else {
                icon.className = 'ph ph-info modal-icon--large modal-icon--info';
            }
            overlay.style.display = 'flex';

            const btnOk = document.getElementById('uiGlobalAlertOk');
            const okHandler = () => {
                overlay.style.display = 'none';
                btnOk.removeEventListener('click', okHandler);
            };
            btnOk.addEventListener('click', okHandler);
        };

        window.uiSuggestion = function (suggestion) {
            const overlay = document.getElementById('uiGlobalSuggestion');
            document.getElementById('suggestionTitle').innerText = suggestion.titre;
            document.getElementById('suggestionDate').innerText = suggestion.date;
            document.getElementById('suggestionLocation').innerText = suggestion.lieu;
            document.getElementById('suggestionHook').innerText = suggestion.hook;

            const img = document.getElementById('suggestionImage');
            if (suggestion.image) {
                img.src = suggestion.image;
                img.style.display = 'block';
            } else {
                img.style.display = 'none';
            }

            const btnGo = document.getElementById('suggestionGo');
            const btnSkip = document.getElementById('suggestionSkip');

            overlay.style.display = 'flex';

            const handleClose = () => {
                overlay.style.display = 'none';
                btnGo.onclick = null;
                btnSkip.onclick = null;
            };

            btnGo.onclick = () => {
                handleClose();
                window.location.href = suggestion.details_url || `/event/${suggestion.id}`;
            };
            btnSkip.onclick = () => {
                handleClose();
                window.location.reload();
            };
        };
    </script>
</body>

</html>