{% extends 'index.html.twig' %}

{% block title %}CashFly — Accueil{% endblock %}

{% block body %}

<style>
body {
    margin:0;
    font-family: 'Inter', sans-serif;
    background: linear-gradient(135deg, #0f172a, #1e293b, #111827);
    color:white;
}

/*  soft gradient overlay */
.bg-blur {
    position:absolute;
    width:500px;
    height:500px;
    background: radial-gradient(circle, #6366f155, transparent);
    filter: blur(120px);
    top:10%;
    left:20%;
}

.bg-blur2 {
    right:10%;
    bottom:10%;
    background: radial-gradient(circle, #06b6d455, transparent);
}

/*  hero */
.hero {
    min-height:100vh;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    position:relative;
}

/*  logo */
.logo {
    width:90px;
    margin-bottom:20px;
    opacity:0;
    transform: translateY(20px);
    animation: fadeUp 1s ease forwards;
}

/*  title */
.title {
    font-size:3.5rem;
    font-weight:700;
    background: linear-gradient(90deg, #22d3ee, #a855f7);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom:10px;
    opacity:0;
    animation: fadeUp 1s ease forwards 0.2s;
}

/*  subtitle */
.subtitle {
    opacity:0.7;
    letter-spacing:0.2rem;
    margin-bottom:40px;
    opacity:0;
    animation: fadeUp 1s ease forwards 0.4s;
}

/*  buttons */
.actions {
    display:flex;
    gap:15px;
    opacity:0;
    animation: fadeUp 1s ease forwards 0.6s;
}

.btn {
    padding:12px 28px;
    border-radius:10px;
    text-decoration:none;
    font-weight:500;
    transition:0.3s;
}

/* primary */
.btn-primary {
    background: linear-gradient(90deg, #6366f1, #a855f7);
    box-shadow: 0 10px 30px rgba(168,85,247,0.3);
}

.btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(168,85,247,0.5);
}

/* outline */
.btn-outline {
    border:1px solid #334155;
    color:#cbd5f5;
}

.btn-outline:hover {
    background:#1e293b;
}

/* 🔥 floating cards */
.floating {
    position:absolute;
    padding:12px 18px;
    background: rgba(255,255,255,0.05);
    backdrop-filter: blur(10px);
    border-radius:10px;
    font-size:14px;
    opacity:0.8;
    animation: float 6s ease-in-out infinite;
}

.card1 { top:20%; left:10%; }
.card2 { bottom:20%; right:10%; }

/* animations */
@keyframes float {
    0%,100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
}

@keyframes fadeUp {
    to {
        opacity:1;
        transform: translateY(0);
    }
}
</style>

<!-- BACKGROUND -->
<div class="bg-blur"></div>
<div class="bg-blur bg-blur2"></div>

<div class="hero">

    <!-- LOGO -->
    <img src="{{ asset('uploads/logo.png') }}" class="logo">

    <!-- TITLE -->
    <h1 class="title">CASHFLY</h1>

    <!-- SUBTITLE -->
    <p class="subtitle">VOTRE CROISSANCE, NOTRE MISSION</p>

    <!-- ACTIONS -->
    <div class="actions">
        <a href="{{ path('app_login') }}" class="btn btn-primary">
            Se connecter
        </a>

        <a href="{{ path('app_register') }}" class="btn btn-outline">
            S’inscrire
        </a>
    </div>

</div>

<!-- FLOATING INFO -->
<div class="floating card1">💰 +223k TND profit</div>
<div class="floating card2">📈 +5 ans expérience</div>

{% endblock %}