{% extends 'base.html.twig' %}

{% block title %}Record Transaction | FinArchitect{% endblock %}

{% block header_title %}Record Transaction{% endblock %}
{% block header_subtitle %}Log a new income or expense for your PME.{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto bg-surface-container-lowest rounded-3xl p-10 shadow-sm">
    {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
        <div class="text-error text-sm mb-4">
            {{ form_errors(form) }}
        </div>
        <div class="grid grid-cols-2 gap-6">
            <div class="space-y-1.5">
                {{ form_label(form.type, null, {'label_attr': {'class': 'block text-xs font-bold text-outline uppercase tracking-widest ml-1'}}) }}
                {{ form_widget(form.type, {'attr': {'class': 'w-full bg-surface-container-low border-none focus:ring-2 focus:ring-primary/40 rounded-xl py-4 px-6 text-on-surface placeholder-outline/30 transition-all duration-300'}}) }}
                {{ form_errors(form.type, {'attr': {'class': 'text-error text-xs ml-1 mt-1'}}) }}
            </div>
            <div class="space-y-1.5">
                {{ form_label(form.tresorerie, null, {'label_attr': {'class': 'block text-xs font-bold text-outline uppercase tracking-widest ml-1'}}) }}
                {{ form_widget(form.tresorerie, {'attr': {'class': 'w-full bg-surface-container-low border-none focus:ring-2 focus:ring-primary/40 rounded-xl py-4 px-6 text-on-surface placeholder-outline/30 transition-all duration-300'}}) }}
                {{ form_errors(form.tresorerie, {'attr': {'class': 'text-error text-xs ml-1 mt-1'}}) }}
            </div>
        </div>

        <div class="grid grid-cols-2 gap-6">
            <div class="space-y-1.5">
                {{ form_label(form.montant, null, {'label_attr': {'class': 'block text-xs font-bold text-outline uppercase tracking-widest ml-1'}}) }}
                {{ form_widget(form.montant, {'attr': {'class': 'w-full bg-surface-container-low border-none focus:ring-2 focus:ring-primary/40 rounded-xl py-4 px-6 text-on-surface placeholder-outline/30 transition-all duration-300'}}) }}
                {{ form_errors(form.montant, {'attr': {'class': 'text-error text-xs ml-1 mt-1'}}) }}
            </div>
            <div class="space-y-1.5">
                {{ form_label(form.categorie, null, {'label_attr': {'class': 'block text-xs font-bold text-outline uppercase tracking-widest ml-1'}}) }}
                {{ form_widget(form.categorie, {'attr': {'class': 'w-full bg-surface-container-low border-none focus:ring-2 focus:ring-primary/40 rounded-xl py-4 px-6 text-on-surface placeholder-outline/30 transition-all duration-300'}}) }}
                {{ form_errors(form.categorie, {'attr': {'class': 'text-error text-xs ml-1 mt-1'}}) }}
            </div>
        </div>

        <div class="grid grid-cols-2 gap-6">
            <div class="space-y-1.5">
                {{ form_label(form.reference, null, {'label_attr': {'class': 'block text-xs font-bold text-outline uppercase tracking-widest ml-1'}}) }}
                {{ form_widget(form.reference, {'attr': {'class': 'w-full bg-surface-container-low border-none focus:ring-2 focus:ring-primary/40 rounded-xl py-4 px-6 text-on-surface placeholder-outline/30 transition-all duration-300'}}) }}
                {{ form_errors(form.reference, {'attr': {'class': 'text-error text-xs ml-1 mt-1'}}) }}
            </div>
        </div>

        <div class="space-y-1.5">
            {{ form_label(form.description, null, {'label_attr': {'class': 'block text-xs font-bold text-outline uppercase tracking-widest ml-1'}}) }}
            {{ form_widget(form.description, {'attr': {'class': 'w-full bg-surface-container-low border-none focus:ring-2 focus:ring-primary/40 rounded-xl py-4 px-6 text-on-surface placeholder-outline/30 transition-all duration-300'}}) }}
            {{ form_errors(form.description, {'attr': {'class': 'text-error text-xs ml-1 mt-1'}}) }}
        </div>

        <div class="flex gap-4 pt-6">
            <a href="{{ path('app_operation_index') }}" class="flex-1 py-4 text-center bg-slate-100 text-secondary text-xs font-black uppercase tracking-widest rounded-xl hover:bg-slate-200 transition-all">
                Cancel
            </a>
            <button class="flex-1 py-4 bg-primary text-white text-xs font-black uppercase tracking-widest rounded-xl shadow-lg shadow-primary/20 hover:bg-primary-container transition-all active:scale-95" type="submit">
                Record Transaction
            </button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
