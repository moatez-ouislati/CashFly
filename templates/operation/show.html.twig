{% extends 'base.html.twig' %}

{% block title %}Transaction Detail | FinArchitect{% endblock %}

{% block header_title %}Transaction Detail{% endblock %}
{% block header_subtitle %}{{ operation.reference ?: 'Operation #' ~ operation.id }}{% endblock %}

{% block body %}
<div class="grid grid-cols-12 gap-8">
    <!-- Main Info -->
    <div class="col-span-12 lg:col-span-8 space-y-8">
        <div class="bg-surface-container-lowest rounded-3xl p-10 shadow-sm">
            <div class="flex items-center justify-between mb-8">
                <h3 class="text-sm font-black uppercase tracking-widest text-on-surface">Transaction Overview</h3>
                <div class="px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest {{ operation.type == 'revenu' ? 'bg-tertiary/10 text-tertiary' : 'bg-error/10 text-error' }}">
                    {{ operation.type == 'revenu' ? 'Income' : 'Expense' }}
                </div>
            </div>
            
            <div class="grid grid-cols-2 gap-8">
                <div class="space-y-1">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-outline">Amount</p>
                    <p class="text-3xl font-black {{ operation.type == 'revenu' ? 'text-tertiary' : 'text-error' }}">
                        {{ operation.type == 'revenu' ? '+' : '-' }}{{ operation.montant|number_format(2, '.', ',') }} TND
                    </p>
                </div>
                <div class="space-y-1">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-outline">Date of Operation</p>
                    <p class="text-sm font-bold text-on-surface">{{ operation.dateOperation|date('M d, Y H:i') }}</p>
                </div>
                <div class="space-y-1">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-outline">Category</p>
                    <p class="text-sm font-bold text-on-surface">{{ operation.categorie|default('N/A') }}</p>
                </div>
                <div class="space-y-1">
                    <p class="text-[10px] font-bold uppercase tracking-widest text-outline">Reference</p>
                    <p class="text-sm font-bold text-on-surface">{{ operation.reference|default('N/A') }}</p>
                </div>
            </div>

            <div class="mt-8 pt-8 border-t border-outline-variant/30">
                <p class="text-[10px] font-bold uppercase tracking-widest text-outline mb-2">Description</p>
                <p class="text-sm text-secondary leading-relaxed italic">
                    {{ operation.description ?: 'No description provided for this transaction.' }}
                </p>
            </div>
        </div>
    </div>

    <!-- Sidebar Info -->
    <div class="col-span-12 lg:col-span-4 space-y-8">
        <div class="bg-surface-container-high rounded-3xl p-8 shadow-sm">
            <h3 class="text-sm font-black uppercase tracking-widest text-on-surface mb-6">Linked Account</h3>
            <div class="flex items-center gap-4 mb-8">
                <div class="w-12 h-12 rounded-xl bg-primary/10 flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined">account_balance</span>
                </div>
                <div>
                    <p class="font-bold text-on-surface">{{ operation.tresorerie.nomCompte }}</p>
                    <p class="text-xs text-secondary">{{ operation.tresorerie.typeCompte }} • {{ operation.tresorerie.entreprise.nom }}</p>
                </div>
            </div>
            <a href="{{ path('app_tresorerie_show', {'id': operation.tresorerie.id}) }}" class="block w-full py-3 text-center bg-white text-primary text-xs font-black uppercase tracking-widest rounded-xl hover:bg-slate-100 transition-all border border-outline-variant/30">
                View Account Profile
            </a>
        </div>
        
        <div class="flex flex-col gap-3">
            {% if is_granted('ROLE_PROPRIETAIRE') %}
            <a href="{{ path('app_operation_edit', {'id': operation.id}) }}" class="flex items-center justify-center gap-3 w-full py-4 bg-primary text-white text-xs font-black uppercase tracking-widest rounded-xl shadow-lg shadow-primary/20 hover:bg-primary-container transition-all active:scale-95">
                <span class="material-symbols-outlined text-sm">edit</span>
                Edit Transaction
            </a>
            
            <form method="post" action="{{ path('app_operation_delete', {'id': operation.id}) }}" onsubmit="return confirm('Are you sure you want to delete this transaction? This will also update the account balance.');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ operation.id) }}">
                <button class="flex items-center justify-center gap-3 w-full py-4 bg-error/10 text-error text-xs font-black uppercase tracking-widest rounded-xl hover:bg-error/20 transition-all">
                    <span class="material-symbols-outlined text-sm">delete</span>
                    Delete Transaction
                </button>
            </form>
            {% endif %}

            <a href="{{ is_granted('ROLE_ADMIN') ? path('app_operation_admin_index') : path('app_operation_index') }}" class="flex items-center justify-center gap-3 w-full py-4 bg-white border border-outline-variant/30 text-secondary text-xs font-black uppercase tracking-widest rounded-xl hover:bg-slate-100 transition-all">
                <span class="material-symbols-outlined text-sm">arrow_back</span>
                Back to List
            </a>
        </div>
    </div>
</div>
{% endblock %}
