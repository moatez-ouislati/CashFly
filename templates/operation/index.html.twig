{% extends 'base.html.twig' %}

{% block title %}Opérations | CashFly{% endblock %}

{% block header_title %}Gestion des Opérations{% endblock %}
{% block header_subtitle %}Suivez tous les revenus et dépenses de vos comptes.{% endblock %}

{% block body %}
    <!-- Filter Section -->
    <div class="bg-surface-container-lowest p-6 rounded-3xl mb-8 border border-outline-variant/20 shadow-sm flex flex-col md:flex-row gap-4 items-center justify-between">
        <form method="get" class="flex flex-wrap gap-4 w-full md:w-auto items-center">
            <!-- Search -->
            <div class="relative w-full md:w-64">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">search</span>
                <input type="text" name="search" value="{{ search }}" placeholder="Rechercher (réf, desc, cat)..." 
                       class="w-full pl-10 pr-4 py-2 bg-surface-container-high border-none rounded-xl text-sm focus:ring-2 focus:ring-primary/50 transition-all">
            </div>

            <!-- Entreprise Filter -->
            <select name="entreprise" class="bg-surface-container-high border-none rounded-xl text-sm py-2 px-4 focus:ring-2 focus:ring-primary/50 transition-all">
                <option value="">Toutes les entreprises</option>
                {% for entreprise in entreprises %}
                    <option value="{{ entreprise.id }}" {% if entreprise.id == entrepriseId %}selected{% endif %}>{{ entreprise.nom }}</option>
                {% endfor %}
            </select>

            <!-- Tresorerie Filter -->
            <select name="tresorerie" class="bg-surface-container-high border-none rounded-xl text-sm py-2 px-4 focus:ring-2 focus:ring-primary/50 transition-all">
                <option value="">Tous les comptes</option>
                {% for t in tresoreries %}
                    <option value="{{ t.id }}" {% if t.id == tresorerieId %}selected{% endif %}>{{ t.nomCompte }}</option>
                {% endfor %}
            </select>

            <!-- Type Filter -->
            <select name="type" class="bg-surface-container-high border-none rounded-xl text-sm py-2 px-4 focus:ring-2 focus:ring-primary/50 transition-all">
                <option value="">Tous les types</option>
                <option value="revenu" {% if type == 'revenu' %}selected{% endif %}>Revenus</option>
                <option value="depense" {% if type == 'depense' %}selected{% endif %}>Dépenses</option>
            </select>

            <!-- Date Filter -->
            <input type="date" name="date" value="{{ date }}" class="bg-surface-container-high border-none rounded-xl text-sm py-2 px-4 focus:ring-2 focus:ring-primary/50 transition-all">

            <button type="submit" class="px-4 py-2 bg-primary text-white rounded-xl hover:bg-primary-container transition-all flex items-center gap-2 font-medium">
                <span class="material-symbols-outlined text-sm">filter_list</span>
                Filtrer
            </button>

            {% if entrepriseId or tresorerieId or search or type or date %}
                <a href="{{ path('app_operation_index') }}" class="px-4 py-2 bg-surface-container-highest text-on-surface rounded-xl hover:bg-outline-variant/20 transition-all flex items-center gap-2 text-sm font-medium">
                    <span class="material-symbols-outlined text-sm">close</span>
                    Réinitialiser
                </a>
            {% endif %}
        </form>

        <div class="flex gap-2 w-full md:w-auto">
            <a href="{{ path('app_operation_export', app.request.query.all) }}" class="flex-1 flex items-center justify-center gap-2 px-5 py-2.5 bg-tertiary text-white font-bold rounded-xl shadow-md hover:bg-tertiary/90 transition-all active:scale-95 whitespace-nowrap">
                <span class="material-symbols-outlined text-sm">download</span>
                Exporter Excel
            </a>
            <a href="{{ path('app_operation_new', {'tresorerie': selected_tresorerie.id|default('')}) }}" class="flex-1 flex items-center justify-center gap-2 px-5 py-2.5 bg-primary text-white font-bold rounded-xl shadow-md hover:bg-primary-container transition-all active:scale-95 whitespace-nowrap">
                <span class="material-symbols-outlined text-sm">add</span>
                Nouvelle Opération
            </a>
        </div>
    </div>

{% if selected_tresorerie %}
    <div class="mb-6 flex items-center gap-3 px-6 py-3 bg-primary/5 border border-primary/10 rounded-2xl">
        <span class="material-symbols-outlined text-primary">account_balance</span>
        <span class="text-sm font-bold text-on-surface">Affichage des opérations pour <span class="text-primary">{{ selected_tresorerie.nomCompte }}</span> ({{ selected_tresorerie.entreprise.nom }})</span>
    </div>
{% endif %}

{% for message in app.flashes('success') %}
    <div class="bg-green-100 text-green-700 border border-green-200 p-4 rounded-xl mb-6 text-sm font-bold flex items-center gap-2">
        <span class="material-symbols-outlined">check_circle</span>
        {{ message }}
    </div>
{% endfor %}

{% if anomalies|length > 0 %}
<div class="bg-error/10 border border-error/20 rounded-3xl p-6 shadow-sm mb-6 flex flex-col md:flex-row gap-6 items-start">
    <div class="w-12 h-12 rounded-full bg-error/20 flex items-center justify-center text-error flex-shrink-0">
        <span class="material-symbols-outlined text-2xl">warning</span>
    </div>
    <div class="flex-1">
        <h3 class="text-error font-black uppercase tracking-widest text-sm mb-2">Métier Avancé: Détection d'anomalies</h3>
        <p class="text-error/80 text-sm font-bold mb-4">Ces dépenses dépassent 200% de la moyenne habituelle pour leur catégorie :</p>
        <div class="space-y-2">
            {% for anomaly in anomalies %}
                <a href="{{ path('app_operation_show', {'id': anomaly.id}) }}" class="flex items-center justify-between p-3 bg-white/50 hover:bg-white/80 rounded-xl transition-colors border border-error/10">
                    <span class="font-bold text-sm text-error-container-on">{{ anomaly.categorie }} ({{ anomaly.dateOperation|date('d/m') }})</span>
                    <span class="font-black text-error">{{ anomaly.montant|number_format(2, ',', ' ') }} TND</span>
                </a>
            {% endfor %}
        </div>
    </div>
</div>
{% endif %}

{# Métier Avancé: Alertes de Paiements Récurrents #}
{% if recurringAlerts|length > 0 %}
<div class="bg-amber-50 border border-amber-200 rounded-3xl p-6 shadow-sm mb-6">
    <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center">
            <span class="material-symbols-outlined text-xl text-amber-600">schedule</span>
        </div>
        <div>
            <h3 class="text-amber-800 font-black text-sm">Métier Avancé: Alertes Paiements Récurrents</h3>
            <p class="text-amber-600 text-xs">Détection des paiements manqués ou montants anormaux</p>
        </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {% for alert in recurringAlerts %}
            <div class="p-4 bg-white rounded-xl border border-amber-100">
                <div class="flex items-center gap-2 mb-2">
                    <span class="material-symbols-outlined text-{{ alert.type == 'missing' ? 'error' : 'amber' }} text-lg">
                        {{ alert.type == 'missing' ? 'warning' : 'trending_up' }}
                    </span>
                    <span class="font-bold text-sm text-on-surface">{{ alert.category }}</span>
                </div>
                <p class="text-xs text-secondary mb-2">{{ alert.message }}</p>
                <div class="flex justify-between text-[10px] text-outline">
                    <span>Dernier: {{ alert.last_date }}</span>
                    <span class="font-bold">{{ alert.last_amount|number_format(2, ',', ' ') }} TND</span>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endif %}

{# Métier Avancé: Analyse Saisonnière #}
{% if seasonalAnalysis.months|length > 1 %}
<div class="bg-surface-container-lowest border border-outline-variant/20 rounded-3xl p-6 shadow-sm mb-6">
    <div class="flex items-center gap-3 mb-4">
        <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center">
            <span class="material-symbols-outlined text-xl text-primary">calendar_month</span>
        </div>
        <div>
            <h3 class="text-primary font-black text-sm">Métier Avancé: Analyse Saisonnière</h3>
            <p class="text-secondary text-xs">Variance mensuelle des revenus et dépenses</p>
        </div>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-xs">
            <thead>
                <tr class="text-[10px] font-black uppercase tracking-widest text-outline border-b border-outline-variant/10">
                    <th class="px-3 py-2 text-left">Mois</th>
                    <th class="px-3 py-2 text-right">Revenus</th>
                    <th class="px-3 py-2 text-right">Variance Rev.</th>
                    <th class="px-3 py-2 text-right">Dépenses</th>
                    <th class="px-3 py-2 text-right">Variance Dép.</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant/5">
                {% for month in seasonalAnalysis.months|reverse|slice(0, 6) %}
                    <tr class="{{ month.is_strong ? 'bg-primary/5' : '' }}">
                        <td class="px-3 py-2 font-bold">{{ month.month }}</td>
                        <td class="px-3 py-2 text-right text-green-600 font-bold">+{{ month.revenu|number_format(0, ',', ' ') }}</td>
                        <td class="px-3 py-2 text-right">
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold {{ month.revenu_variance > 0 ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' }}">
                                {{ month.revenu_variance > 0 ? '+' : '' }}{{ month.revenu_variance }}%
                            </span>
                        </td>
                        <td class="px-3 py-2 text-right text-red-600 font-bold">-{{ month.depense|number_format(0, ',', ' ') }}</td>
                        <td class="px-3 py-2 text-right">
                            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold {{ month.depense_variance > 0 ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700' }}">
                                {{ month.depense_variance > 0 ? '+' : '' }}{{ month.depense_variance }}%
                            </span>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <div class="mt-4 pt-4 border-t border-outline-variant/10 flex items-center gap-4 text-[10px] text-secondary">
        <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-primary/5 border border-primary/20"></span> Mois fort (>20% variance)</span>
        <span>|</span>
        <span>Moyenne revenus: <span class="font-bold text-green-600">{{ seasonalAnalysis.averages.revenu|number_format(0, ',', ' ') }} TND</span></span>
        <span>|</span>
        <span>Moyenne dépenses: <span class="font-bold text-red-600">{{ seasonalAnalysis.averages.depense|number_format(0, ',', ' ') }} TND</span></span>
    </div>
</div>
{% endif %}

<div class="bg-surface-container-lowest rounded-3xl p-8 shadow-sm border border-outline-variant/10">
    <div class="flex justify-between items-center mb-8">
        <h3 class="text-sm font-black uppercase tracking-widest text-on-surface">Historique Financier</h3>
        <button class="flex items-center gap-2 text-xs font-bold text-secondary hover:text-primary transition-colors">
            <span class="material-symbols-outlined text-lg">download</span>
            Exporter en CSV
        </button>
    </div>
    
    <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead>
                <tr class="text-[10px] font-black uppercase tracking-widest text-outline border-b border-outline-variant/10">
                    <th class="px-4 py-4">Référence</th>
                    <th class="px-4 py-4">Compte</th>
                    <th class="px-4 py-4">Type</th>
                    <th class="px-4 py-4">Montant</th>
                    <th class="px-4 py-4">Catégorie</th>
                    <th class="px-4 py-4">Date</th>
                    <th class="px-4 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant/5">
                {% for operation in operations %}
                    <tr class="group hover:bg-surface-container-low transition-colors">
                        <td class="px-4 py-5">
                            <span class="font-bold text-sm text-on-surface">{{ operation.reference|default('N/A') }}</span>
                        </td>
                        <td class="px-4 py-5">
                            <span class="text-sm text-secondary">{{ operation.tresorerie.nomCompte }}</span>
                        </td>
                        <td class="px-4 py-5">
                            <span class="px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest {{ operation.type == 'revenu' ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' }}">
                                {{ operation.type == 'revenu' ? 'REVENU' : 'DÉPENSE' }}
                            </span>
                        </td>
                        <td class="px-4 py-5">
                            <span class="font-black text-sm {{ operation.type == 'revenu' ? 'text-green-600' : 'text-red-600' }}">
                                {{ operation.type == 'revenu' ? '+' : '-' }}{{ operation.montant|number_format(2, ',', ' ') }} TND
                            </span>
                        </td>
                        <td class="px-4 py-5">
                            <span class="text-xs font-bold text-outline">{{ operation.categorie|default('N/A') }}</span>
                        </td>
                        <td class="px-4 py-5">
                            <span class="text-xs text-secondary">{{ operation.dateOperation ? operation.dateOperation|date('d M Y') : 'N/A' }}</span>
                        </td>
                        <td class="px-4 py-5 text-right flex items-center justify-end gap-2">
                            <a href="{{ path('app_operation_pdf', {'id': operation.id}) }}" target="_blank" title="Générer Facture" class="p-2 bg-surface-container-high rounded-lg text-secondary hover:text-primary hover:bg-primary/5 transition-all">
                                <span class="material-symbols-outlined text-lg">picture_as_pdf</span>
                            </a>
                            <a href="{{ path('app_operation_show', {'id': operation.id}) }}" class="p-2 bg-surface-container-high rounded-lg text-secondary hover:text-primary hover:bg-primary/5 transition-all">
                                <span class="material-symbols-outlined text-lg">visibility</span>
                            </a>
                            <a href="{{ path('app_operation_edit', {'id': operation.id}) }}" class="p-2 bg-surface-container-high rounded-lg text-secondary hover:text-primary hover:bg-primary/5 transition-all">
                                <span class="material-symbols-outlined text-lg">edit</span>
                            </a>
                            <form method="post" action="{{ path('app_operation_delete', {'id': operation.id}) }}" onsubmit="return confirm('Confirmer la suppression ?');" class="inline">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ operation.id) }}">
                                <button class="p-2 bg-surface-container-high rounded-lg text-secondary hover:text-error hover:bg-error/5 transition-all">
                                    <span class="material-symbols-outlined text-lg">delete</span>
                                </button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="px-4 py-20 text-center">
                            <span class="material-symbols-outlined text-6xl text-outline mb-4">receipt_long</span>
                            <p class="text-secondary font-medium">Aucune opération trouvée.</p>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
