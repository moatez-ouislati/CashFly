{% extends 'base.html.twig' %}

{% block title %}Documents | {{ entreprise.nom }}{% endblock %}

{% block header_title %}Entreprise Documents{% endblock %}
{% block header_subtitle %}Legal and financial documents for {{ entreprise.nom }}.{% endblock %}

{% block body %}
<div class="bg-surface-container-lowest rounded-3xl p-12 shadow-sm border border-outline-variant/10 text-center">
    <div class="w-24 h-24 bg-primary/5 rounded-full flex items-center justify-center text-primary mx-auto mb-8">
        <span class="material-symbols-outlined text-5xl">folder_open</span>
    </div>
    <h2 class="text-2xl font-black text-on-surface mb-4">No Documents Yet</h2>
    <p class="text-secondary max-w-md mx-auto mb-10">This section is currently empty. In the future, you will be able to upload and manage status, contracts, and other important files for your PME.</p>
    
    <div class="flex justify-center gap-4">
        <a href="{{ path('app_entreprise_show', {'id': entreprise.id}) }}" class="px-8 py-4 bg-surface-container-high text-on-surface text-xs font-black uppercase tracking-widest rounded-xl hover:bg-slate-200 transition-all">
            Back to Profile
        </a>
        <button class="px-8 py-4 bg-primary text-white text-xs font-black uppercase tracking-widest rounded-xl shadow-lg shadow-primary/20 opacity-50 cursor-not-allowed">
            Upload Document (Coming Soon)
        </button>
    </div>
</div>
{% endblock %}
