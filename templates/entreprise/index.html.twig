{% extends 'userDashboard.html.twig' %}

{% block title %}Liste des Entreprises{% endblock %}

{% block body %}
    {% if newEntreprise is defined and newEntreprise %}
        {% set data = newEntreprise %}
        <div id="notification-overlay" class="notification-overlay">
            <div class="notification-modal">
                <div class="notification-header">
                    <div class="notification-icon">
                        <span class="material-symbols-outlined">verified</span>
                    </div>
                    <div class="notification-title">
                        <h2>Entreprise créée avec succès !</h2>
                        <p>Voici les informations de votre nouvelle entreprise</p>
                    </div>
                    <button class="notification-close" onclick="closeNotification()">
                        <span class="material-symbols-outlined">close</span>
                    </button>
                </div>
                <div class="notification-body">
                    <div class="info-grid">
                        <div class="info-item">
                            <span class="info-label">ID Entreprise</span>
                            <span class="info-value id">#{{ data.id }}</span>
                        </div>
                        <div class="info-item full-width">
                            <span class="info-label">Nom de l'entreprise</span>
                            <span class="info-value name">{{ data.nom }}</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Secteur</span>
                            <span class="info-value badge">{{ data.secteur }}</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Forme Juridique</span>
                            <span class="info-value">{{ data.formeJuridique }}</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Date de création</span>
                            <span class="info-value">{{ data.dateCreation }}</span>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Capital</span>
                            <span class="info-value capital">{{ data.capital }}</span>
                        </div>
                        <div class="info-item full-width">
                            <span class="info-label">Adresse</span>
                            <span class="info-value">{{ data.adresse }}</span>
                        </div>
                    </div>
                </div>
                <div class="notification-footer">
                    <a href="{{ path('app_entreprise_show', {'id': data.id}) }}" class="action-btn view">
                        <span class="material-symbols-outlined">visibility</span>
                        Voir les détails
                    </a>
                    <button class="action-btn close" onclick="closeNotification()">
                        Continuer
                    </button>
                </div>
            </div>
        </div>
    {% endif %}


    <style>
        .notification-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(13, 28, 50, 0.6);
            backdrop-filter: blur(8px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            animation: fadeIn 0.3s ease-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes slideUp {
            from { transform: translateY(30px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        .notification-modal {
            background: #ffffff;
            border-radius: 24px;
            width: 90%;
            max-width: 520px;
            box-shadow: 0 32px 64px rgba(13, 28, 50, 0.25);
            animation: slideUp 0.4s ease-out;
            overflow: hidden;
        }

        .notification-header {
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            padding: 1.75rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            position: relative;
        }

        .notification-icon {
            width: 56px;
            height: 56px;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .notification-icon .material-symbols-outlined {
            font-size: 32px;
            color: #ffffff;
        }

        .notification-title {
            flex: 1;
        }

        .notification-title h2 {
            font-family: 'Syne', sans-serif;
            font-size: 1.25rem;
            font-weight: 800;
            color: #ffffff;
            margin: 0 0 0.25rem;
        }

        .notification-title p {
            font-size: 0.875rem;
            color: rgba(255, 255, 255, 0.85);
            margin: 0;
        }

        .notification-close {
            position: absolute;
            top: 1rem;
            right: 1rem;
            background: rgba(255, 255, 255, 0.2);
            border: none;
            border-radius: 50%;
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.2s;
        }

        .notification-close:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: scale(1.1);
        }

        .notification-close .material-symbols-outlined {
            font-size: 20px;
            color: #ffffff;
        }

        .notification-body {
            padding: 1.75rem;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .info-item {
            display: flex;
            flex-direction: column;
            gap: 0.35rem;
        }

        .info-item.full-width {
            grid-column: 1 / -1;
        }

        .info-label {
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #64748b;
        }

        .info-value {
            font-size: 0.95rem;
            font-weight: 600;
            color: #0d1c32;
        }

        .info-value.id {
            font-family: 'Syne', sans-serif;
            font-weight: 800;
            color: #4f46e5;
        }

        .info-value.name {
            font-family: 'Syne', sans-serif;
            font-size: 1.1rem;
            font-weight: 800;
            color: #0d1c32;
        }

        .info-value.badge {
            background: #eff6ff;
            color: #1d4ed8;
            padding: 0.25rem 0.65rem;
            border-radius: 6px;
            font-size: 0.8rem;
            font-weight: 700;
            display: inline-block;
            width: fit-content;
        }

        .info-value.capital {
            font-family: 'Syne', sans-serif;
            font-size: 1.1rem;
            font-weight: 800;
            color: #16a34a;
        }

        .notification-footer {
            padding: 1.25rem 1.75rem;
            background: #f8fafc;
            border-top: 1px solid #e2e8f0;
            display: flex;
            gap: 1rem;
            justify-content: flex-end;
        }

        .action-btn {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.65rem 1.25rem;
            border-radius: 10px;
            font-size: 0.875rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s;
            cursor: pointer;
            border: none;
        }

        .action-btn .material-symbols-outlined {
            font-size: 18px;
        }

        .action-btn.view {
            background: #eff6ff;
            color: #1d4ed8;
        }

        .action-btn.view:hover {
            background: #dbeafe;
        }

        .action-btn.close {
            background: #4f46e5;
            color: #ffffff;
        }

        .action-btn.close:hover {
            background: #4338ca;
        }

        @media (max-width: 480px) {
            .info-grid {
                grid-template-columns: 1fr;
            }
            .notification-footer {
                flex-direction: column;
            }
            .action-btn {
                justify-content: center;
            }
        }
    </style>

    <script>
        function closeNotification() {
            const overlay = document.getElementById('notification-overlay');
            if (overlay) {
                overlay.style.animation = 'fadeIn 0.2s ease-out reverse';
                setTimeout(() => {
                    overlay.remove();
                }, 200);
            }
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeNotification();
            }
        });

        document.getElementById('notification-overlay')?.addEventListener('click', function(e) {
            if (e.target === this) {
                closeNotification();
            }
        });
    </script>

    <!-- Header Section -->
    <header class="flex justify-between items-end mb-8">
        <div>
            <h1 class="text-4xl font-black tracking-tight text-on-surface mb-2">Gestion des Entreprises</h1>
            <p class="text-secondary font-medium">Gérez votre portefeuille d'entreprises ici.</p>
        </div>
         <div class="flex items-center gap-4">
            <a href="{{ path('app_entreprise_new') }}" class="flex items-center gap-2 bg-primary text-white px-5 py-3 rounded-xl text-sm font-bold shadow-lg shadow-primary/20 hover:bg-blue-700 transition-all">
                <span class="material-symbols-outlined text-sm">add</span>
                Créer une entreprise
            </a>
        </div>
    </header>

    <!-- Cards Section -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 mb-8">
        {% for entreprise in entreprises %}
            <div class="bg-surface-container-lowest rounded-3xl p-6 shadow-[0_16px_32px_-16px_rgba(13,28,50,0.06)] border border-outline-variant/20 flex flex-col group hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
                
                <!-- Card Header -->
                <div class="flex justify-between items-start mb-4">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-xl flex items-center justify-center shadow-sm text-lg font-black text-white" style="background: linear-gradient(135deg, #4f46e5, #7c3aed);">
                            {{ entreprise.nom[:2]|upper }}
                        </div>
                        <div>
                            <span class="text-xs font-bold text-secondary uppercase tracking-widest mb-1 block">#{{ entreprise.id }}</span>
                            <h2 class="text-lg font-black text-on-surface leading-tight">{{ entreprise.nom }}</h2>
                        </div>
                    </div>
                    <div class="flex gap-2 opacity-100 lg:opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                        <a href="{{ path('app_entreprise_show', {'id': entreprise.id}) }}" class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-colors" title="Voir">
                            <span class="material-symbols-outlined text-sm">visibility</span>
                        </a>
                        <a href="{{ path('app_entreprise_edit', {'id': entreprise.id}) }}" class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-tertiary hover:bg-tertiary hover:text-white transition-colors" title="Modifier">
                            <span class="material-symbols-outlined text-sm">edit</span>
                        </a>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="flex-grow space-y-4 mb-6">
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-secondary font-medium">Secteur</span>
                        <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded-md text-xs font-bold">{{ entreprise.secteur }}</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-secondary font-medium">Forme Juridique</span>
                        <span class="font-semibold text-on-surface">{{ entreprise.formeJuridique ?: '-' }}</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-secondary font-medium">Date Création</span>
                        <span class="font-semibold text-on-surface">{{ entreprise.dateCreation ? entreprise.dateCreation|date('d/m/Y') : '-' }}</span>
                    </div>
                </div>

                <!-- Card Footer -->
                <div class="mt-auto pt-4 border-t border-outline-variant/10 flex justify-between items-end">
                    <span class="text-xs font-bold text-secondary uppercase tracking-widest">Capital</span>
                    <span class="text-2xl font-black text-tertiary">{{ entreprise.capital ? '$' ~ entreprise.capital : '-' }}</span>
                </div>
            </div>
        {% else %}
            <div class="col-span-full bg-surface-container-lowest rounded-3xl p-12 shadow-[0_32px_64px_-16px_rgba(13,28,50,0.06)] border border-outline-variant/20 text-center flex flex-col items-center justify-center">
                <span class="material-symbols-outlined text-5xl mb-4 text-secondary opacity-50">domain_disabled</span>
                <h3 class="text-xl font-bold text-on-surface mb-2">Aucune entreprise trouvée</h3>
                <p class="text-secondary font-medium">Commencez par ajouter votre première entreprise au portefeuille.</p>
            </div>
        {% endfor %}
    </div>
{% endblock %}