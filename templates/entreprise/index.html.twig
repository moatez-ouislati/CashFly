{% extends 'base.html.twig' %}

{% block title %}Entreprises | CashFly{% endblock %}

{% block header_title %}
    {% if is_granted('ROLE_INVESTISSEUR') %}
        Découvrir des PMEs
    {% else %}
        Gestion des Entreprises
    {% endif %}
{% endblock %}
{% block header_subtitle %}
    {% if is_granted('ROLE_INVESTISSEUR') %}
        Trouvez votre prochain investissement parmi les PMEs de la plateforme.
    {% else %}
        Liste de toutes les PMEs enregistrées dans votre portefeuille.
    {% endif %}
{% endblock %}

{% block body %}
<div class="mb-8 flex flex-col md:flex-row justify-between items-center gap-6 bg-surface-container-lowest p-6 rounded-3xl shadow-sm border border-outline-variant/10">
    <form method="get" class="flex flex-col md:flex-row items-center gap-4 w-full md:w-auto flex-grow">
        <div class="relative w-full md:w-80 group">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">search</span>
            <input type="text" name="q" value="{{ search }}" placeholder="Rechercher une entreprise..." class="w-full pl-12 pr-4 py-3 bg-surface-container-low border-none focus:ring-2 focus:ring-primary/20 rounded-2xl text-sm font-medium transition-all">
        </div>
        
        <div class="relative w-full md:w-60 group">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-outline group-focus-within:text-primary transition-colors">category</span>
            <select name="sector" onchange="this.form.submit()" class="w-full pl-12 pr-4 py-3 bg-surface-container-low border-none focus:ring-2 focus:ring-primary/20 rounded-2xl text-sm font-medium transition-all appearance-none">
                <option value="">Tous les secteurs</option>
                {% for sector in sectors %}
                    <option value="{{ sector }}" {% if current_sector == sector %}selected{% endif %}>{{ sector }}</option>
                {% endfor %}
            </select>
        </div>
        
        {% if search or current_sector %}
            <a href="{{ path('app_entreprise_index') }}" class="text-xs font-bold text-error uppercase tracking-widest hover:underline flex items-center gap-1">
                <span class="material-symbols-outlined text-sm">close</span>
                Effacer
            </a>
        {% endif %}
    </form>

    {% if is_granted('ROLE_PROPRIETAIRE') %}
        <a href="{{ path('app_entreprise_new') }}" class="flex items-center gap-2 px-6 py-4 bg-primary text-white font-black rounded-xl shadow-xl shadow-primary/20 hover:bg-primary-container transition-all active:scale-95 whitespace-nowrap">
            <span class="material-symbols-outlined">add_business</span>
            Ajouter une PME
        </a>
    {% endif %}
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {% for entreprise in entreprises %}
        <div class="bg-surface-container-lowest rounded-3xl p-8 shadow-sm hover:shadow-md transition-shadow group border border-outline-variant/10">
            <div class="flex justify-between items-start mb-6">
                <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center text-primary">
                    <span class="material-symbols-outlined">business</span>
                </div>
                {% if is_granted('ROLE_PROPRIETAIRE') or is_granted('ROLE_ADMIN') %}
                    <div class="text-right">
                        <p class="text-[10px] font-bold uppercase tracking-widest text-secondary">Capital</p>
                        <p class="text-sm font-black text-on-surface">{{ entreprise.capital|number_format(2, ',', ' ') }} TND</p>
                    </div>
                {% endif %}
            </div>
            
            <h3 class="text-xl font-black text-on-surface mb-2">{{ entreprise.nom }}</h3>
            <p class="text-secondary text-sm mb-6">{{ entreprise.secteur }} • {{ entreprise.formeJuridique }}</p>
            
            <div class="space-y-3 mb-8">
                <div class="flex items-center gap-3 text-sm text-secondary">
                    <span class="material-symbols-outlined text-sm">location_on</span>
                    {{ entreprise.adresse }}
                </div>
                <div class="flex items-center gap-3 text-sm text-secondary">
                    <span class="material-symbols-outlined text-sm">person</span>
                    Propriétaire: {{ entreprise.proprietaire.prenom }} {{ entreprise.proprietaire.nom }}
                </div>
            </div>
            
            <div class="flex gap-3">
                {% if is_granted('ROLE_PROPRIETAIRE') or is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_tresorerie_index', {'entreprise': entreprise.id}) }}" class="flex-1 py-3 text-center bg-primary text-white text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-primary-container transition-all shadow-md shadow-primary/10">
                        Voir les comptes
                    </a>
                {% elseif is_granted('ROLE_INVESTISSEUR') %}
                    <a href="{{ path('app_entreprise_show', {'id': entreprise.id}) }}" class="flex-1 py-3 text-center bg-surface-container-high text-on-surface text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-slate-200 transition-all flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-sm">info</span>
                        Détails
                    </a>
                    <a href="{{ path('app_investissement_new', {'entreprise': entreprise.id}) }}" class="flex-1 py-3 text-center bg-primary text-white text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-primary-container transition-all shadow-md shadow-primary/10 flex items-center justify-center gap-2">
                        <span class="material-symbols-outlined text-sm">trending_up</span>
                        Investir
                    </a>
                {% endif %}

                {% if is_granted('ROLE_PROPRIETAIRE') or is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_entreprise_show', {'id': entreprise.id}) }}" class="p-3 bg-surface-container-high text-on-surface rounded-xl hover:bg-slate-200 transition-all" title="Détails">
                        <span class="material-symbols-outlined text-sm">info</span>
                    </a>
                    <a href="{{ path('app_entreprise_edit', {'id': entreprise.id}) }}" class="p-3 bg-primary/5 text-primary rounded-xl hover:bg-primary/10 transition-all" title="Modifier">
                        <span class="material-symbols-outlined text-sm">edit</span>
                    </a>
                    <form method="post" action="{{ path('app_entreprise_delete', {'id': entreprise.id}) }}" onsubmit="return confirm('Confirmer la suppression ?');" class="inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ entreprise.id) }}">
                        <button class="p-3 text-error bg-error/5 rounded-xl hover:bg-error/10 transition-all" title="Supprimer">
                            <span class="material-symbols-outlined text-sm">delete</span>
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>
    {% else %}
        <div class="col-span-full text-center py-20 bg-surface-container-lowest rounded-3xl border-2 border-dashed border-outline-variant/30">
            <span class="material-symbols-outlined text-6xl text-outline mb-4">search_off</span>
            <p class="text-secondary font-medium">Aucune entreprise trouvée.</p>
        </div>
    {% endfor %}
</div>
{% endblock %}
