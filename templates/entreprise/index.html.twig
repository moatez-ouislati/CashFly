{% extends 'userDashboard.html.twig' %}

{% block title %}Liste des Entreprises{% endblock %}

{% block body %}
    <!-- Header Section -->
    <header class="flex justify-between items-end mb-8">
        <div>
            <h1 class="text-4xl font-black tracking-tight text-on-surface mb-2">Gestion des Entreprises</h1>
            <p class="text-secondary font-medium">Gérez votre portefeuille d'entreprises ici.</p>
        </div>
         <div class="flex items-center gap-4">
            <a href="{{ path('app_entreprise_new') }}" class="flex items-center gap-2 bg-primary text-white px-5 py-3 rounded-xl text-sm font-bold shadow-lg shadow-primary/20 hover:bg-blue-700 transition-all">
                <span class="material-symbols-outlined text-sm">add</span>
                Créer une entreprise
            </a>
        </div>
    </header>

    <!-- Cards Section -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 mb-8">
        {% for entreprise in entreprises %}
            <div class="bg-surface-container-lowest rounded-3xl p-6 shadow-[0_16px_32px_-16px_rgba(13,28,50,0.06)] border border-outline-variant/20 flex flex-col group hover:-translate-y-1 hover:shadow-xl transition-all duration-300">
                
                <!-- Card Header -->
                <div class="flex justify-between items-start mb-6">
                    <div>
                        <span class="text-xs font-bold text-secondary uppercase tracking-widest mb-1 block">#{{ entreprise.id }}</span>
                        <h2 class="text-xl font-black text-on-surface leading-tight">{{ entreprise.nom }}</h2>
                    </div>
                    <div class="flex gap-2 opacity-100 lg:opacity-0 group-hover:opacity-100 transition-opacity duration-200">
                        <a href="{{ path('app_entreprise_show', {'id': entreprise.id}) }}" class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-primary hover:bg-primary hover:text-white transition-colors" title="Voir">
                            <span class="material-symbols-outlined text-sm">visibility</span>
                        </a>
                        <a href="{{ path('app_entreprise_edit', {'id': entreprise.id}) }}" class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-tertiary hover:bg-tertiary hover:text-white transition-colors" title="Modifier">
                            <span class="material-symbols-outlined text-sm">edit</span>
                        </a>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="flex-grow space-y-4 mb-6">
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-secondary font-medium">Secteur</span>
                        <span class="bg-blue-100 text-blue-800 px-2 py-1 rounded-md text-xs font-bold">{{ entreprise.secteur }}</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-secondary font-medium">Forme Juridique</span>
                        <span class="font-semibold text-on-surface">{{ entreprise.formeJuridique ?: '-' }}</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-secondary font-medium">Date Création</span>
                        <span class="font-semibold text-on-surface">{{ entreprise.dateCreation ? entreprise.dateCreation|date('d/m/Y') : '-' }}</span>
                    </div>
                </div>

                <!-- Card Footer -->
                <div class="mt-auto pt-4 border-t border-outline-variant/10 flex justify-between items-end">
                    <span class="text-xs font-bold text-secondary uppercase tracking-widest">Capital</span>
                    <span class="text-2xl font-black text-tertiary">{{ entreprise.capital ? '$' ~ entreprise.capital : '-' }}</span>
                </div>
            </div>
        {% else %}
            <div class="col-span-full bg-surface-container-lowest rounded-3xl p-12 shadow-[0_32px_64px_-16px_rgba(13,28,50,0.06)] border border-outline-variant/20 text-center flex flex-col items-center justify-center">
                <span class="material-symbols-outlined text-5xl mb-4 text-secondary opacity-50">domain_disabled</span>
                <h3 class="text-xl font-bold text-on-surface mb-2">Aucune entreprise trouvée</h3>
                <p class="text-secondary font-medium">Commencez par ajouter votre première entreprise au portefeuille.</p>
            </div>
        {% endfor %}
    </div>
{% endblock %}