{% extends 'base.html.twig' %}
{% block title %}Toutes les Entreprises{% endblock %}

{% block body %}
    <!-- Header Section -->
    <header class="flex justify-between items-end mb-8">
        <div>
            <h1 class="text-4xl font-black tracking-tight text-slate-800 mb-2">Toutes les Entreprises</h1>
            <p class="text-slate-500 font-medium">Vue d'ensemble de toutes les entreprises de la plateforme.</p>
        </div>
    </header>

    <!-- Statistics Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
        <!-- Total Capital -->
        <div class="bg-gradient-to-br from-blue-600 to-blue-700 rounded-3xl p-6 text-white shadow-lg shadow-blue-600/20">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center">
                    <span class="material-symbols-outlined">account_balance</span>
                </div>
            </div>
            <p class="text-blue-100 text-sm font-medium mb-1">Capital Total</p>
            <p class="text-3xl font-black">{{ capitalStats.total_capital|number_format(0, ',', ' ') }} $</p>
        </div>

        <!-- Average Capital -->
        <div class="bg-gradient-to-br from-emerald-600 to-emerald-700 rounded-3xl p-6 text-white shadow-lg shadow-emerald-600/20">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center">
                    <span class="material-symbols-outlined">trending_up</span>
                </div>
            </div>
            <p class="text-emerald-100 text-sm font-medium mb-1">Capital Moyen</p>
            <p class="text-3xl font-black">{{ capitalStats.avg_capital|number_format(0, ',', ' ') }} $</p>
        </div>

        <!-- Min Capital -->
        <div class="bg-gradient-to-br from-amber-500 to-amber-600 rounded-3xl p-6 text-white shadow-lg shadow-amber-500/20">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center">
                    <span class="material-symbols-outlined">south</span>
                </div>
            </div>
            <p class="text-amber-100 text-sm font-medium mb-1">Capital Minimum</p>
            <p class="text-3xl font-black">{{ capitalStats.min_capital|number_format(0, ',', ' ') }} $</p>
        </div>

        <!-- Max Capital -->
        <div class="bg-gradient-to-br from-purple-600 to-purple-700 rounded-3xl p-6 text-white shadow-lg shadow-purple-600/20">
            <div class="flex items-center justify-between mb-4">
                <div class="w-12 h-12 bg-white/20 rounded-xl flex items-center justify-center">
                    <span class="material-symbols-outlined">north</span>
                </div>
            </div>
            <p class="text-purple-100 text-sm font-medium mb-1">Capital Maximum</p>
            <p class="text-3xl font-black">{{ capitalStats.max_capital|number_format(0, ',', ' ') }} $</p>
        </div>
    </div>

    <!-- Sector Stats & Top Entreprises -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <!-- Capital by Sector -->
        <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200">
            <h3 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
                <span class="material-symbols-outlined text-blue-600">pie_chart</span>
                Capital par Secteur
            </h3>
            <div class="space-y-3">
                {% for stat in sectorStats %}
                    {% set percentage = (stat.total_capital / capitalStats.total_capital * 100)|round %}
                    <div>
                        <div class="flex justify-between items-center mb-1">
                            <span class="text-sm font-semibold text-slate-700">{{ stat.secteur }}</span>
                            <span class="text-sm font-bold text-slate-800">{{ stat.total_capital|number_format(0, ',', ' ') }} $ <span class="text-slate-400 font-normal">({{ stat.count }})</span></span>
                        </div>
                        <div class="w-full bg-slate-100 rounded-full h-2">
                            <div class="bg-gradient-to-r from-blue-500 to-blue-600 h-2 rounded-full transition-all duration-500" style="width: {{ percentage }}%"></div>
                        </div>
                    </div>
                {% else %}
                    <p class="text-slate-500 text-sm text-center py-4">Aucune donnée disponible</p>
                {% endfor %}
            </div>
        </div>

        <!-- Top Entreprises by Capital -->
        <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200">
            <h3 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
                <span class="material-symbols-outlined text-purple-600">emoji_events</span>
                Top Entreprises
            </h3>
            <div class="space-y-3">
                {% for entreprise in topEntreprises %}
                    <div class="flex items-center gap-4 p-3 rounded-xl hover:bg-slate-50 transition-colors">
                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-blue-500 flex items-center justify-center text-white font-bold text-sm">
                            {{ loop.index }}
                        </div>
                        <div class="flex-grow">
                            <p class="font-semibold text-slate-800 text-sm">{{ entreprise.nom }}</p>
                            <p class="text-slate-500 text-xs">{{ entreprise.secteur|default('Non défini') }}</p>
                        </div>
                        <div class="text-right">
                            <p class="font-black text-slate-800">{{ entreprise.capital|number_format(0, ',', ' ') }} $</p>
                        </div>
                    </div>
                {% else %}
                    <p class="text-slate-500 text-sm text-center py-4">Aucune entreprise</p>
                {% endfor %}
            </div>
        </div>
    </div>

    <!-- Search & Filter Bar -->
    <div class="mb-8 bg-white p-6 rounded-3xl shadow-sm border border-slate-200">
        <!-- AJOUT DE id="search-form" ICI -->
        <form id="search-form" method="get" action="{{ path('app_entreprise_admin_index') }}" class="flex flex-col md:flex-row gap-4 items-end">
            
            <!-- Search Input -->
            <div class="flex-grow w-full">
                <label for="q" class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Recherche</label>
                <div class="relative">
                    <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400">search</span>
                    <input type="text" id="q" name="q" value="{{ currentSearch|default('') }}" placeholder="Nom de l'entreprise..." class="w-full pl-12 pr-4 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all text-slate-700 bg-slate-50 focus:bg-white text-sm font-medium">
                </div>
            </div>

            <!-- Sector Filter -->
            <div class="w-full md:w-64">
                <label for="secteur" class="block text-xs font-bold text-slate-500 uppercase tracking-widest mb-2">Secteur</label>
                <div class="relative">
                    <select id="secteur" name="secteur" class="w-full pl-4 pr-10 py-3 border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all text-slate-700 bg-slate-50 focus:bg-white text-sm font-medium appearance-none cursor-pointer">
                        <option value="">Tous les secteurs</option>
                        {% for sec in secteurs|default([]) %}
                            <option value="{{ sec }}" {% if currentSecteur|default('') == sec %}selected{% endif %}>{{ sec }}</option>
                        {% endfor %}
                    </select>
                    <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">expand_content</span>
                </div>
            </div>

            <!-- Buttons -->
            <div class="flex gap-2 w-full md:w-auto">
                <button type="submit" class="flex-1 md:flex-none flex items-center justify-center gap-2 bg-blue-600 text-white px-6 py-3 rounded-xl text-sm font-bold shadow-md shadow-blue-600/20 hover:bg-blue-700 transition-colors">
                    <span class="material-symbols-outlined text-sm">filter_alt</span>
                    Filtrer
                </button>
                
                {% if currentSearch|default('') or currentSecteur|default('') %}
                    <a href="{{ path('app_entreprise_admin_index') }}" class="flex items-center justify-center bg-slate-100 text-slate-500 hover:bg-slate-200 hover:text-slate-700 px-4 py-3 rounded-xl transition-colors" title="Réinitialiser les filtres">
                        <span class="material-symbols-outlined text-sm">close</span>
                    </a>
                {% endif %}
            </div>
            
        </form>
    </div>

    <!-- Cards Section -->
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6 mb-8">
        {% for entreprise in entreprises %}
            <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200 flex flex-col group hover:-translate-y-1 hover:shadow-md transition-all duration-300">
                
                <!-- Card Header -->
                <div class="flex justify-between items-start mb-4">
                    <div class="flex items-center gap-3">
                        <div class="w-12 h-12 rounded-xl flex items-center justify-center shadow-sm text-lg font-black text-white" style="background: linear-gradient(135deg, #4f46e5, #7c3aed);">
                            {{ entreprise.nom[:2]|upper }}
                        </div>
                        <div>
                            <span class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-1 block">#{{ entreprise.id }}</span>
                            <h2 class="text-lg font-black text-slate-800 leading-tight">{{ entreprise.nom }}</h2>
                        </div>
                    </div>
                </div>

                <!-- Card Body -->
                <div class="flex-grow space-y-4 mb-6">
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-slate-500 font-medium">Secteur</span>
                        <span class="bg-blue-50 text-blue-700 px-2 py-1 rounded-md text-xs font-bold">{{ entreprise.secteur ?: 'Non défini' }}</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-slate-500 font-medium">Forme Juridique</span>
                        <span class="font-semibold text-slate-700">{{ entreprise.formeJuridique ?: '-' }}</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-slate-500 font-medium">Date Création</span>
                        <span class="font-semibold text-slate-700">{{ entreprise.dateCreation ? entreprise.dateCreation|date('d/m/Y') : '-' }}</span>
                    </div>
                    <div class="flex justify-between items-center text-sm">
                        <span class="text-slate-500 font-medium">Propriétaire</span>
                        <span class="font-semibold text-slate-700">#{{ entreprise.proprietaire?.id|default('-') }}</span>
                    </div>
                </div>

                <!-- Card Footer -->
                <div class="mt-auto pt-4 border-t border-slate-100 flex justify-between items-end">
                    <span class="text-xs font-bold text-slate-400 uppercase tracking-widest">Capital</span>
                    <span class="text-2xl font-black text-blue-600">{{ entreprise.capital ? '$' ~ entreprise.capital : '-' }}</span>
                </div>
            </div>
        {% else %}
            <div class="col-span-full bg-white rounded-3xl p-12 shadow-sm border border-slate-200 text-center flex flex-col items-center justify-center">
                <span class="material-symbols-outlined text-5xl mb-4 text-slate-300">domain_disabled</span>
                <h3 class="text-xl font-bold text-slate-800 mb-2">Aucune entreprise trouvée</h3>
                <p class="text-slate-500 font-medium">Réessayez avec d'autres critères de recherche.</p>
            </div>
        {% endfor %}
    </div>

    <!-- Pagination -->
    {% set pData = entreprises.paginationData %}
    {% if pData.pageCount > 1 %}
    <div class="mt-6 flex justify-center">
        <nav class="flex items-center gap-1">
            {% if pData.previous is defined and pData.previous %}
                <a href="{{ path('app_entreprise_admin_index', {page: pData.previous, q: currentSearch, secteur: currentSecteur}) }}" 
                   class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 transition-colors">
                    <span class="material-symbols-outlined text-sm">chevron_left</span>
                </a>
            {% endif %}

            {% for page in 1..pData.pageCount %}
                {% if page == pData.current %}
                    <span class="w-10 h-10 flex items-center justify-center rounded-xl bg-blue-600 text-white font-bold">{{ page }}</span>
                {% elseif page >= pData.current - 2 and page <= pData.current + 2 %}
                    <a href="{{ path('app_entreprise_admin_index', {page: page, q: currentSearch, secteur: currentSecteur}) }}" 
                       class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 transition-colors font-medium">
                        {{ page }}
                    </a>
                {% endif %}
            {% endfor %}

            {% if pData.next is defined and pData.next %}
                <a href="{{ path('app_entreprise_admin_index', {page: pData.next, q: currentSearch, secteur: currentSecteur}) }}" 
                   class="w-10 h-10 flex items-center justify-center rounded-xl bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 transition-colors">
                    <span class="material-symbols-outlined text-sm">chevron_right</span>
                </a>
            {% endif %}
        </nav>
    </div>
    <p class="text-center text-sm text-slate-500 mt-2">
        Page {{ pData.current }} sur {{ pData.pageCount }} ({{ pData.totalCount }} entreprises)
    </p>
    {% endif %}

    <!-- SCRIPT POUR LA RECHERCHE EN TEMPS RÉEL -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('search-form');
            const searchInput = document.getElementById('q');
            const secteurSelect = document.getElementById('secteur');
            
            let typingTimer;
            const doneTypingInterval = 400; // Attend 400ms après la frappe avant de chercher

            // Écouteur pour la barre de saisie
            searchInput.addEventListener('input', function() {
                clearTimeout(typingTimer);
                typingTimer = setTimeout(function() {
                    form.submit();
                }, doneTypingInterval);
            });

            // Écouteur pour la liste déroulante (cherche immédiatement au clic)
            secteurSelect.addEventListener('change', function() {
                form.submit();
            });
            
            // Placer le curseur à la fin du texte dans l'input (pour ne pas perdre le focus lors du rechargement)
            if (searchInput.value.length > 0) {
                searchInput.focus();
                searchInput.setSelectionRange(searchInput.value.length, searchInput.value.length);
            }
        });
    </script>
{% endblock %}
