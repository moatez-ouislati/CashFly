{% extends 'userDashboard.html.twig' %}

{% block title %}Nouveau Document{% endblock %}

{% block body %}
    <header class="flex justify-between items-end mb-8">
        <div>
            <a href="{{ path('app_document_index') }}" class="text-xs font-bold uppercase tracking-widest text-primary hover:text-blue-700 mb-4 inline-flex items-center gap-1 transition-colors">
                <span class="material-symbols-outlined text-sm">arrow_back</span>
                Retour à la liste
            </a>
            <h1 class="text-4xl font-black tracking-tight text-on-surface mb-2">Ajouter un Document</h1>
            <p class="text-secondary font-medium">Ajoutez les détails du document ci-dessous.</p>
        </div>
    </header>

    <div class="bg-surface-container-lowest rounded-3xl p-8 shadow-[0_32px_64px_-16px_rgba(13,28,50,0.06)] border border-outline-variant/20 w-full mb-8">
        {{ include('document/_form.html.twig') }}
    </div>
{% endblock %}