{% extends 'base.html.twig' %}

{% block title %}Nouveau Document | CashFly{% endblock %}

{% block header_title %}Ajouter un Document{% endblock %}
{% block header_subtitle %}Uploadez un nouveau document pour votre PME.{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto bg-surface-container-lowest p-8 rounded-3xl shadow-sm border border-outline-variant/10">
    <div class="flex justify-between items-center mb-8">
        <h3 class="text-sm font-black uppercase tracking-widest text-on-surface">Uploader un fichier</h3>
        <a href="{{ path('app_document_index') }}" class="flex items-center gap-2 text-secondary px-4 py-2 rounded-lg font-bold text-sm hover:text-primary transition-all">
            <span class="material-symbols-outlined text-lg">arrow_back</span>
            Retour à la liste
        </a>
    </div>

    {{ form_start(form) }}
        <div class="text-error text-sm mb-4">
            {{ form_errors(form) }}
        </div>

        <div class="space-y-6">
            <div class="space-y-1.5">
                {{ form_label(form.nom) }}
                {{ form_widget(form.nom, {'attr': {'class': 'w-full bg-surface-container-low border-none focus:ring-2 focus:ring-primary/40 rounded-xl py-4 px-6 text-on-surface placeholder-outline/30 transition-all duration-300'}}) }}
                {{ form_errors(form.nom, {'attr': {'class': 'text-error text-[10px] font-bold uppercase tracking-widest ml-1 mt-1'}}) }}
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="space-y-1.5">
                    {{ form_label(form.type) }}
                    {{ form_widget(form.type, {'attr': {'class': 'w-full bg-surface-container-low border-none focus:ring-2 focus:ring-primary/40 rounded-xl py-4 px-6 text-on-surface placeholder-outline/30 transition-all duration-300'}}) }}
                    {{ form_errors(form.type, {'attr': {'class': 'text-error text-[10px] font-bold uppercase tracking-widest ml-1 mt-1'}}) }}
                </div>
                <div class="space-y-1.5">
                    {{ form_label(form.entreprise) }}
                    {{ form_widget(form.entreprise, {'attr': {'class': 'w-full bg-surface-container-low border-none focus:ring-2 focus:ring-primary/40 rounded-xl py-4 px-6 text-on-surface placeholder-outline/30 transition-all duration-300'}}) }}
                    {{ form_errors(form.entreprise, {'attr': {'class': 'text-error text-[10px] font-bold uppercase tracking-widest ml-1 mt-1'}}) }}
                </div>
            </div>

            <div class="space-y-1.5">
                {{ form_label(form.fichier) }}
                {{ form_widget(form.fichier, {'attr': {'class': 'w-full bg-surface-container-low border-none focus:ring-2 focus:ring-primary/40 rounded-xl py-4 px-6 text-on-surface placeholder-outline/30 transition-all duration-300 file:mr-4 file:py-2 file:px-4 file:rounded-full file:border-0 file:text-xs file:font-black file:uppercase file:bg-primary/10 file:text-primary hover:file:bg-primary/20'}}) }}
                {{ form_errors(form.fichier, {'attr': {'class': 'text-error text-[10px] font-bold uppercase tracking-widest ml-1 mt-1'}}) }}
            </div>

            <div class="space-y-1.5">
                {{ form_label(form.description) }}
                {{ form_widget(form.description, {'attr': {'class': 'w-full bg-surface-container-low border-none focus:ring-2 focus:ring-primary/40 rounded-xl py-4 px-6 text-on-surface placeholder-outline/30 transition-all duration-300', 'rows': 4}}) }}
                {{ form_errors(form.description, {'attr': {'class': 'text-error text-[10px] font-bold uppercase tracking-widest ml-1 mt-1'}}) }}
            </div>
        </div>

        <div class="mt-10 flex justify-end">
            <button class="bg-primary text-white px-8 py-4 rounded-xl font-black text-sm hover:bg-primary-container transition-all flex items-center gap-2 group shadow-xl shadow-primary/20">
                Uploader le document
                <span class="material-symbols-outlined text-lg group-hover:translate-y-[-2px] transition-transform">upload</span>
            </button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
