{% extends 'base.html.twig' %}

{% block title %}Mes Documents | CashFly{% endblock %}

{% block header_title %}Mes Documents{% endblock %}
{% block header_subtitle %}Gérez tous les documents de vos PMEs en un seul endroit.{% endblock %}

{% block body %}
<div class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
    <form method="get" class="flex flex-wrap gap-4 w-full lg:w-auto">
        <input type="text" name="search" value="{{ search }}" placeholder="Rechercher un document..." class="px-6 py-4 bg-surface-container-lowest border border-outline-variant/20 rounded-xl text-sm focus:ring-2 focus:ring-primary/40 focus:border-primary transition-all min-w-[300px]">
        
        <select name="type" class="px-6 py-4 bg-surface-container-lowest border border-outline-variant/20 rounded-xl text-sm focus:ring-2 focus:ring-primary/40 transition-all">
            <option value="">Tous les types</option>
            <option value="pitch_deck" {% if type == 'pitch_deck' %}selected{% endif %}>Pitch Deck</option>
            <option value="business_plan" {% if type == 'business_plan' %}selected{% endif %}>Business Plan</option>
            <option value="statuts" {% if type == 'statuts' %}selected{% endif %}>Statuts</option>
            <option value="contrat" {% if type == 'contrat' %}selected{% endif %}>Contrat</option>
        </select>

        <select name="entreprise" class="px-6 py-4 bg-surface-container-lowest border border-outline-variant/20 rounded-xl text-sm focus:ring-2 focus:ring-primary/40 transition-all">
            <option value="">Toutes les PMEs</option>
            {% for ent in entreprises %}
                <option value="{{ ent.id }}" {% if entrepriseId == ent.id %}selected{% endif %}>{{ ent.nom }}</option>
            {% endfor %}
        </select>

        <button type="submit" class="p-4 bg-primary text-white rounded-xl hover:bg-primary-container transition-all">
            <span class="material-symbols-outlined">search</span>
        </button>
        {% if search or type or entrepriseId %}
            <a href="{{ path('app_document_index') }}" class="p-4 bg-surface-container-high text-secondary rounded-xl hover:bg-slate-200 transition-all">
                <span class="material-symbols-outlined">close</span>
            </a>
        {% endif %}
    </form>

    <a href="{{ path('app_document_new') }}" class="flex items-center gap-2 px-6 py-4 bg-primary text-white font-black rounded-xl shadow-xl shadow-primary/20 hover:bg-primary-container transition-all active:scale-95 whitespace-nowrap">
        <span class="material-symbols-outlined">upload_file</span>
        Uploader
    </a>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {% for document in documents %}
        <div class="bg-surface-container-lowest rounded-3xl p-8 shadow-sm hover:shadow-md transition-shadow group border border-outline-variant/10">
            <div class="flex justify-between items-start mb-6">
                <div class="w-12 h-12 rounded-2xl bg-tertiary/10 flex items-center justify-center text-tertiary">
                    <span class="material-symbols-outlined">
                        {% if document.type == 'pitch_deck' %}presentation_chart
                        {% elseif document.type == 'business_plan' %}description
                        {% elseif document.type == 'statuts' %}gavel
                        {% elseif document.type == 'contrat' %}contract
                        {% else %}article{% endif %}
                    </span>
                </div>
                <div class="text-right">
                    <p class="text-[10px] font-bold text-outline uppercase tracking-widest mb-1">{{ document.entreprise.nom }}</p>
                    <span class="text-[10px] font-bold uppercase tracking-widest px-2 py-1 rounded-full 
                        {% if document.statut == 'valide' %}bg-green-100 text-green-700
                        {% elseif document.statut == 'refuse' %}bg-red-100 text-red-700
                        {% else %}bg-amber-100 text-amber-700{% endif %}">
                        {{ document.statut|replace({'_': ' '})|capitalize }}
                    </span>
                </div>
            </div>
            
            <h3 class="text-lg font-black text-on-surface mb-1 truncate">{{ document.nom }}</h3>
            <p class="text-xs font-bold text-primary uppercase tracking-widest mb-4">{{ document.type|replace({'_': ' '}) }}</p>
            
            <p class="text-secondary text-sm mb-6 line-clamp-2">{{ document.description|default('Aucune description.') }}</p>
            
            <div class="flex items-center gap-3 text-[10px] text-outline font-bold uppercase tracking-widest mb-8">
                <span class="material-symbols-outlined text-sm">calendar_today</span>
                {{ document.dateUpload|date('d/m/Y H:i') }}
            </div>
            
            <div class="flex gap-3">
                {% if document.cheminFichier %}
                    <a href="{{ asset('uploads/documents/' ~ document.cheminFichier) }}" target="_blank" class="flex-1 py-3 text-center bg-surface-container-high text-on-surface text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-slate-200 transition-all">
                        Voir le fichier
                    </a>
                {% endif %}
                <a href="{{ path('app_document_edit', {'id': document.id}) }}" class="p-3 bg-primary/5 text-primary rounded-xl hover:bg-primary/10 transition-all" title="Modifier">
                    <span class="material-symbols-outlined text-sm">edit</span>
                </a>
                <form method="post" action="{{ path('app_document_delete', {'id': document.id}) }}" onsubmit="return confirm('Confirmer la suppression ?');" class="inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ document.id) }}">
                    <button class="p-3 text-error bg-error/5 rounded-xl hover:bg-error/10 transition-all" title="Supprimer">
                        <span class="material-symbols-outlined text-sm">delete</span>
                    </button>
                </form>
            </div>
        </div>
    {% else %}
        <div class="col-span-full text-center py-20 bg-surface-container-lowest rounded-3xl border-2 border-dashed border-outline-variant/30">
            <span class="material-symbols-outlined text-6xl text-outline mb-4">folder_open</span>
            <p class="text-secondary font-medium">Aucun document trouvé.</p>
        </div>
    {% endfor %}
</div>
{% endblock %}
