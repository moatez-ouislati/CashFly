{% extends 'base.html.twig' %}

{% block title %}Indicateurs Économiques - CashFly{% endblock %}

{% block page_header %}
    <div class="flex justify-between items-center w-full">
        <div>
            <h2 class="text-2xl font-black text-on-surface">Indicateurs <span class="text-primary">Économiques</span></h2>
            <p class="text-sm text-on-surface-variant">Données économiques de la Banque Mondiale</p>
        </div>
        <div class="flex items-center gap-3 bg-white p-3 rounded-xl border border-outline-variant/20 shadow-sm">
            <span class="fi fi-tn rounded-sm shadow-sm" style="font-size: 24px;"></span>
            <div class="text-right">
                <p class="text-xs font-black text-on-surface uppercase">{{ countryInfo.name }}</p>
                <p class="text-[10px] text-on-surface-variant uppercase tracking-widest">{{ countryInfo.capital }}</p>
            </div>
        </div>
    </div>
{% endblock %}

{% block body %}
<div class="grid grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
    <div class="stat-card {% if latestIndicators.growth and latestIndicators.growth.value > 0 %}bg-tertiary/10 border-tertiary/20{% elseif latestIndicators.growth and latestIndicators.growth.value < 0 %}bg-error/10 border-error/20{% else %}bg-secondary/10 border-secondary/20{% endif %} items-center text-center">
        <span class="material-symbols-outlined text-4xl mb-2 {% if latestIndicators.growth and latestIndicators.growth.value > 0 %}text-tertiary{% elseif latestIndicators.growth and latestIndicators.growth.value < 0 %}text-error{% else %}text-secondary{% endif %}">
            {% if latestIndicators.growth and latestIndicators.growth.value > 0 %}trending_up{% elseif latestIndicators.growth and latestIndicators.growth.value < 0 %}trending_down{% else %}horizontal_rule{% endif %}
        </span>
        <h3 class="text-xl font-black {% if latestIndicators.growth and latestIndicators.growth.value > 0 %}text-tertiary{% elseif latestIndicators.growth and latestIndicators.growth.value < 0 %}text-error{% else %}text-secondary{% endif %}">
            {% if latestIndicators.growth %}{{ (latestIndicators.growth.value)|number_format(0) }}{% else %}N/A{% endif %}%
        </h3>
        <p class="text-[10px] text-on-surface-variant uppercase tracking-widest mt-1">Croissance PIB</p>
        {% if latestIndicators.growth %}
            <span class="badge {% if latestIndicators.growth.value > 0 %}badge-success{% else %}badge-error{% endif %} mt-2">
                {{ latestIndicators.growth.year }}
            </span>
        {% endif %}
    </div>

    <div class="stat-card bg-error/10 border-error/20 items-center text-center">
        <span class="material-symbols-outlined text-4xl text-error mb-2">percent</span>
        <h3 class="text-xl font-black text-error">
            {% if latestIndicators.inflation %}{{ (latestIndicators.inflation.value)|number_format(0) }}{% else %}N/A{% endif %}%
        </h3>
        <p class="text-[10px] text-on-surface-variant uppercase tracking-widest mt-1">Inflation</p>
        {% if latestIndicators.inflation %}
            <span class="badge badge-error mt-2">{{ latestIndicators.inflation.year }}</span>
        {% endif %}
    </div>

    <div class="stat-card bg-primary/10 border-primary/20 items-center text-center">
        <span class="material-symbols-outlined text-4xl text-primary mb-2">payments</span>
        <h3 class="text-xl font-black text-primary">
            {% if latestIndicators.gdpPerCapita %}{{ (latestIndicators.gdpPerCapita.valueTnd)|number_format(0, ',', ' ') }}{% else %}N/A{% endif %}
        </h3>
        <p class="text-[10px] text-on-surface-variant uppercase tracking-widest mt-1">PIB / hab (TND)</p>
        {% if latestIndicators.gdpPerCapita %}
            <span class="badge badge-primary mt-2">{{ latestIndicators.gdpPerCapita.year }}</span>
        {% endif %}
    </div>

    <div class="stat-card bg-warning/10 border-warning/20 items-center text-center">
        <span class="material-symbols-outlined text-4xl text-warning mb-2">person_search</span>
        <h3 class="text-xl font-black text-warning">
            {% if latestIndicators.unemployment %}{{ (latestIndicators.unemployment.value)|number_format(0) }}{% else %}N/A{% endif %}%
        </h3>
        <p class="text-[10px] text-on-surface-variant uppercase tracking-widest mt-1">Chômage</p>
        {% if latestIndicators.unemployment %}
            <span class="badge badge-warning mt-2">{{ latestIndicators.unemployment.year }}</span>
        {% endif %}
    </div>
</div>

<div class="table-wrapper mb-10">
    <table class="w-full text-left">
        <thead>
            <tr class="bg-surface-container-low">
                <th>Année</th>
                <th>Croissance PIB (%)</th>
                <th>Inflation (%)</th>
                <th>PIB/hab (TND)</th>
                <th>Chômage (%)</th>
            </tr>
        </thead>
        <tbody>
            {% set maxRows = min(allIndicators.growth|length, 10) %}
            {% for i in 0..maxRows-1 %}
            <tr>
                <td><span class="badge badge-primary">{{ allIndicators.growth[i].year|default('N/A') }}</span></td>
                <td>
                    {% if allIndicators.growth[i] %}
                        <span class="badge {% if allIndicators.growth[i].value > 0 %}badge-success{% else %}badge-error{% endif %}">
                            {{ allIndicators.growth[i].value > 0 ? '+' : '' }}{{ allIndicators.growth[i].value|number_format(0) }}%
                        </span>
                    {% else %}N/A{% endif %}
                </td>
                <td>
                    {% if allIndicators.inflation[i] %}
                        <span class="badge badge-error">{{ allIndicators.inflation[i].value|number_format(0) }}%</span>
                    {% else %}N/A{% endif %}
                </td>
                <td class="font-bold text-on-surface">
                    {% if allIndicators.gdpPerCapita[i] %}
                        {{ allIndicators.gdpPerCapita[i].valueTnd|number_format(0, ',', ' ') }} TND
                    {% else %}N/A{% endif %}
                </td>
                <td>
                    {% if allIndicators.unemployment[i] %}
                        <span class="badge badge-warning">{{ allIndicators.unemployment[i].value|number_format(0) }}%</span>
                    {% else %}N/A{% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<div class="card">
    <h3 class="text-lg font-bold text-on-surface mb-6 flex items-center gap-2">
        <span class="material-symbols-outlined text-primary">info</span>
        Informations Pays
    </h3>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-4 rounded-xl bg-surface-container-low">
            <p class="text-[10px] text-on-surface-variant uppercase tracking-widest mb-1">Nom</p>
            <p class="font-bold text-on-surface">{{ countryInfo.name }}</p>
        </div>
        <div class="p-4 rounded-xl bg-surface-container-low">
            <p class="text-[10px] text-on-surface-variant uppercase tracking-widest mb-1">Capitale</p>
            <p class="font-bold text-on-surface">{{ countryInfo.capital }}</p>
        </div>
        <div class="p-4 rounded-xl bg-surface-container-low">
            <p class="text-[10px] text-on-surface-variant uppercase tracking-widest mb-1">Région</p>
            <p class="font-bold text-on-surface">{{ countryInfo.region }}</p>
        </div>
        <div class="p-4 rounded-xl bg-surface-container-low">
            <p class="text-[10px] text-on-surface-variant uppercase tracking-widest mb-1">Niveau de revenu</p>
            <p class="font-bold text-on-surface">{{ countryInfo.income }}</p>
        </div>
    </div>
</div>
{% endblock %}
