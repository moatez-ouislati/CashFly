{% extends 'base.html.twig' %}

{% block title %}Taux de Change - CashFly{% endblock %}

{% block page_header %}
    <h2 class="text-2xl font-black text-on-surface">Taux de <span class="text-primary">Change</span></h2>
    <p class="text-sm text-on-surface-variant">Cours du Dinar Tunisien (TND) - Mise à jour en temps réel</p>
{% endblock %}

{% block body %}
<div class="mb-8">
    <div class="stat-card w-48 bg-primary/10 border-primary/20">
        <h3 class="text-2xl font-black text-primary">1 TND</h3>
        <p class="text-[10px] text-on-surface-variant uppercase tracking-widest">Base de conversion</p>
    </div>
</div>

<div class="table-wrapper">
    <table class="w-full text-left">
        <thead>
            <tr class="bg-surface-container-low">
                <th>Devise</th>
                <th>Nom</th>
                <th class="text-right">Cours</th>
                <th class="text-right">Variation 24h</th>
                <th class="text-right">1 TND =</th>
            </tr>
        </thead>
        <tbody>
            {% for rate in rates %}
            <tr>
                <td>
                    <span class="px-3 py-1 bg-on-surface text-white rounded-lg font-bold text-xs">{{ rate.symbol }}</span>
                </td>
                <td class="font-medium">{{ rate.name }}</td>
                <td class="text-right font-black text-on-surface">
                    {{ rate.rate|number_format(4, '.', ',') }}
                </td>
                <td class="text-right">
                    <span class="badge {% if rate.change_24h >= 0 %}badge-success{% else %}badge-error{% endif %}">
                        <span class="material-symbols-outlined text-[12px] align-middle">
                            {% if rate.change_24h >= 0 %}arrow_upward{% else %}arrow_downward{% endif %}
                        </span>
                        {{ rate.change_24h >= 0 ? '+' : '' }}{{ rate.change_24h }}%
                    </span>
                </td>
                <td class="text-right text-on-surface-variant font-medium">
                    {{ (1 / rate.rate)|number_format(4, '.', ',') }} {{ rate.symbol }}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>

<div class="mt-10 p-4 rounded-xl bg-surface-container-low border border-outline-variant/20 flex items-start gap-3">
    <span class="material-symbols-outlined text-primary">info</span>
    <div class="text-sm text-on-surface-variant">
        Les taux de change sont fournis par <strong>Open Exchange Rates API</strong> et sont mis à jour en temps réel.
        Base: <strong>1 TND (Dinar Tunisien)</strong>
    </div>
</div>
{% endblock %}
