{% extends 'base.html.twig' %}

{% block title %}Modifier l'investissement{% endblock %}

{% block page_header %}
    <div class="flex items-center gap-3">
        <a href="{{ path('investisseur_investments') }}" class="text-primary hover:text-blue-700">
            <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <h1 class="text-3xl font-black text-on-surface">✏️ Modifier mon placement</h1>
    </div>
{% endblock %}

{% block body %}
<div class="max-w-2xl mx-auto">
    <div class="bg-white rounded-3xl p-10 shadow-sm border border-slate-200">
        <div class="mb-8 p-4 bg-amber-50 border border-amber-200 rounded-2xl flex items-start gap-3">
            <span class="material-symbols-outlined text-amber-600">info</span>
            <p class="text-sm text-amber-800">
                Vous modifiez votre proposition d'investissement pour <strong>{{ investissement.entreprise.nom }}</strong>.
            </p>
        </div>

        {{ form_start(form, {'attr': {'class': 'space-y-6'}}) }}
            <div class="space-y-1.5 opacity-60">
                {{ form_label(form.entreprise, null, {'label_attr': {'class': 'block text-xs font-bold text-secondary uppercase tracking-widest ml-1'}}) }}
                {{ form_widget(form.entreprise, {'attr': {'readonly': 'readonly'}}) }}
                {{ form_errors(form.entreprise) }}
            </div>

            <div class="grid grid-cols-2 gap-6">
                <div class="space-y-1.5">
                    {{ form_label(form.montant, null, {'label_attr': {'class': 'block text-xs font-bold text-secondary uppercase tracking-widest ml-1'}}) }}
                    {{ form_widget(form.montant) }}
                    {{ form_errors(form.montant) }}
                </div>
                <div class="space-y-1.5">
                    {{ form_label(form.tauxRendementPrevu, null, {'label_attr': {'class': 'block text-xs font-bold text-secondary uppercase tracking-widest ml-1'}}) }}
                    {{ form_widget(form.tauxRendementPrevu) }}
                    {{ form_errors(form.tauxRendementPrevu) }}
                </div>
            </div>

            <div class="space-y-1.5">
                {{ form_label(form.dureeMois, null, {'label_attr': {'class': 'block text-xs font-bold text-secondary uppercase tracking-widest ml-1'}}) }}
                {{ form_widget(form.dureeMois) }}
                {{ form_errors(form.dureeMois) }}
            </div>

            <div class="space-y-1.5">
                {{ form_label(form.description, null, {'label_attr': {'class': 'block text-xs font-bold text-secondary uppercase tracking-widest ml-1'}}) }}
                {{ form_widget(form.description) }}
                {{ form_errors(form.description) }}
            </div>

            <div class="pt-6">
                <button type="submit" class="w-full bg-primary text-white py-4 rounded-2xl font-black text-lg hover:bg-primary-dark shadow-lg shadow-primary/20 transition-all">
                    Enregistrer les modifications
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
