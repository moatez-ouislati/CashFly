{% extends 'base.html.twig' %}

{% block title %}Connexion — CashFly{% endblock %}

{% block body %}
<div class="login-page" style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background: radial-gradient(circle at top right, #0d1b2a, #04090f); padding: 20px; font-family: 'Inter', sans-serif;">
    <div class="login-container" style="width: 100%; max-width: 440px; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.08); backdrop-filter: blur(20px); border-radius: 24px; padding: 40px; box-shadow: 0 20px 40px rgba(0,0,0,0.4);">
        
        <div class="login-header" style="text-align: center; margin-bottom: 40px;">
            <img src="{{ path('cashfly_logo') }}" alt="CashFly Logo" style="height: 64px; width: auto; margin-bottom: 20px;">
            <h1 style="color: #fff; font-size: 28px; font-weight: 700; letter-spacing: -0.5px; margin-bottom: 8px;">CASHFLY</h1>
            <p style="color: #a1a1aa; font-size: 14px; font-weight: 400;">HYPER-SPEED ASSET MANAGEMENT</p>
        </div>

        <form method="post">
            {% if error %}
                <div class="alert-error" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); color: #ef4444; padding: 12px 16px; border-radius: 12px; margin-bottom: 24px; font-size: 14px; display: flex; align-items: center; gap: 10px;">
                    <i class="ph ph-warning-circle"></i>
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <div class="form-group" style="margin-bottom: 24px;">
                <label for="username" style="display: block; color: #a1a1aa; font-size: 13px; font-weight: 500; margin-bottom: 8px; margin-left: 4px;">Email</label>
                <div style="position: relative; display: flex; align-items: center;">
                    <i class="ph ph-envelope" style="position: absolute; left: 16px; color: #71717a; font-size: 20px;"></i>
                    <input type="text" value="{{ last_username }}" name="_username" id="username" class="form-control" autocomplete="email" required autofocus 
                           placeholder="votre@email.com"
                           style="width: 100%; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 14px 16px 14px 48px; color: #fff; font-size: 15px; outline: none; transition: border-color 0.2s, box-shadow 0.2s;">
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 32px;">
                <label for="password" style="display: block; color: #a1a1aa; font-size: 13px; font-weight: 500; margin-bottom: 8px; margin-left: 4px;">Mot de passe</label>
                <div style="position: relative; display: flex; align-items: center;">
                    <i class="ph ph-lock" style="position: absolute; left: 16px; color: #71717a; font-size: 20px;"></i>
                    <input type="password" name="_password" id="password" class="form-control" autocomplete="current-password" required
                           placeholder="••••••••"
                           style="width: 100%; background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); border-radius: 12px; padding: 14px 16px 14px 48px; color: #fff; font-size: 15px; outline: none; transition: border-color 0.2s, box-shadow 0.2s;">
                </div>
            </div>

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button class="btn-login" type="submit" 
                    style="width: 100%; background: linear-gradient(90deg, #00C16A, #00dbde); border: none; border-radius: 12px; padding: 16px; color: #04090f; font-size: 16px; font-weight: 700; cursor: pointer; transition: transform 0.2s, opacity 0.2s; box-shadow: 0 4px 12px rgba(0, 193, 106, 0.3);">
                SE CONNECTER
            </button>
        </form>

        <div style="margin-top: 32px; text-align: center;">
            <p style="color: #71717a; font-size: 13px;">Accès réservé - Equipe CashFly & Partenaires</p>
        </div>
    </div>
</div>

<style>
    .form-control:focus {
        border-color: #00C16A !important;
        box-shadow: 0 0 0 4px rgba(0, 193, 106, 0.1) !important;
    }
    .btn-login:hover {
        opacity: 0.9;
        transform: translateY(-1px);
    }
    .btn-login:active {
        transform: translateY(0);
    }
</style>
{% endblock %}
