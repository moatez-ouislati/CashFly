{% extends 'base.html.twig' %}

{% block title %}Gestion des Investissements — Admin{% endblock %}

{% block page_header %}
    <h1 class="text-3xl font-black text-on-surface">💎 Tous les Investissements</h1>
    <p class="text-on-surface-variant">Supervision globale des flux financiers de la plateforme</p>
{% endblock %}

{% block body %}
<div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-200">
    <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead>
                <tr class="border-b border-slate-100">
                    <th class="px-4 py-3 text-xs font-bold text-slate-500 uppercase">Investisseur</th>
                    <th class="px-4 py-3 text-xs font-bold text-slate-500 uppercase">Entreprise</th>
                    <th class="px-4 py-3 text-xs font-bold text-slate-500 uppercase">Date</th>
                    <th class="px-4 py-3 text-xs font-bold text-slate-500 uppercase">Montant</th>
                    <th class="px-4 py-3 text-xs font-bold text-slate-500 uppercase">Statut</th>
                    <th class="px-4 py-3 text-xs font-bold text-slate-500 uppercase text-right">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for inv in investissements %}
                    <tr class="border-b border-slate-50 hover:bg-slate-50 transition-colors">
                        <td class="px-4 py-4">
                            <div class="font-bold text-on-surface">{{ inv.investisseur.fullName }}</div>
                            <div class="text-[10px] text-slate-400">{{ inv.investisseur.email }}</div>
                        </td>
                        <td class="px-4 py-4 font-medium">{{ inv.entreprise.nom }}</td>
                        <td class="px-4 py-4 text-slate-500">{{ inv.dateInvestissement|date('d/m/Y H:i') }}</td>
                        <td class="px-4 py-4 font-black text-primary">{{ inv.montant|number_format(2, '.', ' ') }} TND</td>
                        <td class="px-4 py-4">
                            {% if inv.statut == 'ACTIF' %}
                                <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-xs font-bold">ACTIF</span>
                            {% elseif inv.statut == 'EN_ATTENTE' %}
                                <span class="bg-orange-100 text-orange-700 px-3 py-1 rounded-full text-xs font-bold">EN ATTENTE</span>
                            {% else %}
                                <span class="bg-slate-100 text-slate-700 px-3 py-1 rounded-full text-xs font-bold">{{ inv.statut }}</span>
                            {% endif %}
                        </td>
                        <td class="px-4 py-4 text-right">
                            <a href="{{ path('investisseur_investment_pdf', {id: inv.id}) }}" class="inline-flex items-center gap-1 text-primary hover:text-primary-dark font-bold text-xs">
                                <span class="material-symbols-outlined text-sm">download</span>
                                Télécharger Reçu
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="6" class="px-4 py-10 text-center text-slate-400 italic">
                            Aucun investissement enregistré sur la plateforme.
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
