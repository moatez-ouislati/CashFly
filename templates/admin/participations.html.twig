{% extends 'admin/base.html.twig' %}

{% block title %}Admin | Participations JPO{% endblock %}
{% block header_title %}Inscriptions JPO{% endblock %}
{% block header_subtitle %}Liste des participants inscrits aux événements.{% endblock %}

{% block body %}
<div class="bg-admin-card rounded-3xl border border-white/5 overflow-hidden">
    <table class="w-full text-left border-collapse">
        <thead>
            <tr class="bg-white/5 text-[10px] font-black uppercase tracking-widest text-slate-500">
                <th class="px-6 py-4">Utilisateur</th>
                <th class="px-6 py-4">Événement</th>
                <th class="px-6 py-4">Rôle</th>
                <th class="px-6 py-4">Statut</th>
                <th class="px-6 py-4">Date Inscription</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-white/5">
            {% for p in participations %}
                <tr class="hover:bg-white/[0.02] transition-colors">
                    <td class="px-6 py-4">
                        <p class="font-bold text-sm">{{ p.utilisateur.prenom }} {{ p.utilisateur.nom }}</p>
                        <p class="text-[10px] text-slate-500 uppercase tracking-widest font-bold">{{ p.utilisateur.dbRole }}</p>
                    </td>
                    <td class="px-6 py-4 font-bold text-sm text-slate-300">{{ p.evenement.titre }}</td>
                    <td class="px-6 py-4 font-bold text-sm text-admin-primary tracking-widest">{{ p.role }}</td>
                    <td class="px-6 py-4">
                        <span class="px-2 py-1 bg-white/5 text-[8px] font-black rounded uppercase border border-white/10">{{ p.statut }}</span>
                    </td>
                    <td class="px-6 py-4 text-xs text-slate-500 font-bold uppercase">{{ p.dateInscription|date('d/m/Y H:i') }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
