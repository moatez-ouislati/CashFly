{% extends 'base.html.twig' %}

{% block title %}Admin - Trésoreries | CashFly{% endblock %}

{% block header_title %}Administration des Trésoreries{% endblock %}
{% block header_subtitle %}Vue globale de tous les comptes de trésorerie sur la plateforme.{% endblock %}

{% block body %}
<div class="mb-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
    <form method="get" action="{{ path('admin_tresoreries_index') }}" class="flex flex-wrap gap-2 w-full md:w-auto">
        <div class="relative w-full md:w-80">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline">search</span>
            <input type="text" name="search" value="{{ search|default('') }}" placeholder="Rechercher un compte, entreprise..." class="w-full bg-surface-container-lowest border-none rounded-xl py-3 pl-10 pr-4 text-sm font-bold focus:ring-2 focus:ring-primary/30">
        </div>
        
        <select name="type_compte" onchange="this.form.submit()" class="bg-surface-container-lowest border-none rounded-xl py-3 px-4 text-sm font-bold focus:ring-2 focus:ring-primary/30">
            <option value="">Tous les types</option>
            <option value="courant" {% if app.request.query.get('type_compte') == 'courant' %}selected{% endif %}>Courant</option>
            <option value="epargne" {% if app.request.query.get('type_compte') == 'epargne' %}selected{% endif %}>Épargne</option>
            <option value="devise" {% if app.request.query.get('type_compte') == 'devise' %}selected{% endif %}>Devise</option>
        </select>

        <button type="submit" class="px-4 py-3 bg-primary text-white rounded-xl hover:bg-primary-container transition-all">
            <span class="material-symbols-outlined">search</span>
        </button>
        {% if search or app.request.query.get('type_compte') %}
            <a href="{{ path('admin_tresoreries_index') }}" class="px-4 py-3 bg-surface-container-high text-on-surface rounded-xl hover:bg-slate-200 transition-all flex items-center justify-center">
                <span class="material-symbols-outlined">close</span>
            </a>
        {% endif %}
    </form>

    <a href="{{ path('admin_export_tresoreries', app.request.query.all) }}" class="flex items-center gap-2 px-6 py-3 bg-tertiary text-white font-black rounded-xl shadow-xl shadow-tertiary/20 hover:bg-tertiary/90 transition-all active:scale-95 whitespace-nowrap">
        <span class="material-symbols-outlined">download</span>
        Exporter Excel
    </a>
</div>

{# Stats Cards #}
<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div class="bg-surface-container-lowest rounded-2xl p-6 border border-outline-variant/10">
        <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center">
                <span class="material-symbols-outlined text-primary">account_balance</span>
            </div>
            <p class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant">Total Comptes</p>
        </div>
        <p class="text-2xl font-black text-on-surface">{{ tresoreries|length }}</p>
    </div>
    
    <div class="col-span-2 bg-surface-container-lowest rounded-2xl p-6 border border-outline-variant/10">
        <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-xl bg-tertiary/10 flex items-center justify-center">
                <span class="material-symbols-outlined text-tertiary">payments</span>
            </div>
            <p class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant">Solde Total Consolidé</p>
        </div>
        <p class="text-2xl font-black text-tertiary">{{ total_solde|number_format(2, ',', ' ') }} TND</p>
    </div>
    
    <div class="bg-surface-container-lowest rounded-2xl p-6 border border-outline-variant/10">
        <div class="flex items-center gap-3 mb-3">
            <div class="w-10 h-10 rounded-xl bg-green-100 flex items-center justify-center">
                <span class="material-symbols-outlined text-green-600">trending_up</span>
            </div>
            <p class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant">Moyenne/Compte</p>
        </div>
        <p class="text-2xl font-black text-green-600">
            {% if tresoreries|length > 0 %}
                {{ (total_solde / tresoreries|length)|number_format(2, ',', ' ') }} TND
            {% else %}
                0,00 TND
            {% endif %}
        </p>
    </div>
</div>

<div class="bg-surface-container-lowest rounded-3xl p-8 shadow-sm border border-outline-variant/10">
    <div class="flex justify-between items-center mb-8">
        <h3 class="text-sm font-black uppercase tracking-widest text-on-surface">Tous les Comptes de Trésorerie</h3>
        <span class="text-xs font-bold text-secondary">{{ tresoreries|length }} compte(s)</span>
    </div>
    
    <div class="overflow-x-auto">
        <table class="w-full text-left">
            <thead>
                <tr class="text-[10px] font-black uppercase tracking-widest text-outline border-b border-outline-variant/10">
                    <th class="px-4 py-4">Compte</th>
                    <th class="px-4 py-4">Entreprise</th>
                    <th class="px-4 py-4">Propriétaire</th>
                    <th class="px-4 py-4">Solde</th>
                    <th class="px-4 py-4">Revenus (30j)</th>
                    <th class="px-4 py-4">Dépenses (30j)</th>
                    <th class="px-4 py-4">Dernière Maj</th>
                    <th class="px-4 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-outline-variant/5">
                {% for item in tresoreries %}
                    {% set tresorerie = item.tresorerie %}
                    <tr class="group hover:bg-surface-container-low transition-colors">
                        <td class="px-4 py-5">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center">
                                    <span class="material-symbols-outlined text-primary text-lg">account_balance</span>
                                </div>
                                <div>
                                    <span class="font-bold text-sm text-on-surface">{{ item.tresorerie.nomCompte }}</span>
                                    <p class="text-xs text-secondary">{{ item.tresorerie.numeroCompte }}</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-4 py-5">
                            <span class="text-sm font-bold text-on-surface">{{ tresorerie.entreprise.nom }}</span>
                        </td>
                        <td class="px-4 py-5">
                            <span class="text-sm text-secondary">{{ tresorerie.entreprise.proprietaire.fullName }}</span>
                        </td>
                        <td class="px-4 py-5">
                            <span class="font-black text-sm {% if tresorerie.solde|number_format(2) >= 0 %}text-tertiary{% else %}text-error{% endif %}">
                                {{ tresorerie.solde|number_format(2, ',', ' ') }} {{ tresorerie.devise }}
                            </span>
                        </td>
                        <td class="px-4 py-5">
                            <span class="font-bold text-sm text-green-600">+{{ item.revenus_30j|number_format(2, ',', ' ') }}</span>
                        </td>
                        <td class="px-4 py-5">
                            <span class="font-bold text-sm text-red-600">-{{ item.depenses_30j|number_format(2, ',', ' ') }}</span>
                        </td>
                        <td class="px-4 py-5">
                            <span class="text-xs text-secondary">{{ item.tresorerie.derniereMaj ? item.tresorerie.derniereMaj|date('d M Y') : 'Jamais' }}</span>
                        </td>
                        <td class="px-4 py-5 text-right flex items-center justify-end gap-2">
                            <a href="{{ path('app_tresorerie_show', {'id': tresorerie.id}) }}" class="p-2 bg-surface-container-high rounded-lg text-secondary hover:text-primary hover:bg-primary/5 transition-all" title="Voir les détails">
                                <span class="material-symbols-outlined text-lg">visibility</span>
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="px-4 py-20 text-center">
                            <span class="material-symbols-outlined text-6xl text-outline mb-4">account_balance</span>
                            <p class="text-secondary font-medium">Aucun compte trouvé.</p>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
