{% extends 'admin/base.html.twig' %}

{% block title %}Trésoreries | Admin | CashFly{% endblock %}

{% block header_title %}Comptes de Trésorerie{% endblock %}
{% block header_subtitle %}Surveillance globale des actifs et comptes bancaires.{% endblock %}

{% block body %}
<section class="admin-glass rounded-[2rem] border border-white/5 overflow-hidden">
    <div class="px-8 py-6 flex justify-between items-center border-b border-white/5 bg-white/[0.02]">
        <h3 class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500">Liste des Comptes</h3>
        <a href="{{ path('app_admin_export_tresoreries') }}" class="flex items-center gap-2 bg-admin-primary/10 text-admin-primary px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest border border-admin-primary/20 hover:bg-admin-primary/20 transition-all">
            <span class="material-symbols-outlined text-sm">download</span>
            Exporter CSV
        </a>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-white/[0.01]">
                    <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-slate-500">Compte</th>
                    <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-slate-500">Type</th>
                    <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-slate-500">Solde Actuel</th>
                    <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-slate-500">Entreprise</th>
                    <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-slate-500">Propriétaire</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.03]">
                {% for tresorerie in tresoreries %}
                    <tr class="hover:bg-white/[0.02] transition-colors group">
                        <td class="px-8 py-5">
                            <div class="flex items-center gap-4">
                                <div class="w-10 h-10 rounded-2xl bg-amber-500/10 flex items-center justify-center text-amber-400 font-black border border-amber-500/20 group-hover:scale-110 transition-transform">
                                    <span class="material-symbols-outlined text-lg">account_balance</span>
                                </div>
                                <div>
                                    <p class="text-sm font-bold text-white group-hover:text-admin-primary transition-colors">{{ tresorerie.nomCompte }}</p>
                                    <p class="text-[10px] text-slate-500">{{ tresorerie.numeroCompte }}</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-8 py-5">
                            <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">{{ tresorerie.typeCompte }}</span>
                        </td>
                        <td class="px-8 py-5">
                            <span class="text-sm font-black text-white tracking-tight">{{ tresorerie.solde|number_format(2, ',', ' ') }} <span class="text-[10px] opacity-50">{{ tresorerie.devise }}</span></span>
                        </td>
                        <td class="px-8 py-5 text-xs font-bold text-slate-400">{{ tresorerie.entreprise.nom }}</td>
                        <td class="px-8 py-5">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-[10px] font-bold text-slate-400 border border-white/10">
                                    {{ tresorerie.entreprise.proprietaire.prenom|first }}{{ tresorerie.entreprise.proprietaire.nom|first }}
                                </div>
                                <div class="flex flex-col">
                                    <span class="text-xs font-bold text-white">{{ tresorerie.entreprise.proprietaire.prenom }} {{ tresorerie.entreprise.proprietaire.nom }}</span>
                                    <span class="text-[10px] text-slate-500">{{ tresorerie.entreprise.proprietaire.email }}</span>
                                </div>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="px-8 py-20 text-center">
                            <div class="flex flex-col items-center gap-4">
                                <span class="material-symbols-outlined text-5xl text-slate-700">account_balance_wallet</span>
                                <p class="text-slate-500 font-bold uppercase tracking-widest text-xs">Aucun compte de trésorerie</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</section>
{% endblock %}
