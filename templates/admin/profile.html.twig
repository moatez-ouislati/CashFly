{% extends 'adminDashboard.html.twig' %}
{% block title %}Mon Profil — Admin{% endblock %}

{% block body %}
<div class="page-header">
    <h1>Mon Profil</h1>
    <p>Mettez à jour vos informations personnelles</p>
</div>

<div class="profile-grid">
    {# Left: avatar card #}
    <div class="card profile-card-left">
        <div class="avatar avatar-lg">
            {% if app.user.faceImage %}
                <img src="{{ asset('uploads/faces/' ~ app.user.faceImage) }}" alt="Photo de profil">
            {% else %}
               {{ app.user.prenom|slice(0,1)|upper }}{{ app.user.nom|slice(0,1)|upper }}

            {% endif %}
        </div>
        <h3 style="font-family:'Syne',sans-serif;font-weight:700;margin-bottom:.25rem;">{{ app.user.fullName }}</h3>
        <span class="role-pill role-admin" style="margin-bottom:1rem;display:inline-block;">Admin</span>
        <p style="color:var(--muted);font-size:.85rem;margin-bottom:.4rem;">{{ app.user.email }}</p>
        <p style="color:var(--muted);font-size:.85rem;">CIN : {{ app.user.cin }}</p>
        <hr style="border:none;border-top:1px solid var(--border);margin:1.25rem 0;">
        <a href="{{ path('admin_dashboard') }}" class="btn btn-ghost" style="width:100%;justify-content:center;">← Dashboard</a>
    </div>

    {# Right: form #}
    <div class="card">
        <h2 style="font-family:'Syne',sans-serif;font-size:1.1rem;font-weight:700;margin-bottom:1.5rem;">Modifier mes informations</h2>

        {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'novalidate': 'novalidate'}}) }}

            <div class="form-row">
                <div class="form-group">
                    {{ form_label(form.nom, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.nom) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.prenom, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.prenom, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.prenom) }}
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    {{ form_label(form.cin, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.cin, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.cin) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.tel, null, {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.tel, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.tel) }}
                </div>
            </div>

            <div class="form-group">
                {{ form_label(form.faceImageFile, null, {'label_attr': {'class': 'form-label'}}) }}
                {{ form_widget(form.faceImageFile, {'attr': {'class': 'form-control'}}) }}
                {{ form_errors(form.faceImageFile) }}
            </div>

            <button type="submit" class="btn btn-primary" style="margin-top:.5rem;">Enregistrer les modifications</button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
