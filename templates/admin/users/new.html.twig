{% extends 'admin/base.html.twig' %}

{% block title %}Nouvel Utilisateur | CashFly Admin{% endblock %}

{% block header_title %}Création de Compte{% endblock %}
{% block header_subtitle %}Ajouter un nouvel utilisateur au système avec des permissions spécifiques.{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto">
    <div class="flex items-center gap-4 mb-10">
        <a href="{{ path('app_admin_users') }}" class="w-12 h-12 admin-glass rounded-2xl flex items-center justify-center text-slate-400 hover:text-admin-primary transition-all">
            <span class="material-symbols-outlined">arrow_back</span>
        </a>
        <h3 class="text-xl font-black text-white tracking-tight">Formulaire d'Inscription</h3>
    </div>

    <div class="admin-glass p-10 rounded-[2.5rem] border border-white/5 relative overflow-hidden">
        <div class="absolute top-0 right-0 p-8 opacity-5">
            <span class="material-symbols-outlined text-9xl">person_add</span>
        </div>

        {{ form_start(form) }}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 relative z-10">
                <div class="space-y-2">
                    {{ form_label(form.nom, null, {'label_attr': {'class': 'text-[10px] font-black uppercase tracking-widest text-slate-500 ml-1'}}) }}
                    {{ form_widget(form.nom) }}
                    {{ form_errors(form.nom, {'attr': {'class': 'text-error text-[10px] font-bold uppercase tracking-widest ml-1 mt-1'}}) }}
                </div>
                <div class="space-y-2">
                    {{ form_label(form.prenom, null, {'label_attr': {'class': 'text-[10px] font-black uppercase tracking-widest text-slate-500 ml-1'}}) }}
                    {{ form_widget(form.prenom) }}
                    {{ form_errors(form.prenom, {'attr': {'class': 'text-error text-[10px] font-bold uppercase tracking-widest ml-1 mt-1'}}) }}
                </div>
            </div>

            <div class="mt-8 space-y-2 relative z-10">
                {{ form_label(form.email, null, {'label_attr': {'class': 'text-[10px] font-black uppercase tracking-widest text-slate-500 ml-1'}}) }}
                {{ form_widget(form.email) }}
                {{ form_errors(form.email, {'attr': {'class': 'text-error text-[10px] font-bold uppercase tracking-widest ml-1 mt-1'}}) }}
            </div>

            <div class="mt-8 space-y-2 relative z-10">
                {{ form_label(form.password, null, {'label_attr': {'class': 'text-[10px] font-black uppercase tracking-widest text-slate-500 ml-1'}}) }}
                {{ form_widget(form.password) }}
                {{ form_errors(form.password, {'attr': {'class': 'text-error text-[10px] font-bold uppercase tracking-widest ml-1 mt-1'}}) }}
            </div>

            <div class="mt-8 space-y-2 relative z-10">
                {{ form_label(form.dbRole, null, {'label_attr': {'class': 'text-[10px] font-black uppercase tracking-widest text-slate-500 ml-1'}}) }}
                {{ form_widget(form.dbRole) }}
                {{ form_errors(form.dbRole, {'attr': {'class': 'text-error text-[10px] font-bold uppercase tracking-widest ml-1 mt-1'}}) }}
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8 relative z-10">
                <div class="space-y-2">
                    {{ form_label(form.tel, null, {'label_attr': {'class': 'text-[10px] font-black uppercase tracking-widest text-slate-500 ml-1'}}) }}
                    {{ form_widget(form.tel) }}
                    {{ form_errors(form.tel, {'attr': {'class': 'text-error text-[10px] font-bold uppercase tracking-widest ml-1 mt-1'}}) }}
                </div>
                <div class="space-y-2">
                    {{ form_label(form.cin, null, {'label_attr': {'class': 'text-[10px] font-black uppercase tracking-widest text-slate-500 ml-1'}}) }}
                    {{ form_widget(form.cin) }}
                    {{ form_errors(form.cin, {'attr': {'class': 'text-error text-[10px] font-bold uppercase tracking-widest ml-1 mt-1'}}) }}
                </div>
            </div>

            <div class="mt-10 flex items-center gap-4 p-6 bg-white/[0.02] rounded-2xl border border-white/5 relative z-10">
                {{ form_widget(form.active) }}
                <div>
                    {{ form_label(form.active, null, {'label_attr': {'class': 'text-xs font-bold text-white'}}) }}
                    <p class="text-[10px] text-slate-500 uppercase tracking-widest mt-0.5">Autoriser la connexion immédiate</p>
                </div>
            </div>

            <div class="mt-12 flex justify-end relative z-10">
                <button class="bg-admin-primary text-admin-bg px-10 py-4 rounded-2xl font-black text-[10px] uppercase tracking-[0.2em] hover:scale-105 transition-all flex items-center gap-3 shadow-xl shadow-admin-primary/20">
                    Finaliser la création
                    <span class="material-symbols-outlined text-sm">how_to_reg</span>
                </button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
