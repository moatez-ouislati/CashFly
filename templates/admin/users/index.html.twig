{% extends 'admin/base.html.twig' %}

{% block title %}Gestion des Utilisateurs | CashFly Admin{% endblock %}

{% block header_title %}Comptes Utilisateurs{% endblock %}
{% block header_subtitle %}Contrôle et administration des accès au système CashFly.{% endblock %}

{% block body %}
<section class="admin-glass rounded-[2rem] border border-white/5 overflow-hidden">
    <!-- Contrôles de la Table -->
    <div class="px-8 py-6 flex flex-col md:flex-row justify-between items-center gap-6 border-b border-white/5 bg-white/[0.02]">
        <form method="get" class="flex flex-wrap gap-4 w-full lg:w-auto">
            <div class="relative w-full md:w-80">
                <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-500">search</span>
                <input name="search" value="{{ search }}" class="w-full pl-12 pr-4 py-3 bg-white/5 border border-white/5 rounded-2xl focus:ring-2 focus:ring-admin-primary/30 font-medium text-xs text-white transition-all placeholder:text-slate-600" placeholder="Rechercher un utilisateur..." type="text"/>
            </div>
            
            <select name="role" class="px-6 py-3 bg-white/5 border border-white/5 rounded-2xl text-[10px] font-black uppercase tracking-widest text-slate-400 focus:ring-2 focus:ring-admin-primary/30 transition-all outline-none">
                <option value="">Tous les rôles</option>
                <option value="administrateur" {% if role == 'administrateur' %}selected{% endif %}>Administrateur</option>
                <option value="proprietaire" {% if role == 'proprietaire' %}selected{% endif %}>Propriétaire</option>
                <option value="investisseur" {% if role == 'investisseur' %}selected{% endif %}>Investisseur</option>
            </select>

            <button type="submit" class="p-3 bg-admin-primary text-admin-bg rounded-xl hover:scale-105 transition-all">
                <span class="material-symbols-outlined text-sm">search</span>
            </button>
            {% if search or role %}
                <a href="{{ path('app_admin_users') }}" class="p-3 bg-white/10 text-white rounded-xl hover:bg-white/20 transition-all">
                    <span class="material-symbols-outlined text-sm">close</span>
                </a>
            {% endif %}
        </form>
        <div class="flex gap-4 w-full md:w-auto">
            <a href="{{ path('app_admin_user_new') }}" class="flex-1 md:flex-none flex items-center justify-center gap-2 px-6 py-3 bg-admin-primary text-admin-bg rounded-2xl text-[10px] font-black uppercase tracking-widest shadow-lg shadow-admin-primary/20 hover:scale-105 transition-all active:scale-95">
                <span class="material-symbols-outlined text-sm">person_add</span>
                Nouvel Utilisateur
            </a>
        </div>
    </div>

    <!-- La Table -->
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-white/[0.01]">
                    <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-slate-500">Profil</th>
                    <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-slate-500">Rôle</th>
                    <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-slate-500">Contact</th>
                    <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-slate-500">Statut</th>
                    <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-slate-500 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.03]">
                {% for user in users %}
                    <tr class="hover:bg-white/[0.02] transition-colors group">
                        <td class="px-8 py-5">
                            <div class="flex items-center gap-4">
                                <div class="w-10 h-10 rounded-2xl bg-admin-primary/10 flex items-center justify-center text-admin-primary font-black border border-admin-primary/20 group-hover:scale-110 transition-transform">
                                    {{ user.prenom|first }}{{ user.nom|first }}
                                </div>
                                <div>
                                    <p class="font-bold text-white group-hover:text-admin-primary transition-colors">{{ user.prenom }} {{ user.nom }}</p>
                                    <p class="text-[10px] text-slate-500">ID: CF-{{ user.id }}</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-8 py-5">
                            <span class="inline-flex items-center px-3 py-1 rounded-lg text-[10px] font-black uppercase tracking-widest border
                                {% if user.dbRole == 'administrateur' %}bg-purple-500/10 text-purple-400 border-purple-500/20
                                {% elseif user.dbRole == 'proprietaire' %}bg-blue-500/10 text-blue-400 border-blue-500/20
                                {% else %}bg-green-500/10 text-green-400 border-green-500/20{% endif %}">
                                {{ user.dbRole|capitalize }}
                            </span>
                        </td>
                        <td class="px-8 py-5 text-xs font-bold text-slate-400">{{ user.email }}</td>
                        <td class="px-8 py-5">
                            {% if user.active %}
                                <span class="flex items-center gap-2 text-[10px] font-black text-green-400 uppercase tracking-widest">
                                    <span class="w-2 h-2 rounded-full bg-green-400 shadow-[0_0_8px_rgba(74,222,128,0.5)]"></span>
                                    Actif
                                </span>
                            {% else %}
                                <span class="flex items-center gap-2 text-[10px] font-black text-red-400 uppercase tracking-widest">
                                    <span class="w-2 h-2 rounded-full bg-red-400 shadow-[0_0_8px_rgba(248,113,113,0.5)]"></span>
                                    Inactif
                                </span>
                            {% endif %}
                        </td>
                        <td class="px-8 py-5 text-right">
                            <div class="flex justify-end gap-2 opacity-40 group-hover:opacity-100 transition-opacity">
                                <a href="{{ path('app_admin_user_edit', {'id': user.id}) }}" class="p-2 bg-white/5 hover:bg-admin-primary/20 rounded-xl text-admin-primary transition-all" title="Modifier">
                                    <span class="material-symbols-outlined text-lg">edit</span>
                                </a>
                                <form method="post" action="{{ path('app_admin_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Êtes-vous sûr ?');" class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                    <button class="p-2 bg-white/5 hover:bg-red-500/20 rounded-xl text-red-400 transition-all" title="Supprimer">
                                        <span class="material-symbols-outlined text-lg">delete</span>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="px-8 py-20 text-center">
                            <div class="flex flex-col items-center gap-4">
                                <span class="material-symbols-outlined text-5xl text-slate-700">group_off</span>
                                <p class="text-slate-500 font-bold uppercase tracking-widest text-xs">Aucun utilisateur trouvé</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</section>
{% endblock %}
