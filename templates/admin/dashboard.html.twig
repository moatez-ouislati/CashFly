{% extends 'admin/base.html.twig' %}

{% block title %}Admin | Statistiques Globales{% endblock %}

{% block header_title %}Dashboard Administrateur{% endblock %}
{% block header_subtitle %}Aperçu complet de l'écosystème CashFly.{% endblock %}

{% block body %}
<!-- Top Stats Grid -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <div class="p-6 bg-white rounded-2xl border border-slate-100 shadow-sm">
        <div class="flex items-center gap-4 mb-2">
            <div class="w-10 h-10 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center">
                <span class="material-symbols-outlined">group</span>
            </div>
            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Utilisateurs</p>
        </div>
        <h3 class="text-2xl font-black text-slate-900">{{ users_count }}</h3>
        <p class="text-[10px] text-slate-400 mt-1 font-bold uppercase tracking-tighter">Total inscrits</p>
    </div>

    <div class="p-6 bg-white rounded-2xl border border-slate-100 shadow-sm">
        <div class="flex items-center gap-4 mb-2">
            <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
                <span class="material-symbols-outlined">corporate_fare</span>
            </div>
            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Entreprises</p>
        </div>
        <h3 class="text-2xl font-black text-slate-900">{{ entreprises_count }}</h3>
        <p class="text-[10px] text-slate-400 mt-1 font-bold uppercase tracking-tighter">PME actives</p>
    </div>

    <div class="p-6 bg-white rounded-2xl border border-slate-100 shadow-sm">
        <div class="flex items-center gap-4 mb-2">
            <div class="w-10 h-10 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center">
                <span class="material-symbols-outlined">account_balance_wallet</span>
            </div>
            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Comptes</p>
        </div>
        <h3 class="text-2xl font-black text-slate-900">{{ tresoreries_count }}</h3>
        <p class="text-[10px] text-slate-400 mt-1 font-bold uppercase tracking-tighter">Comptes de trésorerie</p>
    </div>

    <div class="p-6 bg-white rounded-2xl border border-slate-100 shadow-sm">
        <div class="flex items-center gap-4 mb-2">
            <div class="w-10 h-10 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center">
                <span class="material-symbols-outlined">receipt_long</span>
            </div>
            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Opérations</p>
        </div>
        <h3 class="text-2xl font-black text-slate-900">{{ operations_count }}</h3>
        <p class="text-[10px] text-slate-400 mt-1 font-bold uppercase tracking-tighter">Transactions totales</p>
    </div>
</div>

<!-- Financial Stats -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    <div class="lg:col-span-2 bg-slate-900 rounded-3xl p-8 text-white relative overflow-hidden shadow-2xl">
        <div class="relative z-10">
            <p class="text-xs font-black text-slate-400 uppercase tracking-widest mb-2">Volume financier global</p>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-6">
                <div>
                    <p class="text-[10px] font-bold text-emerald-400 uppercase mb-1">Total Revenus</p>
                    <h4 class="text-3xl font-black">{{ total_revenue|number_format(2, ',', ' ') }} <span class="text-sm font-normal text-slate-400">TND</span></h4>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-rose-400 uppercase mb-1">Total Dépenses</p>
                    <h4 class="text-3xl font-black">{{ total_expenses|number_format(2, ',', ' ') }} <span class="text-sm font-normal text-slate-400">TND</span></h4>
                </div>
                <div>
                    <p class="text-[10px] font-bold text-blue-400 uppercase mb-1">Investissements Actifs</p>
                    <h4 class="text-3xl font-black">{{ total_invested|number_format(2, ',', ' ') }} <span class="text-sm font-normal text-slate-400">TND</span></h4>
                </div>
            </div>
        </div>
        <!-- Decorative bg -->
        <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-primary/20 blur-[100px] rounded-full"></div>
    </div>

    <div class="bg-white rounded-3xl p-8 border border-slate-100 shadow-sm">
        <p class="text-xs font-black text-slate-400 uppercase tracking-widest mb-6">Événementiel JPO</p>
        <div class="space-y-6">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-amber-500">event</span>
                    <span class="text-sm font-bold text-slate-600 uppercase">Événements</span>
                </div>
                <span class="text-xl font-black text-slate-900">{{ jpos_count }}</span>
            </div>
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <span class="material-symbols-outlined text-amber-500">group_add</span>
                    <span class="text-sm font-bold text-slate-600 uppercase">Participations</span>
                </div>
                <span class="text-xl font-black text-slate-900">{{ participations_count }}</span>
            </div>
            <div class="pt-4 border-t border-slate-50">
                <p class="text-[10px] text-slate-400 font-bold text-center uppercase">Engagement communautaire</p>
            </div>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
    <!-- Recent Users -->
    <div class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-slate-50 flex justify-between items-center">
            <h4 class="font-black text-slate-900 uppercase tracking-tight">Nouveaux Inscrits</h4>
            <a href="{{ path('app_admin_users') }}" class="text-[10px] font-bold text-primary uppercase hover:underline">Voir tout</a>
        </div>
        <div class="p-6 grid grid-cols-1 gap-4">
            {% for user in recent_users %}
                <div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl hover:bg-slate-100 transition-colors">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-full bg-white flex items-center justify-center text-slate-600 shadow-sm text-sm font-black">
                            {{ user.nom|first }}{{ user.prenom|first }}
                        </div>
                        <div>
                            <p class="font-bold text-xs">{{ user.prenom }} {{ user.nom }}</p>
                            <p class="text-[10px] text-slate-400 font-bold uppercase">{{ user.dbRole }}</p>
                        </div>
                    </div>
                    <span class="px-2 py-1 bg-white text-[8px] font-black text-slate-500 rounded uppercase border border-slate-100">
                        {{ user.dateCreation|date('d/m/Y') }}
                    </span>
                </div>
            {% endfor %}
        </div>
    </div>

    <!-- Recent Investments -->
    <div class="bg-white rounded-3xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-slate-50 flex justify-between items-center">
            <h4 class="font-black text-slate-900 uppercase tracking-tight">Derniers Investissements</h4>
            <span class="px-2 py-1 bg-primary/10 text-primary text-[8px] font-black rounded uppercase">{{ investments_count }} au total</span>
        </div>
        <div class="p-6 grid grid-cols-1 gap-4">
            {% for inv in recent_investments %}
                <div class="flex items-center justify-between p-3 bg-slate-50 rounded-xl hover:bg-slate-100 transition-colors">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-lg bg-white flex items-center justify-center text-slate-600 shadow-sm">
                            <span class="material-symbols-outlined text-sm">trending_up</span>
                        </div>
                        <div>
                            <p class="font-bold text-xs">{{ inv.investisseur.prenom }} → {{ inv.entreprise.nom }}</p>
                            <p class="text-[10px] text-slate-400 font-bold uppercase tracking-tighter">{{ inv.statut }} • {{ inv.tauxRendementPrevu }}%</p>
                        </div>
                    </div>
                    <p class="font-black text-xs text-slate-900">{{ inv.montant|number_format(2, ',', ' ') }} TND</p>
                </div>
            {% else %}
                <div class="text-center py-20">
                    <p class="text-slate-400 text-sm">Aucun investissement enregistré.</p>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
