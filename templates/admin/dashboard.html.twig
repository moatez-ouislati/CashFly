{% extends 'admin/base.html.twig' %}

{% block title %}Tableau de bord Admin | CashFly{% endblock %}

{% block header_title %}Console de Supervision{% endblock %}
{% block header_subtitle %}Vue d'ensemble des statistiques globales du système CashFly.{% endblock %}

{% block body %}
<!-- Cartes de Statistiques Modernes -->
<section class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-12">
    <!-- Utilisateurs -->
    <div class="admin-glass p-6 rounded-3xl border border-white/5 relative overflow-hidden group hover:border-admin-primary/30 transition-all duration-500">
        <div class="relative z-10">
            <div class="w-12 h-12 bg-admin-primary/10 rounded-2xl flex items-center justify-center text-admin-primary mb-4 group-hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-2xl">groups</span>
            </div>
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-500 mb-1">Utilisateurs</p>
            <h3 class="text-4xl font-black text-white tracking-tighter">{{ users_count }}</h3>
            <div class="mt-4 flex items-center gap-2 text-[10px] font-bold text-green-400 bg-green-400/10 px-2 py-1 rounded-lg w-fit">
                <span class="material-symbols-outlined text-xs">trending_up</span>
                Actifs
            </div>
        </div>
    </div>

    <!-- Entreprises -->
    <div class="admin-glass p-6 rounded-3xl border border-white/5 relative overflow-hidden group hover:border-admin-primary/30 transition-all duration-500">
        <div class="relative z-10">
            <div class="w-12 h-12 bg-purple-500/10 rounded-2xl flex items-center justify-center text-purple-400 mb-4 group-hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-2xl">business</span>
            </div>
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-500 mb-1">PMEs</p>
            <h3 class="text-4xl font-black text-white tracking-tighter">{{ entreprises_count }}</h3>
            <div class="mt-4 flex items-center gap-2 text-[10px] font-bold text-admin-primary bg-admin-primary/10 px-2 py-1 rounded-lg w-fit">
                <span class="material-symbols-outlined text-xs">verified</span>
                Certifiées
            </div>
        </div>
    </div>

    <!-- Opérations -->
    <div class="admin-glass p-6 rounded-3xl border border-white/5 relative overflow-hidden group hover:border-admin-primary/30 transition-all duration-500">
        <div class="relative z-10">
            <div class="w-12 h-12 bg-blue-500/10 rounded-2xl flex items-center justify-center text-blue-400 mb-4 group-hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-2xl">receipt_long</span>
            </div>
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-500 mb-1">Opérations</p>
            <h3 class="text-4xl font-black text-white tracking-tighter">{{ operations_count }}</h3>
            <div class="mt-4 flex items-center gap-2 text-[10px] font-bold text-blue-400 bg-blue-400/10 px-2 py-1 rounded-lg w-fit">
                <span class="material-symbols-outlined text-xs">history</span>
                Flux Temps Réel
            </div>
        </div>
    </div>

    <!-- Trésoreries -->
    <div class="admin-glass p-6 rounded-3xl border border-white/5 relative overflow-hidden group hover:border-admin-primary/30 transition-all duration-500">
        <div class="relative z-10">
            <div class="w-12 h-12 bg-amber-500/10 rounded-2xl flex items-center justify-center text-amber-400 mb-4 group-hover:scale-110 transition-transform">
                <span class="material-symbols-outlined text-2xl">account_balance_wallet</span>
            </div>
            <p class="text-[10px] font-black uppercase tracking-widest text-slate-500 mb-1">Comptes</p>
            <h3 class="text-4xl font-black text-white tracking-tighter">{{ tresoreries_count }}</h3>
            <div class="mt-4 flex items-center gap-2 text-[10px] font-bold text-amber-400 bg-amber-400/10 px-2 py-1 rounded-lg w-fit">
                <span class="material-symbols-outlined text-xs">shield</span>
                Sécurisés
            </div>
        </div>
    </div>
</section>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
    <!-- Analyse des Flux (Graphique simulé) -->
    <div class="lg:col-span-2 admin-glass p-8 rounded-[2rem] border border-white/5">
        <div class="flex justify-between items-center mb-10">
            <div>
                <h3 class="text-xl font-black text-white tracking-tight">Analyse des Flux Financiers</h3>
                <p class="text-xs text-slate-500">Comparaison globale Revenus vs Dépenses</p>
            </div>
            <div class="flex gap-2">
                <span class="flex items-center gap-2 text-[10px] font-bold text-green-400"><div class="w-2 h-2 rounded-full bg-green-400"></div> Revenus</span>
                <span class="flex items-center gap-2 text-[10px] font-bold text-red-400"><div class="w-2 h-2 rounded-full bg-red-400"></div> Dépenses</span>
            </div>
        </div>
        
        <div class="flex items-end gap-4 h-48 mb-6">
            {% set max_val = total_revenue > total_expenses ? total_revenue : total_expenses %}
            {% if max_val == 0 %}{% set max_val = 1 %}{% endif %}
            
            <div class="flex-1 flex flex-col justify-end gap-2 group h-full">
                <div class="flex items-end gap-1 h-full">
                    <div class="flex-1 bg-green-500/20 rounded-t-xl border-t border-green-500/50 group-hover:bg-green-500/30 transition-all" style="height: {{ (total_revenue / max_val * 100)|round }}%"></div>
                    <div class="flex-1 bg-red-500/20 rounded-t-xl border-t border-red-500/50 group-hover:bg-red-500/30 transition-all" style="height: {{ (total_expenses / max_val * 100)|round }}%"></div>
                </div>
                <p class="text-[10px] font-black text-center text-slate-500">TOTAL GLOBAL</p>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-6">
            <div class="p-6 bg-white/5 rounded-2xl border border-white/5">
                <p class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-2">Total Revenus</p>
                <p class="text-2xl font-black text-green-400 tracking-tighter">{{ total_revenue|number_format(2, ',', ' ') }} <span class="text-xs opacity-50">TND</span></p>
            </div>
            <div class="p-6 bg-white/5 rounded-2xl border border-white/5">
                <p class="text-[10px] font-black text-slate-500 uppercase tracking-widest mb-2">Total Dépenses</p>
                <p class="text-2xl font-black text-red-400 tracking-tighter">{{ total_expenses|number_format(2, ',', ' ') }} <span class="text-xs opacity-50">TND</span></p>
            </div>
        </div>
    </div>

    <!-- Nouveaux Utilisateurs -->
    <div class="admin-glass p-8 rounded-[2rem] border border-white/5">
        <h3 class="text-xl font-black text-white tracking-tight mb-8">Nouveaux Comptes</h3>
        <div class="space-y-6">
            {% for user in recent_users %}
                <div class="flex items-center justify-between group">
                    <div class="flex items-center gap-4">
                        <div class="w-10 h-10 rounded-2xl bg-admin-primary/10 flex items-center justify-center text-admin-primary font-black border border-admin-primary/20 group-hover:scale-110 transition-all">
                            {{ user.prenom|first }}{{ user.nom|first }}
                        </div>
                        <div>
                            <p class="text-sm font-bold text-white group-hover:text-admin-primary transition-colors">{{ user.prenom }} {{ user.nom }}</p>
                            <p class="text-[10px] text-slate-500">{{ user.email }}</p>
                        </div>
                    </div>
                    <div class="text-[10px] font-black px-2 py-1 bg-white/5 rounded-lg border border-white/10 text-slate-400">
                        {{ user.dbRole|upper }}
                    </div>
                </div>
            {% endfor %}
        </div>
        <a href="{{ path('app_admin_users') }}" class="mt-10 flex items-center justify-center gap-2 w-full py-4 bg-admin-primary/10 hover:bg-admin-primary/20 text-admin-primary rounded-2xl text-[10px] font-black uppercase tracking-widest transition-all border border-admin-primary/20">
            Gérer les utilisateurs
            <span class="material-symbols-outlined text-sm">arrow_forward</span>
        </a>
    </div>
</div>

<!-- Liens d'Actions Rapides -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-4">
    <a href="{{ path('app_admin_export_tresoreries') }}" class="admin-glass p-4 rounded-2xl border border-white/5 hover:border-admin-primary/50 transition-all flex items-center gap-4 group">
        <div class="w-10 h-10 rounded-xl bg-green-500/10 flex items-center justify-center text-green-400 group-hover:scale-110 transition-all">
            <span class="material-symbols-outlined text-sm">download</span>
        </div>
        <span class="text-[10px] font-black text-white uppercase tracking-widest">Export Trésoreries</span>
    </a>
    <a href="{{ path('app_admin_export_operations') }}" class="admin-glass p-4 rounded-2xl border border-white/5 hover:border-admin-primary/50 transition-all flex items-center gap-4 group">
        <div class="w-10 h-10 rounded-xl bg-blue-500/10 flex items-center justify-center text-blue-400 group-hover:scale-110 transition-all">
            <span class="material-symbols-outlined text-sm">download</span>
        </div>
        <span class="text-[10px] font-black text-white uppercase tracking-widest">Export Opérations</span>
    </a>
    <div class="admin-glass p-4 rounded-2xl border border-white/5 flex items-center gap-4 opacity-50">
        <div class="w-10 h-10 rounded-xl bg-slate-500/10 flex items-center justify-center text-slate-400">
            <span class="material-symbols-outlined text-sm">settings</span>
        </div>
        <span class="text-[10px] font-black text-white uppercase tracking-widest">Config Système</span>
    </div>
    <div class="admin-glass p-4 rounded-2xl border border-white/5 flex items-center gap-4 opacity-50">
        <div class="w-10 h-10 rounded-xl bg-slate-500/10 flex items-center justify-center text-slate-400">
            <span class="material-symbols-outlined text-sm">security</span>
        </div>
        <span class="text-[10px] font-black text-white uppercase tracking-widest">Logs Sécurité</span>
    </div>
</div>
{% endblock %}
