{% extends 'adminDashboard.html.twig' %}
{% block body %}

<style>
.admin {
    max-width:1200px;
    margin:40px auto;
}

/* STATS */
.stats {
    display:grid;
    grid-template-columns: repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
    margin-bottom:30px;
}

.stat {
    padding:20px;
    border-radius:14px;
    background:linear-gradient(135deg,#1e293b,#0f172a);
    box-shadow:0 10px 40px rgba(0,0,0,0.4);
}

.stat h3 { font-size:28px; margin:0; }
.stat p { opacity:.6; }

/* toolbar */
.toolbar {
    display:flex;
    gap:10px;
    margin-bottom:20px;
}

input, select {
    padding:12px;
    border-radius:10px;
    border:none;
    background:#1e293b;
    color:white;
}

/* table */
.table {
    width:100%;
    border-collapse:collapse;
    background:#0f172a;
    border-radius:12px;
    overflow:hidden;
}

.table th {
    text-align:left;
    padding:14px;
    background:#1e293b;
    font-size:12px;
    color:#94a3b8;
}

.table td {
    padding:16px;
    border-top:1px solid #1e293b;
}

.table tr:hover {
    background:#111827;
}

/* badge */
.badge {
    padding:5px 10px;
    border-radius:6px;
    font-size:12px;
}

.green { background:#16a34a; }
.red { background:#dc2626; }

/* buttons */
.btn {
    padding:6px 12px;
    border-radius:8px;
    text-decoration:none;
    font-size:13px;
}

.edit { background:#6366f1; color:white; }
.danger { background:#dc2626; color:white; }

/* TOGGLE SWITCH */
.switch {
    position: relative;
    display: inline-block;
    width: 50px;
    height: 26px;
    margin-right:10px;
}

.switch input {
    opacity: 0;
    width: 0;
    height: 0;
}

.slider {
    position: absolute;
    cursor: pointer;
    inset: 0;
    background-color: #dc2626;
    border-radius: 34px;
    transition: .3s;
}

.slider:before {
    content: "";
    position: absolute;
    height: 20px;
    width: 20px;
    left: 3px;
    top: 3px;
    background-color: white;
    border-radius: 50%;
    transition: .3s;
}

.switch input:checked + .slider {
    background-color: #16a34a;
}

.switch input:checked + .slider:before {
    transform: translateX(24px);
}
</style>

<div class="admin">

<h1>Admin Dashboard</h1>

<div class="stats">
    <div class="stat"><h3>{{ stats.total }}</h3><p>Total Users</p></div>
    <div class="stat"><h3>{{ stats.investisseurs }}</h3><p>Investisseurs</p></div>
    <div class="stat"><h3>{{ stats.proprietaires }}</h3><p>Propriétaires</p></div>
    <div class="stat"><h3>{{ stats.admins }}</h3><p>Admins</p></div>
</div>

<div class="toolbar">
    <input id="search" placeholder="🔍 Search...">
    <select id="role">
        <option value="">All</option>
        <option value="ROLE_ADMIN">Admin</option>
        <option value="ROLE_INVESTISSEUR">Investisseur</option>
        <option value="ROLE_PROPRIETAIRE">Propriétaire</option>
    </select>
    <a href="{{ path('admin_export_pdf') }}" class="btn edit">Export PDF</a>
    <a href="{{ path('app_entreprise_admin_index') }}" class="btn edit">🏦 Entreprises</a>
    <a href="{{ path('app_document_admin_index') }}" class="btn edit">📄 Documents</a>
</div>

<table class="table">
<thead>
<tr>
<th>Name</th>
<th>Email</th>
<th>Tel</th>
<th>Status</th>
<th>Actions</th>
</tr>
</thead>

<tbody id="table">
{% for user in users %}
<tr>
<td>{{ user.fullName }}</td>
<td>{{ user.email }}</td>
<td>{{ user.tel }}</td>

<td>
<span class="badge {{ user.isActive ? 'green':'red' }}">
{{ user.isActive ? 'Active':'Inactive' }}
</span>
</td>

<td>

<label class="switch">
    <input 
        type="checkbox" 
        class="toggle"
        data-id="{{ user.id }}"
        {{ user.isActive ? 'checked' : '' }}
    >
    <span class="slider"></span>
</label>

<a href="{{ path('admin_edit_user',{id:user.id}) }}" class="btn edit">Edit</a>

<form method="post"
      action="{{ path('admin_delete_user',{id:user.id}) }}"
      style="display:inline;">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
    <button class="btn danger">Delete</button>
</form>

</td>

</tr>
{% endfor %}
</tbody>
</table>

</div>

<script>
document.addEventListener('change', function(e){
    if(e.target.classList.contains('toggle')){
        const id = e.target.dataset.id;

        fetch(`/admin/user/${id}/toggle`, {
            method: 'POST',
            headers: {'X-Requested-With':'XMLHttpRequest'}
        })
        .then(res => res.json())
        .then(data => {
            const row = e.target.closest('tr');
            const badge = row.querySelector('.badge');

            if(data.active){
                badge.textContent = 'Active';
                badge.classList.remove('red');
                badge.classList.add('green');
            } else {
                badge.textContent = 'Inactive';
                badge.classList.remove('green');
                badge.classList.add('red');
            }
        });
    }
});
</script>

{% endblock %}