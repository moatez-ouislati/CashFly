{% extends 'base.html.twig' %}

{% block title %}Modifier l'utilisateur — Admin{% endblock %}

{% block body %}
<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #6366f1 0%, #a855f7 100%);
        --bg-dark: #0f172a;
        --card-dark: #1e293b;
    }

    .edit-container {
        max-width: 700px;
        margin: 60px auto;
        padding: 40px;
        background: var(--card-dark);
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }

    .edit-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .edit-header h2 {
        font-family: 'Syne', sans-serif;
        font-weight: 800;
        font-size: 2rem;
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin-bottom: 0.5rem;
    }

    /* Styling Symfony Form Widgets */
    label {
        display: block;
        color: #94a3b8;
        font-weight: 600;
        font-size: 0.85rem;
        margin-bottom: 8px;
        margin-top: 15px;
    }

    input, select, textarea {
        width: 100%;
        padding: 12px 16px;
        background: #0f172a !important;
        border: 1px solid #334155 !important;
        border-radius: 12px;
        color: white !important;
        transition: all 0.3s;
    }

    input:focus {
        outline: none;
        border-color: #6366f1 !important;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.15);
    }

    .btn-save {
        margin-top: 30px;
        padding: 14px;
        width: 100%;
        background: var(--primary-gradient);
        border: none;
        border-radius: 14px;
        color: white;
        font-weight: 800;
        font-size: 1rem;
        cursor: pointer;
        transition: transform 0.3s, box-shadow 0.3s;
        box-shadow: 0 10px 20px rgba(99, 102, 241, 0.2);
    }

    .btn-save:hover {
        transform: translateY(-2px);
        box-shadow: 0 15px 30px rgba(99, 102, 241, 0.3);
    }

    .back-link {
        display: block;
        text-align: center;
        margin-top: 20px;
        color: #64748b;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .back-link:hover { color: white; }

    /* Customizing form errors if any */
    ul { list-style: none; padding: 0; color: #f87171; font-size: 0.8rem; margin-top: 5px; }
</style>

<div class="edit-container">
    <div class="edit-header">
        <h2>Modifier le profil</h2>
        <p style="color: #64748b;">Modification des accès et informations de l'utilisateur</p>
    </div>

    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
        
        {# تذكير: Symfony سيقوم برسم الحقول تلقائياً هنا، لكننا أعطينا الـ CSS اللازم لها أعلاه #}
        {{ form_widget(form) }}

        <button type="submit" class="btn-save">
            💾 Enregistrer les modifications
        </button>

    {{ form_end(form) }}

    <a href="{{ path('admin_dashboard') }}" class="back-link">
        ← Annuler et retourner au Dashboard
    </a>
</div>
{% endblock %}
