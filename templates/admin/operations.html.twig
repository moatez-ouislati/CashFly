{% extends 'admin/base.html.twig' %}

{% block title %}Opérations | Admin | CashFly{% endblock %}

{% block header_title %}Flux Financiers{% endblock %}
{% block header_subtitle %}Historique complet des transactions à travers tout le système.{% endblock %}

{% block body %}
<section class="admin-glass rounded-[2rem] border border-white/5 overflow-hidden">
    <div class="px-8 py-6 flex justify-between items-center border-b border-white/5 bg-white/[0.02]">
        <h3 class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500">Journal des Opérations</h3>
        <a href="{{ path('app_admin_export_operations') }}" class="flex items-center gap-2 bg-admin-primary/10 text-admin-primary px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest border border-admin-primary/20 hover:bg-admin-primary/20 transition-all">
            <span class="material-symbols-outlined text-sm">download</span>
            Exporter CSV
        </a>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-white/[0.01]">
                    <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-slate-500">Référence</th>
                    <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-slate-500">Date & Heure</th>
                    <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-slate-500">Type</th>
                    <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-slate-500">Montant</th>
                    <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-slate-500">Catégorie</th>
                    <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-slate-500">Compte</th>
                    <th class="px-8 py-5 text-[10px] font-black uppercase tracking-widest text-slate-500">Propriétaire</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-white/[0.03]">
                {% for operation in operations %}
                    <tr class="hover:bg-white/[0.02] transition-colors group">
                        <td class="px-8 py-5">
                            <span class="text-xs font-black text-white bg-white/5 px-2 py-1 rounded border border-white/10 group-hover:border-admin-primary/30 transition-all">
                                {{ operation.reference }}
                            </span>
                        </td>
                        <td class="px-8 py-5 text-xs text-slate-400">
                            {{ operation.dateOperation|date('d/m/Y') }}
                            <span class="text-[10px] text-slate-600 block">{{ operation.dateOperation|date('H:i') }}</span>
                        </td>
                        <td class="px-8 py-5">
                            <span class="inline-flex items-center px-2 py-1 rounded text-[10px] font-black uppercase tracking-widest border
                                {% if operation.type == 'revenu' %}bg-green-500/10 text-green-400 border-green-500/20
                                {% else %}bg-red-500/10 text-red-400 border-red-500/20{% endif %}">
                                {{ operation.type|capitalize }}
                            </span>
                        </td>
                        <td class="px-8 py-5">
                            <span class="text-sm font-black tracking-tight {% if operation.type == 'revenu' %}text-green-400{% else %}text-red-400{% endif %}">
                                {% if operation.type == 'revenu' %}+{% else %}-{% endif %} {{ operation.montant|number_format(2, ',', ' ') }} <span class="text-[10px] opacity-50">TND</span>
                            </span>
                        </td>
                        <td class="px-8 py-5 text-xs font-bold text-slate-400">{{ operation.categorie }}</td>
                        <td class="px-8 py-5">
                            <div class="flex flex-col">
                                <span class="text-xs font-bold text-white">{{ operation.tresorerie.nomCompte }}</span>
                                <span class="text-[10px] text-slate-500">{{ operation.tresorerie.entreprise.nom }}</span>
                            </div>
                        </td>
                        <td class="px-8 py-5">
                            <div class="flex flex-col">
                                <span class="text-xs font-bold text-slate-300">{{ operation.tresorerie.entreprise.proprietaire.prenom }} {{ operation.tresorerie.entreprise.proprietaire.nom }}</span>
                                <span class="text-[10px] text-slate-600">{{ operation.tresorerie.entreprise.proprietaire.email }}</span>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="px-8 py-20 text-center">
                            <div class="flex flex-col items-center gap-4">
                                <span class="material-symbols-outlined text-5xl text-slate-700">receipt_long</span>
                                <p class="text-slate-500 font-bold uppercase tracking-widest text-xs">Aucune opération enregistrée</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</section>
{% endblock %}
