<!DOCTYPE html>
<html class="dark" lang="fr">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>{% block title %}CashFly | Admin{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&amp;display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
    <script id="tailwind-config">
        tailwind.config = {
          darkMode: "class",
          theme: {
            extend: {
              colors: {
                "admin-bg": "#020617",
                "admin-card": "#0f172a",
                "admin-primary": "#38bdf8",
                "admin-secondary": "#94a3b8",
                "primary": "#38bdf8",
              },
              fontFamily: {
                "headline": ["Inter"],
                "body": ["Inter"],
              },
            },
          },
        }
    </script>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .admin-glass {
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
        .sidebar-item-active {
            background: linear-gradient(to right, rgba(56, 189, 248, 0.1), transparent);
            border-left: 4px solid #38bdf8;
            color: #38bdf8;
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-admin-bg font-body text-slate-200 min-h-screen">
    <!-- SideNavBar -->
    <aside class="h-screen w-72 fixed left-0 top-0 flex flex-col bg-admin-card border-r border-white/5 z-50">
        <div class="px-8 py-10">
            <div class="flex items-center gap-3 mb-2">
                <div class="w-10 h-10 bg-admin-primary rounded-xl flex items-center justify-center shadow-lg shadow-admin-primary/20">
                    <span class="material-symbols-outlined text-admin-bg font-black">architecture</span>
                </div>
                <h1 class="text-2xl font-black tracking-tighter text-white uppercase">CashFly</h1>
            </div>
            <p class="text-[10px] font-black uppercase tracking-[0.3em] text-admin-primary/60">Console d'Administration</p>
        </div>

        <nav class="flex-1 px-4 space-y-1">
            <a href="{{ path('app_admin_dashboard') }}" class="flex items-center gap-4 px-4 py-4 rounded-xl transition-all duration-300 {% if app.request.attributes.get('_route') == 'app_admin_dashboard' %}sidebar-item-active{% else %}text-slate-400 hover:text-white hover:bg-white/5{% endif %}">
                <span class="material-symbols-outlined">dashboard</span>
                <span class="font-bold text-sm">Tableau de bord</span>
            </a>
            
            <div class="pt-8 pb-2 px-4">
                <p class="text-[10px] font-black uppercase tracking-[0.2em] text-slate-500">Gestion Système</p>
            </div>

            <a href="{{ path('app_admin_users') }}" class="flex items-center gap-4 px-4 py-4 rounded-xl transition-all duration-300 {% if app.request.attributes.get('_route') starts with 'app_admin_user' %}sidebar-item-active{% else %}text-slate-400 hover:text-white hover:bg-white/5{% endif %}">
                <span class="material-symbols-outlined">group</span>
                <span class="font-bold text-sm">Utilisateurs</span>
            </a>
            <a href="{{ path('app_admin_entreprises') }}" class="flex items-center gap-4 px-4 py-4 rounded-xl transition-all duration-300 {% if app.request.attributes.get('_route') == 'app_admin_entreprises' %}sidebar-item-active{% else %}text-slate-400 hover:text-white hover:bg-white/5{% endif %}">
                <span class="material-symbols-outlined">corporate_fare</span>
                <span class="font-bold text-sm">Entreprises</span>
            </a>
            <a href="{{ path('app_admin_tresoreries') }}" class="flex items-center gap-4 px-4 py-4 rounded-xl transition-all duration-300 {% if app.request.attributes.get('_route') == 'app_admin_tresoreries' %}sidebar-item-active{% else %}text-slate-400 hover:text-white hover:bg-white/5{% endif %}">
                <span class="material-symbols-outlined">account_balance_wallet</span>
                <span class="font-bold text-sm">Trésoreries</span>
            </a>
            <a href="{{ path('app_admin_operations') }}" class="flex items-center gap-4 px-4 py-4 rounded-xl transition-all duration-300 {% if app.request.attributes.get('_route') == 'app_admin_operations' %}sidebar-item-active{% else %}text-slate-400 hover:text-white hover:bg-white/5{% endif %}">
                <span class="material-symbols-outlined">receipt_long</span>
                <span class="font-bold text-sm">Opérations</span>
            </a>
        </nav>

        <div class="p-6 mt-auto">
            <div class="bg-white/5 rounded-2xl p-4 border border-white/5 mb-4">
                <div class="flex items-center gap-3 mb-3">
                    <div class="w-10 h-10 rounded-full bg-admin-primary/20 flex items-center justify-center text-admin-primary font-black">
                        {{ app.user.prenom|first }}{{ app.user.nom|first }}
                    </div>
                    <div class="min-w-0">
                        <p class="text-xs font-bold text-white truncate">{{ app.user.prenom }} {{ app.user.nom }}</p>
                        <p class="text-[10px] text-slate-500 truncate">Admin</p>
                    </div>
                </div>
                <a href="{{ path('app_logout') }}" class="flex items-center justify-center gap-2 w-full py-2 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-lg text-[10px] font-black uppercase tracking-widest transition-all">
                    <span class="material-symbols-outlined text-sm">logout</span>
                    Déconnexion
                </a>
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="ml-72 p-8 lg:p-12 pb-24">
        <header class="flex justify-between items-end mb-16">
            <div>
                <h2 class="text-4xl font-black tracking-tighter text-white mb-2">{% block header_title %}Console{% endblock %}</h2>
                <p class="text-slate-400 font-medium italic">{% block header_subtitle %}Interface de supervision globale.{% endblock %}</p>
            </div>
            <div class="flex gap-4">
                <div class="px-6 py-3 admin-glass rounded-2xl flex items-center gap-3">
                    <div class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></div>
                    <span class="text-[10px] font-black uppercase tracking-widest text-slate-300">Serveur Actif</span>
                </div>
            </div>
        </header>

        {% block body %}{% endblock %}
    </main>

    {% block javascripts %}{% endblock %}
</body>
</html>
