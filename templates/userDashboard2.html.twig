<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8"/>
    <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
    <title>{% block title %}CashFly{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Syne:wght@400;500;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet"/>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
    <style>
        .material-symbols-outlined {
            font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }
        .no-scrollbar::-webkit-scrollbar { display: none; }

        :root {
            --bg:        #f1f5f9;
            --surface:   #ffffff;
            --surface2:  #f8fafc;
            --border:    #e2e8f0;
            --accent:    #4f46e5;
            --accent2:   #f472b6;
            --green:     #16a34a;
            --text:      #0d1c32;
            --muted:     #64748b;
            --radius:    12px;
            --shadow:    0 4px 24px rgba(0,0,0,.07);
        }

        *, *::before, *::after { box-sizing: border-box; }

        body {
            font-family: 'Inter', 'DM Sans', sans-serif;
            background: var(--bg);
            min-height: 100vh;
            line-height: 1.6;
            color: var(--text);
        }

        .card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 1.75rem;
            box-shadow: var(--shadow);
        }

        .page-header { margin-bottom: 2.5rem; }
        .page-header h1 {
            font-family: 'Syne', sans-serif;
            font-size: 2rem; font-weight: 800;
            color: var(--text);
        }
        .page-header p { color: var(--muted); margin-top: .35rem; }

        .avatar {
            width: 52px; height: 52px; border-radius: 50%;
            background: linear-gradient(135deg, #818cf8, #f472b6);
            display: flex; align-items: center; justify-content: center;
            font-family: 'Syne', sans-serif; font-size: 1.1rem; font-weight: 700;
            color: #fff; overflow: hidden; flex-shrink: 0;
        }
        .avatar img { width: 100%; height: 100%; object-fit: cover; }
        .avatar-lg { width: 90px; height: 90px; font-size: 1.8rem; }

        .btn {
            display: inline-flex; align-items: center; gap: .4rem;
            padding: .6rem 1.3rem; border-radius: 8px;
            font-family: 'DM Sans', sans-serif; font-size: .9rem; font-weight: 500;
            cursor: pointer; border: 1px solid var(--border); text-decoration: none;
            transition: all .2s; white-space: nowrap;
            color: var(--text); background: var(--surface2);
        }
        .btn:hover { background: #f1f5f9; }
        .btn-primary { background: var(--accent); color: #fff; border-color: var(--accent); }
        .btn-primary:hover { background: #4338ca; transform: translateY(-1px); }
        .btn-ghost { background: transparent; color: var(--muted); border: 1px solid var(--border); }
        .btn-ghost:hover { color: var(--text); background: var(--surface2); }

        /* Stat cards */
        .stat-card {
            background: var(--surface); border: 1px solid var(--border);
            border-radius: var(--radius); padding: 1.5rem;
            box-shadow: var(--shadow);
        }
        .stat-number {
            font-family: 'Syne', sans-serif; font-size: 1.6rem; font-weight: 800;
            color: var(--text); margin-bottom: .25rem;
        }
        .stat-label { font-size: .8rem; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; font-weight: 600; }
        .c1 .stat-number { color: #1d4ed8; }
        .c3 .stat-number { color: #7c3aed; }
        .c4 .stat-number { color: #059669; }

        .form-group { margin-bottom: 1.25rem; }
        .form-label {
            display: block; font-size: .78rem; font-weight: 600;
            color: var(--muted); margin-bottom: .45rem;
            letter-spacing: .05em; text-transform: uppercase;
        }
        .form-control {
            width: 100%; padding: .7rem 1rem;
            background: var(--surface2); border: 1px solid var(--border);
            border-radius: 8px; color: var(--text);
            font-family: 'DM Sans', sans-serif; font-size: .95rem;
            transition: border-color .2s, box-shadow .2s; outline: none;
        }
        .form-control:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(79,70,229,.12);
            background: #fff;
        }
        .form-control::placeholder { color: var(--muted); }
        .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

        .profile-grid { display: grid; grid-template-columns: 280px 1fr; gap: 1.5rem; align-items: start; }
        .profile-card-left { text-align: center; }
        .profile-card-left .avatar { margin: 0 auto 1rem; }

        .role-pill {
            display: inline-block; padding: .2rem .65rem; border-radius: 20px;
            font-size: .75rem; font-weight: 600; letter-spacing: .04em;
        }
        .role-prop  { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
        .role-invest { background: #ede9fe; color: #6d28d9; border: 1px solid #ddd6fe; }

        .flash-wrap { margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: .6rem; }
        .alert {
            padding: .85rem 1.1rem; border-radius: 8px;
            font-size: .9rem; border-left: 4px solid;
            display: flex; align-items: center; gap: .6rem;
        }
        .alert-success { background: #f0fdf4; border-color: #16a34a; color: #15803d; }
        .alert-error   { background: #fef2f2; border-color: #ef4444; color: #dc2626; }

        @media (max-width: 768px) {
            .form-row { grid-template-columns: 1fr; }
            .profile-grid { grid-template-columns: 1fr; }
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>

<!-- ── Sidebar ── -->
<aside style="height:100vh; width:240px; position:fixed; left:0; top:0; display:flex; flex-direction:column; background:#fff; border-right:1px solid #e2e8f0; font-size:.875rem; font-weight:500; z-index:50; box-shadow:2px 0 12px rgba(0,0,0,.04);">

    <div style="padding:1.5rem 1.5rem 1.25rem; border-bottom:1px solid #f1f5f9;">
        <div style="font-size:1.15rem; font-weight:900; color:#0d1c32; font-family:'Syne',sans-serif; letter-spacing:-.02em;">
            Cash<span style="color:#1d4ed8;">Fly</span>
        </div>
        <div style="margin-top:.3rem; font-size:.7rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:#7c3aed;">
            Investisseur
        </div>
    </div>

    <div style="flex:1; display:flex; flex-direction:column; gap:2px; padding:.75rem; overflow-y:auto;">
        {% set cr = app.request.attributes.get('_route') %}

        <a href="{{ path('investisseur_dashboard') }}"
           style="display:flex; align-items:center; gap:.75rem; padding:.6rem .75rem; border-radius:10px; text-decoration:none; transition:all .15s;
           {% if cr == 'investisseur_dashboard' %}background:#eff6ff; color:#1d4ed8; font-weight:600;{% else %}color:#64748b;{% endif %}"
           onmouseover="if(this.style.color !== 'rgb(29, 78, 216)') { this.style.background='#f8fafc'; this.style.color='#334155'; }"
           onmouseout="if(this.style.color !== 'rgb(29, 78, 216)') { this.style.background=''; this.style.color='#64748b'; }">
            <span class="material-symbols-outlined" style="font-size:20px;">dashboard</span>
            Dashboard
        </a>

        <a href="{{ path('investisseur_explore') }}"
           style="display:flex; align-items:center; gap:.75rem; padding:.6rem .75rem; border-radius:10px; text-decoration:none; transition:all .15s;
           {% if cr == 'investisseur_explore' %}background:#eff6ff; color:#1d4ed8; font-weight:600;{% else %}color:#64748b;{% endif %}"
           onmouseover="if(this.style.color !== 'rgb(29, 78, 216)') { this.style.background='#f8fafc'; this.style.color='#334155'; }"
           onmouseout="if(this.style.color !== 'rgb(29, 78, 216)') { this.style.background=''; this.style.color='#64748b'; }">
            <span class="material-symbols-outlined" style="font-size:20px;">travel_explore</span>
            Explorer
        </a>

        <a href="{{ path('investisseur_profile') }}"
           style="display:flex; align-items:center; gap:.75rem; padding:.6rem .75rem; border-radius:10px; text-decoration:none; transition:all .15s;
           {% if cr == 'investisseur_profile' %}background:#eff6ff; color:#1d4ed8; font-weight:600;{% else %}color:#64748b;{% endif %}"
           onmouseover="if(this.style.color !== 'rgb(29, 78, 216)') { this.style.background='#f8fafc'; this.style.color='#334155'; }"
           onmouseout="if(this.style.color !== 'rgb(29, 78, 216)') { this.style.background=''; this.style.color='#64748b'; }">
            <span class="material-symbols-outlined" style="font-size:20px;">manage_accounts</span>
            Profil
        </a>
    </div>

    <div style="padding:.75rem; border-top:1px solid #f1f5f9;">
        <a href="{{ path('app_logout') }}"
           style="display:flex; align-items:center; gap:.75rem; padding:.6rem .75rem; border-radius:10px; color:#64748b; text-decoration:none; transition:all .15s;"
           onmouseover="this.style.background='#fef2f2'; this.style.color='#dc2626';"
           onmouseout="this.style.background=''; this.style.color='#64748b';">
            <span class="material-symbols-outlined" style="font-size:20px;">logout</span>
            Déconnexion
        </a>
    </div>
</aside>

<!-- ── Main Content ── -->
<main style="margin-left:240px; min-height:100vh; padding:2.5rem; background:var(--bg); width:calc(100% - 240px);">
    {% block flashes %}
    {% for type, messages in app.flashes %}
    <div class="flash-wrap">
        {% for message in messages %}
        <div class="alert alert-{{ type }}">{{ message }}</div>
        {% endfor %}
    </div>
    {% endfor %}
    {% endblock %}

    {% block body %}{% endblock %}
</main>

{% block javascripts %}{% endblock %}
{% block importmap %}{{ importmap('app') }}{% endblock %}

</body>
</html>
