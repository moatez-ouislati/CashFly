<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}CashFly{% endblock %}</title>
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
    
    <!-- Tailwind -->
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'surface-container-lowest': '#f9f9ff',
                        'surface-container-low': '#f0f3ff',
                        'surface-container': '#e8eeff',
                        'surface-container-high': '#dfe8ff',
                        'surface-container-highest': '#d6e3ff',
                        'primary': '#2563eb',
                        'primary-dark': '#1d4ed8',
                        'on-primary': '#ffffff',
                        'on-surface': '#0d1c32',
                        'on-surface-variant': '#414754',
                        'outline': '#727786',
                        'outline-variant': '#c2c6d7',
                        'tertiary': '#00696a',
                        'error': '#dc2626',
                        'secondary': '#64748b',
                        'background': '#f9f9ff',
                        'on-background': '#0d1c32',
                        'surface': '#f9f9ff',
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        .material-symbols-outlined { font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        
        body {
            background-color: #f9f9ff;
            color: #0d1c32;
            font-family: 'Inter', sans-serif;
        }
    </style>

    {% block stylesheets %}{% endblock %}
    
    <!-- Fallback if tinymce_scripts fails to load from bundle -->
    <script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
    {{ tinymce_scripts() }}
</head>
<body class="min-h-screen">
    {% if app.user %}
        <!-- Sidebar Navigation -->
        <aside class="h-screen w-64 fixed left-0 top-0 flex flex-col bg-white border-r border-outline-variant/20 z-50 shadow-sm">
            <div class="px-6 py-6">
                <a href="{{ path('home') }}" class="flex items-center gap-3">
                    <div class="w-10 h-10 bg-primary rounded-xl flex items-center justify-center shadow-lg shadow-primary/20">
                        <span class="material-symbols-outlined text-white font-black">architecture</span>
                    </div>
                    <h1 class="text-2xl font-black tracking-tighter text-on-surface uppercase">Cash<span class="text-primary">Fly</span></h1>
                </a>
            </div>

            <nav class="flex-1 px-3 space-y-1 overflow-y-auto no-scrollbar">
                {% set route = app.request.attributes.get('_route') %}
                {% set userRole = app.user.dbRole|default(app.user.roles[0]|replace({'ROLE_': ''})|lower) %}
                
                {# ADMIN SECTION #}
                {% if app.user.primaryRole == 'ROLE_ADMIN' %}
                    <div class="px-4 py-2">
                        <p class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant">Administration</p>
                    </div>
                    
                    <a href="{{ path('admin_dashboard') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route == 'admin_dashboard' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">dashboard</span>
                        <span class="text-sm font-medium">Dashboard</span>
                    </a>
                    <a href="{{ path('admin_dashboard') ~ '?tab=users' }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route == 'admin_dashboard' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">group</span>
                        <span class="text-sm font-medium">Utilisateurs</span>
                        <span class="ml-auto text-[9px] bg-primary/10 text-primary px-2 py-0.5 rounded-full">CRUD</span>
                    </a>
                    <a href="{{ path('app_entreprise_admin_index') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route starts with 'app_entreprise_admin' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">business</span>
                        <span class="text-sm font-medium">Entreprises</span>
                    </a>
                    <a href="{{ path('app_document_admin_index') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route starts with 'app_document_admin' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">description</span>
                        <span class="text-sm font-medium">Documents</span>
                    </a>

                    <a href="{{ path('app_jpo_index') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route starts with 'jpo' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">event</span>
                        <span class="text-sm font-medium">Journées Portes Ouvertes</span>
                    </a>
                    <a href="{{ path('app_operation_admin_index') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route starts with 'app_operation_admin' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">receipt_long</span>
                        <span class="text-sm font-medium">Opérations</span>
                    </a>
                    <a href="{{ path('admin_tresoreries_index') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route == 'admin_tresoreries_index' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">account_balance</span>
                        <span class="text-sm font-medium">Trésoreries</span>
                    </a>
                    <a href="{{ path('admin_profile') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route == 'admin_profile' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">person</span>
                        <span class="text-sm font-medium">Mon Profil</span>
                    </a>

                {# PROPRIETAIRE SECTION #}
                {% elseif app.user.primaryRole == 'ROLE_PROPRIETAIRE' %}
                    <div class="px-4 py-2 mt-4">
                        <p class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant">Espace Propriétaire</p>
                    </div>
                    
                    <a href="{{ path('proprietaire_dashboard') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route == 'proprietaire_dashboard' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">dashboard</span>
                        <span class="text-sm font-medium">Dashboard</span>
                    </a>
                    <a href="{{ path('app_entreprise_index') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route starts with 'app_entreprise' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">business</span>
                        <span class="text-sm font-medium">Mes Entreprises</span>
                    </a>
                    <a href="{{ path('app_tresorerie_index') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route starts with 'tresorerie' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">account_balance</span>
                        <span class="text-sm font-medium">Trésoreries</span>
                    </a>
                    <a href="{{ path('app_operation_index') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route starts with 'operation' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">receipt_long</span>
                        <span class="text-sm font-medium">Opérations</span>
                    </a>
                    <a href="{{ path('app_document_index') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route starts with 'document' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">description</span>
                        <span class="text-sm font-medium">Mes Documents</span>
                    </a>
                    <a href="{{ path('proprietaire_clients') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route == 'proprietaire_clients' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">people</span>
                        <span class="text-sm font-medium">Les Investisseurs</span>
                    </a>
                    <a href="{{ path('app_investissement_investisseurs') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route starts with 'investissement_investisseurs' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">trending_up</span>
                        <span class="text-sm font-medium">Investissements</span>
                    </a>
                    <a href="{{ path('app_jpo_index') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route starts with 'jpo' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">event</span>
                        <span class="text-sm font-medium">Journées Portes Ouvertes</span>
                    </a>
                    <a href="{{ path('app_chatbot') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route == 'app_chatbot' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">smart_toy</span>
                        <span class="text-sm font-medium">Assistant IA</span>
                    </a>
                    <a href="{{ path('proprietaire_profile') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route == 'proprietaire_profile' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">person</span>
                        <span class="text-sm font-medium">Mon Profil</span>
                    </a>

                {# INVESTISSEUR SECTION #}
                {% elseif app.user.primaryRole == 'ROLE_INVESTISSEUR' %}
                    <div class="px-4 py-2 mt-4">
                        <p class="text-[10px] font-black uppercase tracking-widest text-on-surface-variant">Espace Investisseur</p>
                    </div>
                    
                    <a href="{{ path('investisseur_dashboard') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route == 'investisseur_dashboard' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">dashboard</span>
                        <span class="text-sm font-medium">Dashboard</span>
                    </a>
                    <a href="{{ path('investisseur_explore') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route == 'investisseur_explore' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">explore</span>
                        <span class="text-sm font-medium">Explorer Propriétaires</span>
                    </a>
                    <a href="{{ path('app_investissement_index') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route starts with 'investissement' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">trending_up</span>
                        <span class="text-sm font-medium">Mes Investissements</span>
                    </a>
                    <a href="{{ path('app_rendements') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route == 'app_rendements' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">analytics</span>
                        <span class="text-sm font-medium">Rendements</span>
                    </a>
                    <a href="{{ path('app_jpo_reservations') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route == 'app_jpo_reservations' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">bookmark</span>
                        <span class="text-sm font-medium">Mes Réservations</span>
                    </a>
                    <a href="{{ path('app_chatbot') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route == 'app_chatbot' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">smart_toy</span>
                        <span class="text-sm font-medium">Assistant IA</span>
                    </a>
                    <a href="{{ path('investisseur_profile') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl transition-all duration-300 {% if route == 'investisseur_profile' %}bg-primary/10 text-primary font-semibold{% else %}text-on-surface-variant hover:bg-surface-container-low{% endif %}">
                        <span class="material-symbols-outlined">person</span>
                        <span class="text-sm font-medium">Mon Profil</span>
                    </a>
                {% endif %}
            </nav>

            <div class="p-3 border-t border-outline-variant/20">
                <a href="{{ path('app_logout') }}" class="flex items-center gap-3 px-4 py-3 rounded-xl text-error hover:bg-error/10 transition-all duration-300">
                    <span class="material-symbols-outlined">logout</span>
                    <span class="text-sm font-medium">Déconnexion</span>
                </a>
            </div>
        </aside>

        <!-- Main Content Area -->
        <main class="ml-64 p-8 min-h-screen">
            <header class="flex justify-between items-center mb-10">
                <div>
                    {% block page_header %}{% endblock %}
                </div>
                <div class="flex items-center gap-4">
                    <div class="text-right">
                        <p class="text-sm font-bold text-on-surface">{{ app.user.fullName }}</p>
                        <p class="text-[10px] text-on-surface-variant uppercase tracking-widest">
                            {% if is_granted('ROLE_ADMIN') %}Administrateur
                            {% elseif is_granted('ROLE_PROPRIETAIRE') %}Propriétaire
                            {% else %}Investisseur{% endif %}
                        </p>
                    </div>
                    <div class="w-12 h-12 rounded-full border-2 border-primary/20 p-0.5">
                        {% if app.user.faceImage %}
                            <img src="{{ asset('uploads/faces/' ~ app.user.faceImage) }}" class="w-full h-full rounded-full object-cover">
                        {% else %}
                            <div class="w-full h-full rounded-full bg-surface-container-high flex items-center justify-center text-primary font-bold">
                                {{ app.user.prenom|slice(0,1)|upper }}{{ app.user.nom|slice(0,1)|upper }}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </header>

            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="mb-4 p-4 rounded-xl {% if label == 'success' %}bg-tertiary/10 text-tertiary border border-tertiary/20{% else %}bg-error/10 text-error border border-error/20{% endif %} flex items-center gap-3">
                        <span class="material-symbols-outlined">{% if label == 'success' %}check_circle{% else %}error{% endif %}</span>
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% block body %}{% endblock %}
        </main>
    {% else %}
        {% block public_body %}
            <div class="container mx-auto px-4 py-8">
                {% block content %}{% endblock %}
            </div>
        {% endblock %}
    {% endif %}

    {% block javascripts %}{% endblock %}
</body>
</html>
