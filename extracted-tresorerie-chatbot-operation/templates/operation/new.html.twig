{% extends 'base.html.twig' %}

{% block title %}New Transaction | CashFly{% endblock %}

{% block header_title %}New Transaction{% endblock %}
{% block header_subtitle %}Record a new income or expense{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto bg-surface-container-lowest rounded-3xl p-10 shadow-sm border border-outline-variant/10">
    <div class="mb-8 pb-6 border-b border-outline-variant/10">
        <h2 class="text-2xl font-black text-on-surface">Détails de l'opération</h2>
        <p class="text-on-surface-variant text-sm mt-1">Remplissez les informations ci-dessous pour enregistrer la transaction.</p>
    </div>

    {{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}
        
        {% if not form.vars.valid %}
        <div class="bg-error/10 border border-error/20 text-error p-4 rounded-xl mb-6">
            <div class="font-bold flex items-center gap-2 mb-2">
                <span class="material-symbols-outlined">error</span>
                Erreur de validation
            </div>
            {{ form_errors(form) }}
        </div>
        {% endif %}

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Type -->
            <div class="space-y-2">
                {{ form_label(form.type, null, {'label_attr': {'class': 'block text-sm font-bold text-on-surface-variant'}}) }}
                {{ form_widget(form.type) }}
                <div class="text-error text-xs font-medium mt-1">{{ form_errors(form.type) }}</div>
            </div>

            <!-- Tresorerie -->
            <div class="space-y-2">
                {{ form_label(form.tresorerie, null, {'label_attr': {'class': 'block text-sm font-bold text-on-surface-variant'}}) }}
                {{ form_widget(form.tresorerie) }}
                <div class="text-error text-xs font-medium mt-1">{{ form_errors(form.tresorerie) }}</div>
            </div>

            <!-- Montant -->
            <div class="space-y-2">
                {{ form_label(form.montant, null, {'label_attr': {'class': 'block text-sm font-bold text-on-surface-variant'}}) }}
                {{ form_widget(form.montant) }}
                <div class="text-error text-xs font-medium mt-1">{{ form_errors(form.montant) }}</div>
            </div>

            <!-- Devise -->
            <div class="space-y-2">
                {{ form_label(form.deviseSaisie, null, {'label_attr': {'class': 'block text-sm font-bold text-on-surface-variant'}}) }}
                {{ form_widget(form.deviseSaisie) }}
                <div class="text-error text-xs font-medium mt-1">{{ form_errors(form.deviseSaisie) }}</div>
            </div>

            <!-- Catégorie -->
            <div class="space-y-2 md:col-span-2">
                {{ form_label(form.categorie, null, {'label_attr': {'class': 'block text-sm font-bold text-on-surface-variant'}}) }}
                {{ form_widget(form.categorie) }}
                <div class="text-error text-xs font-medium mt-1">{{ form_errors(form.categorie) }}</div>
            </div>

            <!-- Description -->
            <div class="space-y-2 md:col-span-2">
                {{ form_label(form.description, null, {'label_attr': {'class': 'block text-sm font-bold text-on-surface-variant'}}) }}
                {{ form_widget(form.description) }}
                <div class="text-error text-xs font-medium mt-1">{{ form_errors(form.description) }}</div>
            </div>

            <!-- Notes Internes (TinyMCE) -->
            <div class="space-y-2 md:col-span-2 mt-4">
                <div class="flex items-center justify-between mb-2">
                    {{ form_label(form.notesInterne, null, {'label_attr': {'class': 'block text-sm font-bold text-on-surface-variant'}}) }}
                    <button type="button" onclick="document.getElementById('tinymce-modal').classList.remove('hidden')" class="px-4 py-2 bg-primary/10 text-primary hover:bg-primary hover:text-white rounded-lg text-sm font-bold transition-colors flex items-center gap-2">
                        <span class="material-symbols-outlined text-sm">edit_document</span>
                        Ouvrir l'éditeur de texte
                    </button>
                </div>
                <div class="text-xs text-on-surface-variant italic">Cliquez sur le bouton ci-dessus pour ouvrir l'éditeur de texte riche et formater vos notes.</div>
                <div class="text-error text-xs font-medium mt-1">{{ form_errors(form.notesInterne) }}</div>
                
                <!-- Hidden Modal for TinyMCE -->
                <div id="tinymce-modal" class="fixed inset-0 z-50 hidden bg-black/50 flex items-center justify-center p-4 backdrop-blur-sm">
                    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-4xl flex flex-col max-h-[90vh]">
                        <div class="p-6 border-b border-outline-variant/20 flex items-center justify-between">
                            <h3 class="text-xl font-black text-on-surface flex items-center gap-2">
                                <span class="material-symbols-outlined text-primary">edit_document</span>
                                Éditeur de Notes Internes
                            </h3>
                            <button type="button" onclick="document.getElementById('tinymce-modal').classList.add('hidden')" class="w-8 h-8 rounded-full bg-surface-container-high hover:bg-error/10 hover:text-error flex items-center justify-center transition-colors">
                                <span class="material-symbols-outlined text-sm">close</span>
                            </button>
                        </div>
                        <div class="p-6 overflow-y-auto flex-1">
                            {{ form_widget(form.notesInterne) }}
                        </div>
                        <div class="p-6 border-t border-outline-variant/20 bg-surface-container-lowest flex justify-end rounded-b-2xl">
                            <button type="button" onclick="tinymce.triggerSave(); document.getElementById('tinymce-modal').classList.add('hidden')" class="px-6 py-3 bg-primary text-white rounded-xl font-bold shadow-lg shadow-primary/20 hover:bg-primary-container hover:text-on-primary-container transition-colors">
                                Sauvegarder les notes et fermer
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Date -->
            <div class="space-y-2 md:col-span-2 mt-4">
                {{ form_label(form.dateOperation, null, {'label_attr': {'class': 'block text-sm font-bold text-on-surface-variant'}}) }}
                {{ form_widget(form.dateOperation) }}
                <div class="text-error text-xs font-medium mt-1">{{ form_errors(form.dateOperation) }}</div>
            </div>
        </div>

        <div class="pt-8 mt-8 border-t border-outline-variant/10 flex justify-end gap-4">
            <a href="{{ path('app_operation_index') }}" class="px-6 py-3 bg-surface-container-high text-on-surface rounded-xl font-bold hover:bg-surface-container-highest transition-colors">
                Annuler
            </a>
            <button type="submit" class="px-8 py-3 bg-primary text-white rounded-xl font-bold shadow-lg shadow-primary/20 hover:bg-primary-container hover:text-on-primary-container transition-all active:scale-95 flex items-center gap-2">
                <span class="material-symbols-outlined">save</span>
                Enregistrer
            </button>
        </div>

    {{ form_end(form) }}
</div>
{% endblock %}
