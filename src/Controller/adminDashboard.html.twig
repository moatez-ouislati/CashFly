</head>
<body class="bg-surface font-body text-on-surface">
<!-- SideNavBar Integration -->
<aside class="h-screen w-64 fixed left-0 top-0 flex flex-col bg-slate-100 dark:bg-slate-900 font-inter text-sm font-medium z-50">
<div class="text-lg font-bold text-slate-900 dark:text-slate-50 px-6 py-8">
            FinArchitect
        </div>

<div class="flex-1 flex flex-col gap-2 py-6 overflow-y-auto no-scrollbar">
{% set current_route = app.request.attributes.get('_route') %}
<!-- Navigation Tabs -->
<a class="transition-colors duration-200 flex items-center gap-3 py-3 px-4 mx-4 rounded-lg group {{ current_route == 'app_admin' ? 'bg-white dark:bg-slate-800 text-blue-600 dark:text-blue-400 shadow-sm' : 'text-slate-500 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800' }}" href="{{ path('app_admin') }}">
<span class="material-symbols-outlined group-active:scale-[0.98]">dashboard</span>
                Dashboard
            </a>
<a class="transition-colors duration-200 flex items-center gap-3 py-3 px-4 mx-4 rounded-lg group {{ current_route starts with 'app_entreprise_admin' ? 'bg-white dark:bg-slate-800 text-blue-600 dark:text-blue-400 shadow-sm' : 'text-slate-500 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800' }}" href="{{ path('app_entreprise_admin_index') }}">
<span class="material-symbols-outlined group-active:scale-[0.98]">account_balance</span>
                Entreprises
            </a>
<a class="transition-colors duration-200 flex items-center gap-3 py-3 px-4 mx-4 rounded-lg group {{ current_route starts with 'app_document_admin' ? 'bg-white dark:bg-slate-800 text-blue-600 dark:text-blue-400 shadow-sm' : 'text-slate-500 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800' }}" href="{{ path('app_document_admin_index') }}">
<span class="material-symbols-outlined group-active:scale-[0.98]">receipt_long</span>
                Documents
            </a>
<a class="transition-colors duration-200 flex items-center gap-3 py-3 px-4 text-slate-500 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800 mx-4 rounded-lg group" href="#">
<span class="material-symbols-outlined group-active:scale-[0.98]">monitoring</span>
                Analytics
            </a>
<a class="transition-colors duration-200 flex items-center gap-3 py-3 px-4 text-slate-500 dark:text-slate-400 hover:bg-slate-200 dark:hover:bg-slate-800 mx-4 rounded-lg group" href="#">
<span class="material-symbols-outlined group-active:scale-[0.98]">settings</span>
                Settings
            </a>
</div>
<div class="px-6 pb-8 flex flex-col gap-6">

<div class="p-4 bg-primary-container rounded-xl text-on-primary-container shadow-lg shadow-primary/20">
<p class="text-[10px] uppercase tracking-widest font-bold opacity-80 mb-1">Current Tier</p>
<p class="font-bold text-lg leading-tight">Wealth Portfolio</p>
<button class="mt-3 w-full bg-white text-primary text-xs font-bold py-2 rounded-lg transition-transform active:scale-95">Upgrade Plan</button>
</div>
<div class="flex flex-col gap-2">
<a class="flex items-center gap-3 text-slate-500 hover:text-slate-900 transition-colors" href="#">
<span class="material-symbols-outlined text-xl">help</span>
                    Support
                </a>
<a class="flex items-center gap-3 text-slate-500 hover:text-slate-900 transition-colors" href="#">
<span class="material-symbols-outlined text-xl">logout</span>
