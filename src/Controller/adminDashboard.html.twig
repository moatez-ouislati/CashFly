                    </div>
</div>
<div class="absolute -right-4 -bottom-4 opacity-5">
<span class="material-symbols-outlined text-9xl">groups</span>
</div>
</div>
<!-- Active Users -->
<div class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant/10 shadow-sm relative overflow-hidden">
<div class="relative z-10">
<p class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-1">Active Sessions</p>
<h3 class="text-3xl font-black text-on-surface mb-4">3,104</h3>
<div class="flex items-center gap-2 text-primary text-sm font-bold">
<span class="material-symbols-outlined text-lg">bolt</span>
                        98.2% Engagement Rate
                    </div>
</div>
<div class="absolute -right-4 -bottom-4 opacity-5">
<span class="material-symbols-outlined text-9xl">dynamic_feed</span>
</div>
</div>
<!-- Pending Verifications -->
<div class="bg-surface-container-lowest p-6 rounded-xl border border-outline-variant/10 shadow-sm relative overflow-hidden">
<div class="relative z-10">
<p class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant mb-1">Pending KYC</p>
<h3 class="text-3xl font-black text-on-surface mb-4">127</h3>
<div class="flex items-center gap-2 text-error text-sm font-bold">
<span class="material-symbols-outlined text-lg">priority_high</span>
                        Action Required
                    </div>
</div>


<div class="absolute -right-4 -bottom-4 opacity-5">
<span class="material-symbols-outlined text-9xl">verified_user</span>
</div>
</div>

</section>

{% block body %}{% endblock %}
