# Server Configuration
PORT=4500
NODE_ENV=development

# Database Configuration (match your Java app settings)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=mycashflydb
PORT=4500

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS Origins (allow your JavaFX app)
CORS_ORIGIN=*