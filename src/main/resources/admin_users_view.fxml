<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.canvas.Canvas?>

<VBox spacing="20" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.cashfly.controllers.AdminUsersController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <HBox spacing="30">
        <!-- USERS LIST -->
        <VBox HBox.hgrow="ALWAYS" spacing="15" styleClass="card" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 5);">
            <Label text="Gestion des Utilisateurs" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="tfSearch" promptText="Rechercher par email..." HBox.hgrow="ALWAYS" style="-fx-background-radius: 20; -fx-padding: 8 15;"/>
                <ComboBox fx:id="cbFilterRole" promptText="Filtrer par rôle" style="-fx-background-radius: 20;"/>
            </HBox>

            <ListView fx:id="lvUsers" VBox.vgrow="ALWAYS" style="-fx-background-radius: 10; -fx-border-color: #edf2f7; -fx-border-radius: 10;"/>

            <HBox spacing="10">
                <Button fx:id="btnRefresh" text="Actualiser" styleClass="secondary-button" style="-fx-background-radius: 20; -fx-padding: 8 20;"/>
                <Button text="📄 Export PDF" onAction="#exportPdf" styleClass="primary-button" style="-fx-background-radius: 20; -fx-padding: 8 20; -fx-background-color: #3b82f6; -fx-text-fill: white;"/>
                <Button fx:id="btnRegisterFace" text="📸 Enregistrer mon visage" onAction="#handleRegisterFace" styleClass="primary-button" style="-fx-background-radius: 20; -fx-padding: 8 20; -fx-background-color: #10b981; -fx-text-fill: white;"/>
            </HBox>
        </VBox>

        <!-- USER DETAILS -->
        <VBox prefWidth="350" spacing="12" styleClass="card" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 5);">
            <Label text="Détails Utilisateur" style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <VBox spacing="5">
                <Label text="CIN" style="-fx-font-size: 11; -fx-text-fill: #718096;"/>
                <TextField fx:id="tfCin" style="-fx-background-radius: 5;"/>
            </VBox>
            
            <VBox spacing="5">
                <Label text="Téléphone" style="-fx-font-size: 11; -fx-text-fill: #718096;"/>
                <TextField fx:id="tfTel" style="-fx-background-radius: 5;"/>
            </VBox>

            <HBox spacing="10">
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="Nom" style="-fx-font-size: 11; -fx-text-fill: #718096;"/>
                    <TextField fx:id="tfNom" style="-fx-background-radius: 5;"/>
                </VBox>
                <VBox HBox.hgrow="ALWAYS" spacing="5">
                    <Label text="Prénom" style="-fx-font-size: 11; -fx-text-fill: #718096;"/>
                    <TextField fx:id="tfPrenom" style="-fx-background-radius: 5;"/>
                </VBox>
            </HBox>

            <VBox spacing="5">
                <Label text="Email" style="-fx-font-size: 11; -fx-text-fill: #718096;"/>
                <TextField fx:id="tfEmail" style="-fx-background-radius: 5;"/>
            </VBox>

            <VBox spacing="5">
                <Label text="Rôle" style="-fx-font-size: 11; -fx-text-fill: #718096;"/>
                <ComboBox fx:id="cbRole" maxWidth="Infinity" style="-fx-background-radius: 5;"/>
            </VBox>

            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="btnAdd" text="Ajouter" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-background-radius: 5;"/>
                <Button fx:id="btnUpdate" text="Modifier" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-background-radius: 5;"/>
            </HBox>

            <Button fx:id="btnDelete" text="Supprimer" maxWidth="Infinity" style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-background-radius: 5;"/>

            <Separator/>

            <Label text="Actions de sécurité" style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            
            <HBox spacing="10">
                <Button text="Bloquer" onAction="#blockUser" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #f97316; -fx-text-fill: white; -fx-background-radius: 5;"/>
                <Button text="Débloquer" onAction="#unblockUser" maxWidth="Infinity" HBox.hgrow="ALWAYS" style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-background-radius: 5;"/>
            </HBox>

            <VBox spacing="5">
                <Label text="Nouveau mot de passe" style="-fx-font-size: 11; -fx-text-fill: #718096;"/>
                <PasswordField fx:id="tfPassword" style="-fx-background-radius: 5;"/>
            </VBox>
            <Button fx:id="btnChangePass" text="Changer mot de passe" maxWidth="Infinity" style="-fx-background-color: #6366f1; -fx-text-fill: white; -fx-background-radius: 5;"/>
        </VBox>
    </HBox>
</VBox>
