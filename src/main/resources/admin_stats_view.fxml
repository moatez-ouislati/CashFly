<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.canvas.Canvas?>

<VBox spacing="30" styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.cashfly.controllers.AdminStatsController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>

    <Label text="Statistiques Globales" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <HBox spacing="40" alignment="CENTER" VBox.vgrow="ALWAYS">
        <VBox spacing="15" alignment="CENTER" styleClass="card" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 8);">
            <StackPane>
                <Canvas fx:id="canvasInvest" width="200" height="200"/>
                <Label fx:id="lblInvest" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
            </StackPane>
            <Label text="Investisseurs" style="-fx-font-size: 16; -fx-text-fill: #718096;"/>
        </VBox>

        <VBox spacing="15" alignment="CENTER" styleClass="card" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 30; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 15, 0, 0, 8);">
            <StackPane>
                <Canvas fx:id="canvasProp" width="200" height="200"/>
                <Label fx:id="lblProp" style="-fx-font-size: 20; -fx-font-weight: bold;"/>
            </StackPane>
            <Label text="Propriétaires PME" style="-fx-font-size: 16; -fx-text-fill: #718096;"/>
        </VBox>
    </HBox>
</VBox>
