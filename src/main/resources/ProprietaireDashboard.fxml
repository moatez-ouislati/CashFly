<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane
        stylesheets="@admin.css"
        xmlns="http://javafx.com/javafx/21"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="controllers.ProprietaireDashboard">

    <!-- ================= HEADER ================= -->
    <top>
        <HBox styleClass="header"
              alignment="CENTER_LEFT"
              spacing="20"
              prefHeight="70">

            <!-- LOGO CASHFLY -->
            <Label text="CASHFLY"
                   styleClass="logo-text"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <!-- TITLE -->
            <Label text="Dashboard Proprietaire"
                   styleClass="header-subtitle"/>

            <Pane HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <!-- ================= SIDEBAR ================= -->
    <left>
        <VBox spacing="15" styleClass="sidebar">
            <Label text="Navigation"
                   styleClass="sidebar-title"/>

            <Button fx:id="btnMyProfile"
                    text="👤 My Profile"
                    styleClass="nav-button"/>

            <Button fx:id="btnInvestisseurs"
                    text="💼 Investisseurs"
                    styleClass="nav-button"/>

            <Button fx:id="btnLogout"
                    text="Logout"
                    styleClass="danger-button"/>
        </VBox>
    </left>

    <!-- ================= CONTENT ================= -->
    <center>
        <HBox spacing="30" styleClass="content-area">

            <!-- ===== PROFILE CARD ===== -->
            <VBox spacing="15"
                  prefWidth="320"
                  styleClass="card">

                <Label text="My Profile"
                       styleClass="section-title"/>

                <TextField fx:id="tfCin"
                           promptText="CIN"/>

                <TextField fx:id="tfTel"
                           promptText="Phone"/>

                <TextField fx:id="tfNom"
                           promptText="Last Name"/>

                <TextField fx:id="tfPrenom"
                           promptText="First Name"/>

                <TextField fx:id="tfEmail"
                           promptText="Email"/>

                <Button fx:id="btnSaveProfile"
                        text="Save Changes"
                        styleClass="primary-button"/>
            </VBox>

            <!-- ===== INVESTISSEURS LIST ===== -->
            <VBox spacing="15"
                  prefWidth="700"
                  styleClass="card">

                <Label text="Investisseurs List"
                       styleClass="section-title"/>

                <ListView fx:id="lvInvestisseurs"
                          prefHeight="450"/>
            </VBox>

        </HBox>
    </center>

</BorderPane>
