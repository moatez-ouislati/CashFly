                                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                            <children>
                                                                <Label styleClass="continue-link" text="Voir plus" />
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>
                                                <Label styleClass="notif-time" text="il y a 1j" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>

                    </children>
                </StackPane>
            </children>
        </VBox>
    </center>
</BorderPane>
