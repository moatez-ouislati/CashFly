                                                    <TableColumn fx:id="colUserStatut" prefWidth="100.0" text="Statut" />
                                                </columns>
                                                <columnResizePolicy>
                                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                </columnResizePolicy>
                                            </TableView>
                                        </children>
                                    </VBox>

                                    <!-- User Details -->
                                    <VBox prefWidth="350.0" spacing="15.0" styleClass="card">
                                        <children>
                                            <Label styleClass="section-title" text="Détails du Profil" />
                                            <HBox alignment="CENTER" spacing="15.0">
                                                <Circle fill="#e0e0e0" radius="30.0" />
                                                <VBox alignment="CENTER_LEFT">
                                                    <Label style="-fx-font-weight: bold;" text="Sélectionner un user" />
                                                    <Label text="--r" textFill="#a1a1a1" />
                                                </VBox>
                                            </HBox>
                                            <Separator opacity="0.1" />
                                            <VBox spacing="5.0">
                                                <Label styleClass="card-label" text="Contact" />
                                                <Label text="Email: -" textFill="#a1a1a1" />
                                                <Label text="Tel: -" textFill="#a1a1a1" />
                                            </VBox>
                                            <Separator opacity="0.1" />
                                            <Label styleClass="card-label" text="Historique récent" />
                                            <Label text="Aucune activité récente." textFill="#a1a1a1" wrapText="true" />
                                            <Pane VBox.vgrow="ALWAYS" />
                                            <Button maxWidth="Infinity" styleClass="action-btn" text="Contacter" />
                                        </children>
                                    </VBox>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- 5. Rapports View -->
                        <VBox fx:id="rapportsView" spacing="20.0" styleClass="main-content" visible="false">
                            <padding>
                                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                            </padding>
                            <children>
                                <Label styleClass="section-title" text="Rapports &amp; Analytics" />
                                <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                                    <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                                        <HBox prefHeight="250.0" spacing="20.0">
                                            <VBox styleClass="card" HBox.hgrow="ALWAYS">
                                                <children>
                                                    <Label styleClass="card-label" text="Répartition par Secteur" />
                                                    <PieChart fx:id="pieChartReports" VBox.vgrow="ALWAYS" />
                                                </children>
                                            </VBox>
                                            <VBox styleClass="card" HBox.hgrow="ALWAYS">
                                                <children>
                                                    <Label styleClass="card-label" text="Evolution Mensuelle" />
                                                    <BarChart fx:id="barChartReports" VBox.vgrow="ALWAYS">
                                                        <xAxis>
                                                            <CategoryAxis side="BOTTOM" />
                                                        </xAxis>
                                                        <yAxis>
                                                            <NumberAxis side="LEFT" />
                                                        </yAxis>
                                                    </BarChart>
                                                </children>
                                            </VBox>
                                        </HBox>
                                        <VBox styleClass="card" VBox.vgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="card-label" text="Comparaison entre Projets" />
                                                <LineChart fx:id="lineChartReports" VBox.vgrow="ALWAYS">
                                                    <xAxis>
                                                        <CategoryAxis side="BOTTOM" />
                                                    </xAxis>
                                                    <yAxis>
                                                        <NumberAxis side="LEFT" />
                                                    </yAxis>
                                                </LineChart>
                                            </children>
                                        </VBox>
                                    </VBox>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- 6. Paramètres View -->
                        <VBox fx:id="parametresView" spacing="20.0" styleClass="main-content" visible="false">
                            <padding>
                                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                            </padding>
                            <children>
                                <Label styleClass="section-title" text="Paramètres Généraux" />
                                <HBox spacing="30.0" VBox.vgrow="ALWAYS">
                                    <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                                        <VBox styleClass="card">
                                            <children>
                                                <Label styleClass="section-title" text="Configuration des Taux et Limites" />
                                                <VBox spacing="15.0">
                                                    <VBox spacing="5.0">
                                                        <Label text="Taux d'intérêt par défaut (%)" textFill="#6c757d" />
                                                        <TextField styleClass="form-field" text="5.0" />
                                                    </VBox>
                                                    <VBox spacing="5.0">
                                                        <Label text="Plafond d'investissement par défaut" textFill="#6c757d" />
                                                        <TextField styleClass="form-field" text="100000" />
                                                    </VBox>
                                                    <Button alignment="CENTER_LEFT" styleClass="action-btn" text="Sauvegarder les taux" />
                                                </VBox>
                                            </children>
                                        </VBox>

                                        <VBox styleClass="card">
                                            <children>
                                                <Label styleClass="section-title" text="Préférences du Dashboard" />
