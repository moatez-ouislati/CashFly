                                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                            <children>
                                                                <Circle radius="3.0" styleClass="notif-dot" />
                                                                <Label styleClass="continue-link" text="Voir plus" />
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </VBox>
                                                <Label styleClass="notif-time" text="il y a 5h" />
                                            </children>
                                        </HBox>

                                        <!-- Notif 3 -->
                                        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="notif-card">
                                            <children>
                                                <StackPane styleClass="icon-circle-info">
