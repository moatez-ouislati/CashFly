                                                    <CheckBox text="Masquer les montants sensibles" />
                                                </VBox>
                                            </children>
                                        </VBox>
                                    </VBox>

                                    <VBox prefWidth="400.0" styleClass="card">
                                        <children>
                                            <Label styleClass="section-title" text="Gestion des Accès Administrateurs" />
                                            <VBox spacing="10.0" VBox.vgrow="ALWAYS">
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <Circle fill="#5a5ce5" radius="15.0" />
                                                    <Label text="Admin Principal (Vous)" />
                                                    <Pane HBox.hgrow="ALWAYS" />
                                                    <Label style="-fx-font-size: 10px;" text="Super Admin" textFill="#2ecc71" />
                                                </HBox>
                                                <Separator opacity="0.1" />
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <Circle fill="#a1a1a1" radius="15.0" />
                                                    <Label text="Support Technique" />
                                                    <Pane HBox.hgrow="ALWAYS" />
                                                    <Button styleClass="btn-secondary" text="Gérer" />
                                                </HBox>
                                                <Pane VBox.vgrow="ALWAYS" />
                                                <Button maxWidth="Infinity" styleClass="btn-secondary" text="Ajouter un administrateur" />
                                            </VBox>
                                        </children>
                                    </VBox>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- 7. Notifications View -->
                        <VBox fx:id="notificationsView" spacing="20.0" styleClass="main-content" visible="false">
