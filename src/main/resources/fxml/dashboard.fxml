                                </HBox>

                                <VBox spacing="15.0">
                                    <children>
                                        <!-- Notif 1 -->
                                        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="notif-card">
                                            <children>
                                                <StackPane styleClass="icon-circle-success">
