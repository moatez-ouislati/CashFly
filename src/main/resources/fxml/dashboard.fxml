<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
            prefHeight="800.0" prefWidth="1360.0"
            stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.cashfly.controllers.DashboardController">

    <!-- ═══════════════════════════════════  SIDEBAR  ══════════════════════════════════ -->
    <left>
        <VBox prefHeight="800.0" prefWidth="260.0" styleClass="sidebar" BorderPane.alignment="CENTER">
            <children>
                <!-- Logo -->
                <HBox alignment="CENTER_LEFT" prefHeight="80.0" spacing="10.0">
                    <ImageView fitHeight="60.0" fitWidth="90.0" pickOnBounds="true" preserveRatio="true">
                        <image><Image url="@../images/logo.png" /></image>
                    </ImageView>
                    <VBox alignment="CENTER_LEFT">
                        <Label styleClass="logo-text" text="CASHFLY" textFill="WHITE">
                            <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <Label text="INVESTISSEUR PRO" textFill="#a1a1a1">
                            <font><Font size="9.0" /></font>
                        </Label>
                    </VBox>
                    <padding><Insets left="20.0" /></padding>
                </HBox>

                <!-- Nav section label -->
                <Label text="MENU PRINCIPAL" textFill="#6c757d">
                    <font><Font name="System Bold" size="11.0" /></font>
                    <VBox.margin><Insets left="20.0" top="20.0" bottom="8.0" /></VBox.margin>
                </Label>

                <!-- Nav buttons -->
                <VBox spacing="4.0">
                    <padding><Insets left="10.0" right="10.0" /></padding>
                    <Button alignment="BASELINE_LEFT" graphicTextGap="14.0" mnemonicParsing="false"
                            onAction="#showDashboard" prefHeight="44.0" prefWidth="240.0" text="Dashboard">
                        <styleClass><String fx:value="nav-btn" /><String fx:value="active-nav-btn" /></styleClass>
                        <graphic><FontIcon iconLiteral="fas-tachometer-alt" iconSize="16" styleClass="ikonli-font-icon" /></graphic>
                    </Button>
                    <Button alignment="BASELINE_LEFT" graphicTextGap="14.0" mnemonicParsing="false"
                            onAction="#showInvestments" prefHeight="44.0" prefWidth="240.0" styleClass="nav-btn" text="Investissements">
                        <graphic><FontIcon iconLiteral="fas-chart-line" iconSize="16" styleClass="ikonli-font-icon" /></graphic>
                    </Button>
                    <Button alignment="BASELINE_LEFT" graphicTextGap="14.0" mnemonicParsing="false"
                            onAction="#showRendements" prefHeight="44.0" prefWidth="240.0" styleClass="nav-btn" text="Rendements">
                        <graphic><FontIcon iconLiteral="fas-hand-holding-usd" iconSize="16" styleClass="ikonli-font-icon" /></graphic>
                    </Button>
                    <Button alignment="BASELINE_LEFT" graphicTextGap="14.0" mnemonicParsing="false"
                            onAction="#showUtilisateurs" prefHeight="44.0" prefWidth="240.0" styleClass="nav-btn" text="Utilisateurs">
                        <graphic><FontIcon iconLiteral="fas-users" iconSize="16" styleClass="ikonli-font-icon" /></graphic>
                    </Button>
                    <Button alignment="BASELINE_LEFT" graphicTextGap="14.0" mnemonicParsing="false"
                            onAction="#showRapports" prefHeight="44.0" prefWidth="240.0" styleClass="nav-btn" text="Rapports">
                        <graphic><FontIcon iconLiteral="fas-file-alt" iconSize="16" styleClass="ikonli-font-icon" /></graphic>
                    </Button>
                    <Button alignment="BASELINE_LEFT" graphicTextGap="14.0" mnemonicParsing="false"
                            onAction="#showParametres" prefHeight="44.0" prefWidth="240.0" styleClass="nav-btn" text="Paramètres">
                        <graphic><FontIcon iconLiteral="fas-cog" iconSize="16" styleClass="ikonli-font-icon" /></graphic>
                    </Button>
                </VBox>

                <Label text="COMMUN" textFill="#6c757d">
                    <font><Font name="System Bold" size="11.0" /></font>
                    <VBox.margin><Insets left="20.0" top="20.0" bottom="8.0" /></VBox.margin>
                </Label>
                <VBox spacing="4.0">
                    <padding><Insets left="10.0" right="10.0" /></padding>
                    <Button alignment="BASELINE_LEFT" graphicTextGap="14.0" mnemonicParsing="false"
                            onAction="#showNotifications" prefHeight="44.0" prefWidth="240.0" styleClass="nav-btn" text="Notifications">
                        <graphic><FontIcon iconLiteral="fas-bell" iconSize="16" styleClass="ikonli-font-icon" /></graphic>
                    </Button>
                </VBox>

                <Pane VBox.vgrow="ALWAYS" />

                <Button alignment="BASELINE_LEFT" graphicTextGap="14.0" mnemonicParsing="false"
                        onAction="#handleLogout" prefHeight="44.0" prefWidth="240.0" styleClass="nav-btn" text="Déconnexion">
                    <graphic><FontIcon iconLiteral="fas-sign-out-alt" iconSize="16" styleClass="ikonli-font-icon" /></graphic>
                    <VBox.margin><Insets bottom="20.0" left="10.0" /></VBox.margin>
                </Button>
            </children>
        </VBox>
    </left>

    <!-- ═══════════════════════════════════  MAIN AREA  ══════════════════════════════════ -->
    <center>
        <VBox prefHeight="800.0" styleClass="main-content" BorderPane.alignment="CENTER">
            <children>
                <!-- Top Header bar -->
                <HBox alignment="CENTER_LEFT" prefHeight="72.0" styleClass="header">
                    <VBox alignment="CENTER_LEFT">
                        <Label fx:id="pageTitle" styleClass="page-title" text="Console de Pilotage" />
                        <Label fx:id="pageSubtitle" styleClass="page-subtitle" text="Analyse en temps réel de votre écosystème financier." />
                    </VBox>
                    <Pane HBox.hgrow="ALWAYS" />
                    <HBox fx:id="exchangeRateBadge" alignment="CENTER" spacing="12.0">
                        <!-- Dynamic Selector Badge -->
                        <HBox alignment="CENTER" spacing="8.0" style="-fx-background-color: #fff9db; -fx-padding: 6px 14px; -fx-background-radius: 20px; -fx-border-color: #ffe066; -fx-border-radius: 20px; -fx-border-width: 1px;">
                            <FontIcon iconColor="#f08c00" iconLiteral="fas-sync-alt" iconSize="12" />
                            <Label text="Change:" textFill="#f08c00">
                                <font><Font name="System Bold" size="12.0" /></font>
                            </Label>
                            <ComboBox fx:id="currencySelector" prefWidth="75.0" style="-fx-background-color: transparent; -fx-padding: 0; -fx-font-size: 11px; -fx-font-weight: bold; -fx-cursor: hand;" />
                            <Label fx:id="lblDynamicRate" text="-- TND" textFill="#f08c00">
                                <font><Font name="System Bold" size="12.0" /></font>
                            </Label>
                        </HBox>
                    </HBox>
                    <Region prefWidth="25.0" />
                    <HBox alignment="CENTER" spacing="8.0" styleClass="status-badge">
                        <FontIcon iconColor="#2ecc71" iconLiteral="fas-shield-alt" iconSize="14" />
                        <Label text="SECURISÉ" textFill="#2ecc71">
                            <font><Font name="System Bold" size="11.0" /></font>
                        </Label>
                    </HBox>
                    <Circle fill="#5a5ce5" radius="16.0" stroke="WHITE" strokeType="INSIDE">
                        <HBox.margin><Insets left="20.0" right="10.0" /></HBox.margin>
                    </Circle>
                    <padding><Insets left="30.0" right="30.0" /></padding>
                </HBox>

                <!-- StackPane to swap views -->
                <StackPane VBox.vgrow="ALWAYS">
                    <children>

                        <!-- ═══════ 1. DASHBOARD (Home) ═══════ -->
                        <ScrollPane fx:id="dashboardView" fitToWidth="true" hbarPolicy="NEVER"
                                    styleClass="scroll-pane" vbarPolicy="AS_NEEDED">
                            <content>
                                <VBox spacing="24.0">
                                    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
                                    <children>

                                        <!-- KPI Row -->
                                        <HBox spacing="20.0">
                                            <!-- Total Invested -->
                                            <VBox styleClass="card" HBox.hgrow="ALWAYS">
                                                <HBox alignment="CENTER_LEFT">
                                                    <StackPane styleClass="icon-container-blue">
                                                        <FontIcon iconColor="#3498db" iconLiteral="fas-wallet" iconSize="20" />
                                                    </StackPane>
                                                    <Region HBox.hgrow="ALWAYS" />
                                                    <Label styleClass="percentage-green" text="Total" />
                                                </HBox>
                                                <Label styleClass="card-label" text="Capital Investi">
                                                    <VBox.margin><Insets top="12.0" /></VBox.margin>
                                                </Label>
                                                <Label fx:id="lblTotalInvested" styleClass="card-value" text="— TND" />
                                            </VBox>
                                            <!-- Total Gain -->
                                            <VBox styleClass="card" HBox.hgrow="ALWAYS">
                                                <HBox alignment="CENTER_LEFT">
                                                    <StackPane styleClass="icon-container-green">
                                                        <FontIcon iconColor="#2ecc71" iconLiteral="fas-chart-line" iconSize="20" />
                                                    </StackPane>
                                                    <Region HBox.hgrow="ALWAYS" />
                                                    <Label styleClass="percentage-green" text="Gains" />
                                                </HBox>
                                                <Label styleClass="card-label" text="Gains Totaux">
                                                    <VBox.margin><Insets top="12.0" /></VBox.margin>
                                                </Label>
                                                <Label fx:id="lblTotalGain" styleClass="card-value" text="+0 TND" />
                                            </VBox>
                                            <!-- Net Result -->
                                            <VBox styleClass="card" HBox.hgrow="ALWAYS">
                                                <HBox alignment="CENTER_LEFT">
                                                    <StackPane styleClass="icon-container-red">
                                                        <FontIcon iconColor="#e74c3c" iconLiteral="fas-coins" iconSize="20" />
                                                    </StackPane>
                                                    <Region HBox.hgrow="ALWAYS" />
                                                </HBox>
                                                <Label styleClass="card-label" text="Résultat Net">
                                                    <VBox.margin><Insets top="12.0" /></VBox.margin>
                                                </Label>
                                                <Label fx:id="lblNetResult" styleClass="card-value" text="0 TND" />
                                            </VBox>
                                            <!-- Active Investments -->
                                            <VBox styleClass="card" HBox.hgrow="ALWAYS">
                                                <HBox alignment="CENTER_LEFT">
                                                    <StackPane styleClass="icon-container-green">
                                                        <FontIcon iconColor="#2ecc71" iconLiteral="fas-briefcase" iconSize="20" />
                                                    </StackPane>
                                                </HBox>
                                                <Label styleClass="card-label" text="Investissements Actifs">
                                                    <VBox.margin><Insets top="12.0" /></VBox.margin>
                                                </Label>
                                                <Label fx:id="lblActiveCount" styleClass="card-value" text="0" />
                                            </VBox>
                                        </HBox>

                                        <!-- Charts + AI Row -->
                                        <HBox spacing="20.0">
                                            <!-- Pie Chart card -->
                                            <VBox styleClass="card" HBox.hgrow="ALWAYS">
                                                <Label styleClass="section-title" text="Répartition des Investissements" />
                                                <PieChart fx:id="pieChart" styleClass="dashboard-pie" prefHeight="280.0" VBox.vgrow="ALWAYS" />
                                            </VBox>

                                            <!-- AI Recommendations dark card -->
                                            <VBox prefWidth="340.0" styleClass="card-dark" spacing="12.0">
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <StackPane styleClass="icon-ai">
                                                        <FontIcon iconColor="#2ecc71" iconLiteral="fas-brain" iconSize="16" />
                                                    </StackPane>
                                                    <Label styleClass="section-title-light" text="Conseils IA" />
                                                </HBox>
                                                <Label fx:id="aiLoadingLabel" text="⏳ Chargement..." styleClass="ai-text" />
                                                <VBox fx:id="aiRecommendationsBox" spacing="10.0" VBox.vgrow="ALWAYS" />
                                                <Button maxWidth="Infinity" styleClass="action-btn" text="Générer Rapport PDF" onAction="#generateAiPdfReport" />
                                            </VBox>
                                        </HBox>

                                        <!-- Bar + Line chart row -->
                                        <HBox spacing="20.0">
                                            <VBox styleClass="card" HBox.hgrow="ALWAYS">
                                                <Label styleClass="section-title" text="Évolution des Montants" />
                                                <BarChart fx:id="barChart" styleClass="dashboard-chart" horizontalGridLinesVisible="false" verticalGridLinesVisible="false" alternativeColumnFillVisible="false" alternativeRowFillVisible="false" prefHeight="220.0" VBox.vgrow="ALWAYS">
                                                    <xAxis><CategoryAxis side="BOTTOM" tickLabelsVisible="true" tickMarkVisible="false" /></xAxis>
                                                    <yAxis><NumberAxis side="LEFT" tickLabelsVisible="true" minorTickVisible="false" tickMarkVisible="false" /></yAxis>
                                                </BarChart>
                                            </VBox>
                                            <VBox styleClass="card" HBox.hgrow="ALWAYS">
                                                <Label styleClass="section-title" text="Gains Cumulés" />
                                                <AreaChart fx:id="areaChart" styleClass="dashboard-chart" horizontalGridLinesVisible="false" verticalGridLinesVisible="false" alternativeColumnFillVisible="false" alternativeRowFillVisible="false" prefHeight="220.0" VBox.vgrow="ALWAYS">
                                                    <xAxis><CategoryAxis side="BOTTOM" tickLabelsVisible="true" tickMarkVisible="false" /></xAxis>
                                                    <yAxis><NumberAxis side="LEFT" tickLabelsVisible="true" minorTickVisible="false" tickMarkVisible="false" /></yAxis>
                                                </AreaChart>
                                            </VBox>
                                        </HBox>

                                        <!-- News Feed -->
                                        <VBox styleClass="card-dark" spacing="14.0">
                                            <HBox alignment="CENTER_LEFT">
                                                <Label styleClass="section-title-light" text="📰 Actualités Financières" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="newsLoadingLabel" text="⏳ Chargement..." styleClass="ai-text" />
                                            </HBox>
                                            <ScrollPane fitToWidth="true" prefHeight="280.0" hbarPolicy="NEVER"
                                                        vbarPolicy="AS_NEEDED" styleClass="scroll-pane">
                                                <content>
                                                    <VBox fx:id="newsContainer" spacing="10.0">
                                                        <padding><Insets top="4" /></padding>
                                                    </VBox>
                                                </content>
                                            </ScrollPane>
                                        </VBox>

                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>

                        <!-- ═══════ 2. INVESTMENTS VIEW ═══════ -->
                        <fx:include fx:id="investmentsView" source="investments.fxml" visible="false" />

                        <!-- ═══════ 3. RENDEMENTS VIEW ═══════ -->
                        <fx:include fx:id="rendementsView" source="rendements.fxml" visible="false" />

                        <!-- ═══════ 4. UTILISATEURS VIEW ═══════ -->
                        <VBox fx:id="utilisateursView" spacing="20.0" styleClass="main-content" visible="false">
                            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
                            <Label styleClass="section-title" text="Gestion des Utilisateurs" />
                            <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                        <Label styleClass="card-label" text="👥 Investisseurs et Entreprises" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <TextField promptText="🔍 Rechercher..." styleClass="search-field" />
                                    </HBox>
                                    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                                        <columns>
                                            <TableColumn fx:id="colUserId" prefWidth="50.0" text="ID" />
                                            <TableColumn fx:id="colUserNom" prefWidth="180.0" text="Nom Complet" />
                                            <TableColumn fx:id="colUserType" prefWidth="100.0" text="Rôle" />
                                            <TableColumn fx:id="colUserEmail" prefWidth="200.0" text="Email" />
                                            <TableColumn fx:id="colUserStatut" prefWidth="100.0" text="Statut" />
                                        </columns>
                                        <columnResizePolicy>
                                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                        </columnResizePolicy>
                                    </TableView>
                                </VBox>
                                <VBox prefWidth="300.0" spacing="15.0" styleClass="card">
                                    <Label styleClass="section-title" text="Détails du Profil" />
                                    <HBox alignment="CENTER" spacing="15.0">
                                        <Circle fill="#5a5ce5" radius="30.0" />
                                        <VBox alignment="CENTER_LEFT">
                                            <Label style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Sélectionner un utilisateur" />
                                            <Label text="—" textFill="#a1a1a1" />
                                        </VBox>
                                    </HBox>
                                    <Separator style="-fx-opacity:0.15;" />
                                    <Label styleClass="card-label" text="Contact" />
                                    <Label text="Email: —" textFill="#a1a1a1" />
                                    <Label text="Tél: —" textFill="#a1a1a1" />
                                    <Pane VBox.vgrow="ALWAYS" />
                                    <Button maxWidth="Infinity" styleClass="action-btn" text="Contacter" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- ═══════ 5. RAPPORTS VIEW ═══════ -->
                        <ScrollPane fx:id="rapportsView" fitToWidth="true" hbarPolicy="NEVER"
                                    styleClass="scroll-pane" vbarPolicy="AS_NEEDED" visible="false">
                            <content>
                                <VBox spacing="24.0">
                                    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>

                                    <!-- Header -->
                                    <HBox alignment="CENTER_LEFT" spacing="16.0">
                                        <VBox spacing="4.0">
                                            <Label styleClass="section-title" text="📊 Rapports Semestriels" />
                                            <Label text="Données agrégées par semestre · S1 = Jan – Juin · S2 = Juil – Déc"
                                                   style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" />
                                        </VBox>
                                        <Region HBox.hgrow="ALWAYS" />
                                        <!-- Period badge -->
                                        <HBox alignment="CENTER" spacing="8.0"
                                              style="-fx-background-color: #5a5ce515; -fx-background-radius: 8;
                                                     -fx-border-color: #5a5ce530; -fx-border-radius: 8;
                                                     -fx-border-width: 1; -fx-padding: 6 14;">
                                            <FontIcon iconLiteral="fas-calendar-alt" iconSize="14"
                                                      style="-fx-icon-color: #5a5ce5;" />
                                            <Label text="2 PÉRIODES / AN"
                                                   style="-fx-text-fill: #5a5ce5; -fx-font-size: 11px; -fx-font-weight: bold;" />
                                        </HBox>
                                    </HBox>

                                    <!-- Row 1: Pie + Bar side by side -->
                                    <HBox spacing="20.0">

                                        <!-- Pie: portfolio by enterprise -->
                                        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="8.0">
                                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                <FontIcon iconLiteral="fas-chart-pie" iconSize="16"
                                                          style="-fx-icon-color: #5a5ce5;" />
                                                <VBox spacing="1.0">
                                                    <Label text="Répartition du Capital"
                                                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                                                    <Label text="Par entreprise · tous semestres"
                                                           style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;" />
                                                </VBox>
                                            </HBox>
                                            <Separator style="-fx-opacity: 0.12;" />
                                            <PieChart fx:id="pieChartReports" prefHeight="260.0"
                                                      legendVisible="true" labelsVisible="true"
                                                      VBox.vgrow="ALWAYS" />
                                        </VBox>

                                        <!-- Bar: invested capital per semester -->
                                        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="8.0">
                                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                <FontIcon iconLiteral="fas-chart-bar" iconSize="16"
                                                          style="-fx-icon-color: #3498db;" />
                                                <VBox spacing="1.0">
                                                    <Label text="Capital Investi par Semestre"
                                                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                                                    <Label text="Montant total investi · S1 et S2"
                                                           style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;" />
                                                </VBox>
                                            </HBox>
                                            <Separator style="-fx-opacity: 0.12;" />
                                            <BarChart fx:id="barChartReports" prefHeight="260.0"
                                                      animated="false" VBox.vgrow="ALWAYS">
                                                <xAxis>
                                                    <CategoryAxis side="BOTTOM"
                                                                  label="Semestre" />
                                                </xAxis>
                                                <yAxis>
                                                    <NumberAxis side="LEFT"
                                                                label="Montant (TND)" />
                                                </yAxis>
                                            </BarChart>
                                        </VBox>
                                    </HBox>

                                    <!-- Row 2: Line chart full-width -->
                                    <VBox styleClass="card" spacing="8.0">
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <FontIcon iconLiteral="fas-chart-line" iconSize="16"
                                                      style="-fx-icon-color: #2ecc71;" />
                                            <VBox spacing="1.0">
                                                <Label text="Performance Semestrielle — Gains · Pertes · Résultat Net"
                                                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" />
                                                <Label text="Comparaison sur 3 indicateurs regroupés par S1 et S2"
                                                       style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;" />
                                            </VBox>
                                            <Region HBox.hgrow="ALWAYS" />
                                            <!-- Legend pills -->
                                            <HBox spacing="10.0" alignment="CENTER">
                                                <HBox spacing="5.0" alignment="CENTER">
                                                    <Pane style="-fx-background-color: #2ecc71; -fx-min-width: 10; -fx-min-height: 10; -fx-background-radius: 2;" />
                                                    <Label text="Gains" style="-fx-font-size: 10px; -fx-text-fill: #2ecc71;" />
                                                </HBox>
                                                <HBox spacing="5.0" alignment="CENTER">
                                                    <Pane style="-fx-background-color: #e74c3c; -fx-min-width: 10; -fx-min-height: 10; -fx-background-radius: 2;" />
                                                    <Label text="Pertes" style="-fx-font-size: 10px; -fx-text-fill: #e74c3c;" />
                                                </HBox>
                                                <HBox spacing="5.0" alignment="CENTER">
                                                    <Pane style="-fx-background-color: #5a5ce5; -fx-min-width: 10; -fx-min-height: 10; -fx-background-radius: 2;" />
                                                    <Label text="Net" style="-fx-font-size: 10px; -fx-text-fill: #5a5ce5;" />
                                                </HBox>
                                            </HBox>
                                        </HBox>
                                        <Separator style="-fx-opacity: 0.12;" />
                                        <LineChart fx:id="lineChartReports" prefHeight="300.0"
                                                   animated="false" VBox.vgrow="ALWAYS">
                                            <xAxis>
                                                <CategoryAxis side="BOTTOM" label="Semestre" />
                                            </xAxis>
                                            <yAxis>
                                                <NumberAxis side="LEFT" label="Montant (TND)" />
                                            </yAxis>
                                        </LineChart>
                                    </VBox>

                                </VBox>
                            </content>
                        </ScrollPane>

                        <!-- ═══════ 6. PARAMÈTRES VIEW ═══════ -->
                        <VBox fx:id="parametresView" spacing="20.0" styleClass="main-content" visible="false">
                            <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
                            <Label styleClass="section-title" text="Paramètres Généraux" />
                            <HBox spacing="20.0" VBox.vgrow="ALWAYS">
                                <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                                    <VBox styleClass="card" spacing="12.0">
                                        <Label styleClass="section-title" text="Configuration des Taux" />
                                        <VBox spacing="5.0">
                                            <Label text="Taux d'intérêt par défaut (%)" textFill="#6c757d" />
                                            <TextField styleClass="form-field" text="5.0" />
                                        </VBox>
                                        <VBox spacing="5.0">
