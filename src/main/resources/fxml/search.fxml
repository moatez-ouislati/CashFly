<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.cashfly.controllers.SearchController">

    <!-- Top: Title -->
    <top>
        <VBox spacing="10" style="-fx-background-color: #2c3e50; -fx-padding: 20;">
            <Label text="Recherche et Filtrage" textFill="white">
                <font>
                    <Font name="System Bold" size="24"/>
                </font>
            </Label>
        </VBox>
    </top>

    <!-- Center: Main content -->
    <center>
        <TabPane>
            <!-- Tab 1: Utilisateurs -->
            <Tab text="Utilisateurs" closable="false">
                <VBox spacing="15" style="-fx-padding: 20;">
                    <!-- Filtres -->
                    <TitledPane text="Filtres de Recherche" expanded="true">
                        <GridPane hgap="10" vgap="10" style="-fx-padding: 10;">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                            </columnConstraints>

                            <Label text="Recherche:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <TextField fx:id="searchTextField" promptText="Nom ou email..."
                                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                            <Label text="Rôle:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                            <ComboBox fx:id="roleComboBox"
                                      GridPane.columnIndex="3" GridPane.rowIndex="0"
                                      prefWidth="200"/>

                            <Label text="Date début:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <DatePicker fx:id="dateDebutPicker"
                                        GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                            <Label text="Date fin:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                            <DatePicker fx:id="dateFinPicker"
                                        GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                            <HBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                  GridPane.columnSpan="4">
                                <Button text="Rechercher" onAction="#handleSearchUsers"
                                        style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                                <Button text="Réinitialiser" onAction="#handleResetFilters"
                                        style="-fx-background-color: #95a5a6; -fx-text-fill: white;"/>
                                <Button text="Exporter CSV" onAction="#handleExportUsers"
                                        style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
                            </HBox>
                        </GridPane>
                    </TitledPane>

                    <!-- Table des résultats -->
                    <TableView fx:id="userTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="userIdColumn" text="ID" prefWidth="50"/>
                            <TableColumn fx:id="userNameColumn" text="Nom Complet" prefWidth="200"/>
                            <TableColumn fx:id="userEmailColumn" text="Email" prefWidth="200"/>
                            <TableColumn fx:id="userRoleColumn" text="Rôle" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- Tab 2: Investissements -->
            <Tab text="Investissements" closable="false">
                <VBox spacing="15" style="-fx-padding: 20;">
                    <!-- Filtres -->
                    <TitledPane text="Filtres de Recherche" expanded="true">
                        <GridPane hgap="10" vgap="10" style="-fx-padding: 10;">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                                <ColumnConstraints percentWidth="25"/>
                            </columnConstraints>

                            <Label text="Recherche:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <TextField fx:id="searchTextField" promptText="Description..."
                                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                            <Label text="Statut:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                            <ComboBox fx:id="statutComboBox"
                                      GridPane.columnIndex="3" GridPane.rowIndex="0"
                                      prefWidth="200"/>

                            <Label text="Montant min:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <TextField fx:id="montantMinField" promptText="0.00"
                                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                            <Label text="Montant max:" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                            <TextField fx:id="montantMaxField" promptText="999999.99"
                                       GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                            <Label text="Date début:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <DatePicker fx:id="dateDebutPicker"
                                        GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                            <Label text="Date fin:" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                            <DatePicker fx:id="dateFinPicker"
                                        GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                            <HBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="3"
                                  GridPane.columnSpan="4">
                                <Button text="Rechercher" onAction="#handleSearchInvestments"
                                        style="-fx-background-color: #3498db; -fx-text-fill: white;"/>
                                <Button text="Réinitialiser" onAction="#handleResetFilters"
                                        style="-fx-background-color: #95a5a6; -fx-text-fill: white;"/>
                                <Button text="Exporter CSV" onAction="#handleExportInvestments"
                                        style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
                                <Button text="Statistiques" onAction="#handleShowStatistics"
                                        style="-fx-background-color: #e74c3c; -fx-text-fill: white;"/>
                            </HBox>
                        </GridPane>
                    </TitledPane>

                    <!-- Table des résultats -->
                    <TableView fx:id="investmentTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="invIdColumn" text="ID" prefWidth="50"/>
                            <TableColumn fx:id="invMontantColumn" text="Montant" prefWidth="150"/>
                            <TableColumn fx:id="invStatutColumn" text="Statut" prefWidth="150"/>
                            <TableColumn fx:id="invDateColumn" text="Date" prefWidth="150"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- Tab 3: Statistiques -->
            <Tab text="Statistiques" closable="false">
                <VBox spacing="20" style="-fx-padding: 20;">
                    <TitledPane text="Vue d'ensemble" expanded="true">
                        <GridPane hgap="20" vgap="20" style="-fx-padding: 20;">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="33"/>
                                <ColumnConstraints percentWidth="33"/>
                                <ColumnConstraints percentWidth="33"/>
                            </columnConstraints>

                            <!-- Card 1 -->
                            <VBox spacing="10" style="-fx-background-color: #3498db; -fx-padding: 20; -fx-background-radius: 10;"
                                  GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label text="Total Utilisateurs" textFill="white">
                                    <font><Font size="16"/></font>
                                </Label>
                                <Label fx:id="totalUsersLabel" text="0" textFill="white">
                                    <font><Font name="System Bold" size="32"/></font>
                                </Label>
                            </VBox>

                            <!-- Card 2 -->
                            <VBox spacing="10" style="-fx-background-color: #27ae60; -fx-padding: 20; -fx-background-radius: 10;"
                                  GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <Label text="Total Investissements" textFill="white">
                                    <font><Font size="16"/></font>
                                </Label>
                                <Label fx:id="totalInvestmentsLabel" text="0" textFill="white">
                                    <font><Font name="System Bold" size="32"/></font>
                                </Label>
                            </VBox>

                            <!-- Card 3 -->
                            <VBox spacing="10" style="-fx-background-color: #e74c3c; -fx-padding: 20; -fx-background-radius: 10;"
                                  GridPane.columnIndex="2" GridPane.rowIndex="0">
                                <Label text="Montant Total" textFill="white">
                                    <font><Font size="16"/></font>
                                </Label>
                                <Label fx:id="totalAmountLabel" text="0.00 DT" textFill="white">
                                    <font><Font name="System Bold" size="32"/></font>
                                </Label>
                            </VBox>
                        </GridPane>
                    </TitledPane>
                </VBox>
            </Tab>
        </TabPane>
    </center>

</BorderPane>