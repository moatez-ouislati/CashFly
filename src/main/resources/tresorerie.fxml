<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.cashfly.controllers.TresorerieUIController"
      spacing="16.0" style="-fx-background-color: #f8fafc;"
      stylesheets="@style.css" styleClass="root-pane">
    <padding>
        <Insets top="24.0" right="32.0" bottom="24.0" left="32.0"/>
    </padding>

    <HBox spacing="16.0" alignment="CENTER_LEFT">
        <children>
            <Label text="Trésorerie" style="-fx-text-fill: #0f172a;">
                <font>
                    <Font name="System Bold" size="20.0"/>
                </font>
            </Label>
            <Label fx:id="currentEntrepriseLabel" text="Aucune entreprise sélectionnée" textFill="#6b7280">
                <font>
                    <Font size="12.0"/>
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="deviseFilterField" promptText="Filtrer par devise (EUR, USD...)" prefWidth="200.0"/>
            <TextField fx:id="minSoldeField" promptText="Solde minimum" prefWidth="140.0"/>
        </children>
    </HBox>

    <HBox spacing="16.0">
        <children>
            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                <children>
                    <Label text="Liste des comptes de trésorerie" styleClass="panel-header"/>
                    <ScrollPane prefHeight="380.0"
                                fitToWidth="true"
                                hbarPolicy="NEVER"
                                style="-fx-background-color: transparent;">
                        <content>
                            <FlowPane fx:id="tresorerieCardsContainer"
                                      hgap="12.0"
                                      vgap="12.0"
                                      prefWrapLength="600.0"
                                      style="-fx-padding: 4 0 4 0;"/>
                        </content>
                    </ScrollPane>
                </children>
            </VBox>

            <VBox spacing="8.0" prefWidth="260.0">
                <children>
                    <Label text="Formulaire" styleClass="panel-header"/>
                    <TextField fx:id="soldeField" promptText="Solde"/>
                    <TextField fx:id="deviseField" promptText="Devise (3 lettres)"/>
                    <HBox spacing="8.0">
                        <children>
                            <Button text="Ajouter" onAction="#onAdd" styleClass="btn-primary"/>
                            <Button text="Enregistrer" onAction="#onUpdate" styleClass="btn-primary"/>
                        </children>
                    </HBox>
                </children>
            </VBox>
        </children>
    </HBox>
</VBox>
