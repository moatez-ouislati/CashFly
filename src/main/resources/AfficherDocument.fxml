<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.cashfly.controllers.AfficherD">
    <children>
        <VBox spacing="25.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <!-- Header with Search and Actions -->
                <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="header" style="-fx-background-color: white; -fx-padding: 20 30; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 0, 5, 0, 0);">
                    <children>
                        <TextField fx:id="txtSearch" prefHeight="40.0" prefWidth="350.0" promptText="Rechercher un document par nom..." styleClass="search-field" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox spacing="10.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#refresh" styleClass="btn-secondary" text="Actualiser" />
                                <Button mnemonicParsing="false" onAction="#showAjouter" styleClass="btn-primary" text="+ Ajouter Document" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <VBox spacing="20.0" VBox.vgrow="ALWAYS" style="-fx-padding: 0 30 30 30;">
                    <children>
                        <!-- Filter Label -->
                        <VBox spacing="5.0">
                            <children>
                                <Label styleClass="section-title" text="Filtrer par entreprise" />
                                <Label styleClass="page-subtitle" text="Sélectionnez une entreprise pour voir ses documents." />
                            </children>
                        </VBox>

                        <!-- Enterprise Filter Buttons -->
                        <ScrollPane fitToHeight="true" hbarPolicy="NEVER" prefHeight="60.0" style="-fx-background-color: transparent;" vbarPolicy="NEVER">
                            <content>
                                <HBox fx:id="entrepriseContainer" alignment="CENTER_LEFT" spacing="12.0" style="-fx-background-color: transparent;">
                                    <padding>
                                        <Insets bottom="5.0" top="5.0" />
                                    </padding>
                                </HBox>
                            </content>
                        </ScrollPane>

                        <!-- Document Cards Grid -->
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                            <content>
                                <FlowPane fx:id="cardContainer" hgap="25.0" vgap="25.0" style="-fx-padding: 10 0;">
                                    <!-- Cards will be injected here -->
                                </FlowPane>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
