<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #1e293b; -fx-background-radius: 15;" xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.cashfly.controllers.KYCController">
    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>
    <children>
        <Label text="Vérification KYC - Reconnaissance Faciale" textFill="WHITE">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        
        <StackPane fx:id="cameraPane" prefHeight="300.0" prefWidth="400.0" style="-fx-background-color: black; -fx-background-radius: 10; -fx-border-color: #3b82f6; -fx-border-width: 2; -fx-border-radius: 10;">
            <children>
                <!-- Simulated Camera View -->
                <Rectangle arcHeight="5.0" arcWidth="5.0" fill="#00000000" height="200.0" stroke="#3b82f6" strokeType="INSIDE" strokeWidth="2.0" width="200.0" style="-fx-stroke-dash-array: 10;" />
                <Label fx:id="statusLabel" text="Positionnez votre visage dans le cadre" textFill="#94a3b8" StackPane.alignment="BOTTOM_CENTER">
                    <StackPane.margin>
                        <Insets bottom="20.0" />
                    </StackPane.margin>
                </Label>
                
                <!-- Scanning animation overlay (hidden initially) -->
                <Rectangle fx:id="scanLine" fill="#3b82f6" height="2.0" visible="false" width="380.0" StackPane.alignment="TOP_CENTER" />
            </children>
        </StackPane>
        
        <VBox alignment="CENTER" spacing="10.0">
            <children>
                <ProgressBar fx:id="progressBar" maxWidth="Infinity" progress="0.0" prefHeight="10.0" style="-fx-accent: #3b82f6;" visible="false" />
                <Label fx:id="percentageLabel" text="0%" textFill="#3b82f6" visible="false">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
            </children>
        </VBox>
        
        <VBox alignment="CENTER" spacing="15.0">
            <children>
                <Button fx:id="scanButton" onAction="#startScan" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 25; -fx-cursor: hand;" text="Lancer l'analyse" />
                <Button onAction="#closeModal" style="-fx-background-color: transparent; -fx-text-fill: #94a3b8; -fx-cursor: hand;" text="Annuler" />
            </children>
        </VBox>
    </children>
</VBox>
