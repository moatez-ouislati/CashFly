<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.cashfly.controllers.OperationUIController"
      spacing="16.0" style="-fx-background-color: #f8fafc;"
      stylesheets="@style.css" styleClass="root-pane">
    <padding>
        <Insets top="24.0" right="32.0" bottom="24.0" left="32.0"/>
    </padding>

    <HBox spacing="12.0" alignment="CENTER_LEFT">
        <children>
            <Label text="Opérations" style="-fx-text-fill: #0f172a;">
                <font>
                    <Font name="System Bold" size="20.0"/>
                </font>
            </Label>
            <Label fx:id="currentContextLabel" text="Aucune trésorerie sélectionnée" textFill="#6b7280">
                <font>
                    <Font size="12.0"/>
                </font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <ComboBox fx:id="typeFilterBox" promptText="Type (revenu / depense)" prefWidth="180.0"/>
            <TextField fx:id="minMontantField" promptText="Montant min" prefWidth="100.0"/>
            <TextField fx:id="maxMontantField" promptText="Montant max" prefWidth="100.0"/>
            <TextField fx:id="keywordField" promptText="Catégorie / description" prefWidth="200.0"/>
        </children>
    </HBox>

    <HBox spacing="16.0" VBox.vgrow="ALWAYS">
        <children>
            <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                <children>
                    <HBox spacing="16.0" VBox.vgrow="ALWAYS">
                        <children>
                            <!-- Revenus Column -->
                            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label text="Revenus" style="-fx-font-weight: bold; -fx-text-fill: #2ecc71;"/>
                                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                                        <content>
                                            <VBox fx:id="revenuCardsContainer" spacing="10.0" style="-fx-padding: 5;"/>
                                        </content>
                                    </ScrollPane>
                                </children>
                            </VBox>
                            
                            <Separator orientation="VERTICAL" />

                            <!-- Depenses Column -->
                            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                <children>
                                    <Label text="Dépenses" style="-fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                                        <content>
                                            <VBox fx:id="depenseCardsContainer" spacing="10.0" style="-fx-padding: 5;"/>
                                        </content>
                                    </ScrollPane>
                                </children>
                            </VBox>
                        </children>
                    </HBox>
                </children>
            </VBox>

            <VBox spacing="8.0" prefWidth="280.0">
                <children>
                    <Label text="Formulaire" styleClass="panel-header"/>
                    <ComboBox fx:id="typeBox" promptText="Type (revenu / depense)" prefWidth="200.0"/>
                    <HBox spacing="8.0">
                        <children>
                            <TextField fx:id="montantField" promptText="Montant" HBox.hgrow="ALWAYS"/>
                            <ComboBox fx:id="operationCurrencyBox" prefWidth="80.0" promptText="TND"/>
                        </children>
                    </HBox>
                    <TextField fx:id="categorieField" promptText="Catégorie"/>
                    <TextField fx:id="descriptionField" promptText="Description"/>
                    <VBox spacing="8.0" style="-fx-background-color: #f8fafc; -fx-padding: 10; -fx-background-radius: 8; -fx-border-color: #e2e8f0; -fx-border-radius: 8;">
                        <children>
                            <HBox spacing="8.0" alignment="CENTER_LEFT">
                                <children>
                                    <Label text="KYC Identité" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="kycStatusLabel" text="❌ Non vérifié" style="-fx-font-size: 11; -fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
                                </children>
                            </HBox>
                            <Button text="Reconnaissance Faciale" onAction="#onKYC" styleClass="btn-kyc" maxWidth="Infinity" style="-fx-font-size: 11;"/>
                        </children>
                    </VBox>
                    <HBox spacing="8.0">
                        <children>
                            <Button text="Ajouter" onAction="#onAdd" styleClass="btn-primary"/>
                            <Button text="Enregistrer" onAction="#onUpdate" styleClass="btn-primary"/>
                        </children>
                    </HBox>

                    <Separator prefWidth="200.0" style="-fx-padding: 10 0 10 0;"/>
                    
                    <VBox spacing="8.0" style="-fx-background-color: #f1f5f9; -fx-padding: 12; -fx-background-radius: 8;">
                        <children>
                            <Label text="Taux de Change" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                            <HBox spacing="8.0" alignment="CENTER_LEFT">
                                <children>
                                    <TextField fx:id="fromCurrencyField" text="EUR" prefWidth="60.0" promptText="De"/>
                                    <Label text="➜" textFill="#94a3b8"/>
                                    <TextField fx:id="toCurrencyField" text="TND" prefWidth="60.0" promptText="Vers"/>
                                </children>
                            </HBox>
                            <Button text="Vérifier le taux" onAction="#onCheckRate" styleClass="btn-secondary" maxWidth="Infinity"/>
                            <Label fx:id="rateResultLabel" text="Taux : ---" style="-fx-font-size: 13px; -fx-text-fill: #8b5cf6; -fx-font-weight: bold;"/>
                        </children>
                    </VBox>
                </children>
            </VBox>
        </children>
    </HBox>
</VBox>
