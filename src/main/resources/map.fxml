<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="700.0" prefWidth="1100.0" xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.cashfly.controllers.MapController">
   <children>
      <VBox spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="header" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
               <children>
                  <Button mnemonicParsing="false" onAction="#retour" styleClass="btn-secondary" text="← Retour" />
                  <VBox>
                     <children>
                        <Label text="Carte des Entreprises" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #1e293b;" />
                        <Label text="Visualisez vos entreprises sur la carte interactive." style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <AnchorPane VBox.vgrow="ALWAYS" style="-fx-background-color: #e2e8f0; -fx-background-radius: 10; -fx-border-color: #cbd5e1; -fx-border-radius: 10;">
               <children>
                  <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <Canvas fx:id="canvas" />
                        <ProgressIndicator fx:id="loadingIndicator" maxWidth="80.0" maxHeight="80.0" />
                     </children>
                  </StackPane>
               </children>
            </AnchorPane>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
   </children>
</AnchorPane>
