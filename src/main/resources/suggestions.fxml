<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.cashfly.controllers.SuggestionUIController"
      spacing="16.0" style="-fx-background-color: #f8fafc;"
      stylesheets="@style.css" styleClass="root-pane">
    <padding>
        <Insets top="24.0" right="32.0" bottom="24.0" left="32.0"/>
    </padding>

    <HBox spacing="12.0" alignment="CENTER_LEFT">
        <children>
            <Label text="Suggestions" style="-fx-text-fill: #0f172a;">
                <font><Font name="System Bold" size="20.0"/></font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
        </children>
    </HBox>

    <HBox spacing="16.0">
        <children>
            <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                <children>
                    <Label text="Nouvelle suggestion" style="-fx-text-fill: #475569; -fx-font-size: 14; -fx-font-weight: bold;"/>
                    <TextField fx:id="titleField" promptText="Titre de la suggestion"/>
                    <TextArea fx:id="messageField" promptText="Votre message" prefRowCount="6"/>
                    <Button text="Envoyer" onAction="#onSend" styleClass="btn-primary" maxWidth="Infinity"/>
                </children>
            </VBox>
            <VBox spacing="12.0" prefWidth="380.0">
                <children>
                    <Label text="Historique (session)" style="-fx-text-fill: #475569; -fx-font-size: 14; -fx-font-weight: bold;"/>
                    <ListView fx:id="suggestionsList"/>
                </children>
            </VBox>
        </children>
    </HBox>
</VBox>
