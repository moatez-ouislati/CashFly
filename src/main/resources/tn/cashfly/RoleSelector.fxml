<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="root" stylesheets="@Styles/custom.css" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.cashfly.jpo.controllers.RoleSelectorController">

    <HBox alignment="CENTER" prefHeight="80.0" prefWidth="1280.0" styleClass="app-header" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets left="30.0" right="30.0" />
        </padding>
        <Label styleClass="app-header-title" text="CashFly - Portail de Connexion" />
    </HBox>

    <HBox spacing="0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="80.0">

        <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: -color-bg-default;" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="50.0" left="80.0" right="80.0" top="50.0" />
            </padding>

            <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="Connexion" textFill="#0D2440" />
            <Label styleClass="text-muted" text="Connectez-vous pour accéder à votre espace" />

            <VBox maxWidth="400.0" spacing="15.0">
                <VBox spacing="5.0">
                    <Label styleClass="form-label" text="Email" />
                    <TextField fx:id="emailField" promptText="votre@email.com" />
                </VBox>

                <VBox spacing="5.0">
                    <Label styleClass="form-label" text="Mot de passe" />
                    <PasswordField fx:id="passwordField" promptText="••••••••" />
                </VBox>

                <Label fx:id="errorLabel" styleClass="message-error" text="Email ou mot de passe incorrect" visible="false" wrapText="true" />

                <Button onAction="#handleLogin" prefHeight="50.0" prefWidth="400.0" styleClass="btn-primary" text="Se connecter">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Button>
            </VBox>
        </VBox>

        <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #0D2440;" prefWidth="640.0">
            <padding>
                <Insets bottom="50.0" left="50.0" right="50.0" top="50.0" />
            </padding>

            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #E7F0FA;" text="Accès Rapide" />
            <Label style="-fx-text-fill: #7BA4D0;" text="Sélectionnez votre profil (Démo)" wrapText="true" alignment="CENTER" />

            <HBox alignment="CENTER" spacing="20.0">
                <VBox alignment="CENTER" spacing="15.0" styleClass="card" prefWidth="180.0" prefHeight="220.0" style="-fx-background-color: rgba(255,255,255,0.1);">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <FontIcon iconColor="white" iconLiteral="fas-building" iconSize="36" />
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" text="Propriétaire" />
                    <Button onAction="#openPME" prefHeight="40.0" prefWidth="140.0" styleClass="btn-primary" text="Accéder" />
                </VBox>

                <VBox alignment="CENTER" spacing="15.0" styleClass="card" prefWidth="180.0" prefHeight="220.0" style="-fx-background-color: rgba(255,255,255,0.1);">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <FontIcon iconColor="white" iconLiteral="fas-briefcase" iconSize="36" />
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" text="Investisseur" />
                    <Button onAction="#openInvestor" prefHeight="40.0" prefWidth="140.0" styleClass="btn-primary" text="Accéder" />
                </VBox>

                <VBox alignment="CENTER" spacing="15.0" styleClass="card" prefWidth="180.0" prefHeight="220.0" style="-fx-background-color: rgba(255,255,255,0.1);">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <FontIcon iconColor="white" iconLiteral="fas-cog" iconSize="36" />
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" text="Admin" />
                    <Button onAction="#openAdmin" prefHeight="40.0" prefWidth="140.0" styleClass="btn-secondary" text="Bientôt" disable="true" />
                </VBox>
            </HBox>
        </VBox>
    </HBox>
</AnchorPane>
