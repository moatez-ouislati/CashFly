<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="root" stylesheets="@Styles/custom.css" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.cashfly.controllers.UpdateJPOController">

    <!-- Header -->
    <HBox alignment="CENTER" prefHeight="80.0" prefWidth="1280.0" spacing="20.0" styleClass="app-header" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets left="30.0" right="30.0" />
        </padding>
        <Label styleClass="app-header-title" text="Modifier une Journée Portes Ouvertes" />
    </HBox>

    <!-- Back Button -->
    <Button fx:id="backButton" layoutX="59.0" layoutY="100.0" mnemonicParsing="false" onAction="#handleBack" styleClass="btn-secondary" text="← Retour" />

    <!-- Search Section -->
    <HBox alignment="CENTER" layoutX="200.0" layoutY="100.0" prefHeight="42.0" spacing="10.0" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="200.0">
        <TextField fx:id="searchField" promptText="Rechercher par ID ou Titre" HBox.hgrow="ALWAYS" />
        <Button onAction="#handleSearch" styleClass="btn-primary" text="Rechercher" />
    </HBox>

    <!-- Main Form Card -->
    <ScrollPane fitToWidth="true" layoutX="200.0" layoutY="160.0" prefHeight="540.0" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="200.0" AnchorPane.topAnchor="160.0">
        <content>
            <VBox fx:id="formContainer" disable="true" spacing="15.0" styleClass="card">
                <padding>
                    <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                </padding>

                <TextField fx:id="idField" managed="false" visible="false" />

                <!-- Current Image -->
                <VBox spacing="5.0">
                    <Label styleClass="form-label" text="Image actuelle" />
                    <ImageView fx:id="currentImageView" fitHeight="150.0" fitWidth="300.0" preserveRatio="true" />
                </VBox>

                <!-- Title -->
                <VBox spacing="5.0">
                    <Label styleClass="form-label" text="Titre *" />
                    <TextField fx:id="titreField" promptText="Entrez le titre de l'événement" />
                    <Label fx:id="titreError" styleClass="message-error" visible="false" />
                </VBox>

                <!-- Date and Location -->
                <HBox spacing="20.0">
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="form-label" text="Date *" />
                        <DatePicker fx:id="dateField" promptText="Sélectionnez une date" />
                        <Label fx:id="dateError" styleClass="message-error" visible="false" />
                    </VBox>
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="form-label" text="Lieu *" />
                        <TextField fx:id="lieuField" promptText="Entrez le lieu" />
                        <Label fx:id="lieuError" styleClass="message-error" visible="false" />
                    </VBox>
                </HBox>

                <!-- Max Participants -->
                <VBox spacing="5.0">
                    <Label styleClass="form-label" text="Nombre maximum de participants" />
                    <Spinner fx:id="maxParticipantsSpinner" editable="true" />
                </VBox>

                <!-- Description -->
                <VBox spacing="5.0">
                    <Label styleClass="form-label" text="Description" />
                    <TextArea fx:id="descriptionField" prefHeight="80.0" promptText="Description détaillée" wrapText="true" />
                </VBox>

                <!-- New Image -->
                <VBox spacing="8.0">
                    <Label styleClass="form-label" text="Nouvelle image (optionnel)" />
                    <HBox spacing="10.0">
                        <Button onAction="#handleSelectImage" styleClass="btn-secondary" text="Choisir une nouvelle image" />
                        <Label fx:id="newImageNameLabel" styleClass="text-muted" text="Aucune nouvelle image sélectionnée" />
                    </HBox>
                    <ImageView fx:id="newImagePreview" fitHeight="100.0" fitWidth="200.0" preserveRatio="true" />
                </VBox>

                <!-- Buttons -->
                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <Button onAction="#handleClear" styleClass="btn-secondary" text="Réinitialiser" />
                    <Button fx:id="updateButton" onAction="#handleUpdate" styleClass="btn-primary" text="Mettre à jour" />
                </HBox>
            </VBox>
        </content>
    </ScrollPane>
</AnchorPane>