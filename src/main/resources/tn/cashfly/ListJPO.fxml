<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="root" stylesheets="@Styles/custom.css" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.cashfly.controllers.ListJPOController">

    <!-- Header -->
    <HBox alignment="CENTER" prefHeight="80.0" prefWidth="1280.0" spacing="20.0" styleClass="app-header" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets left="30.0" right="30.0" />
        </padding>
        <Label styleClass="app-header-title" text="Calendrier des Journées Portes Ouvertes" />
    </HBox>

    <!-- Back Button -->
    <Button fx:id="backButton" layoutX="50.0" layoutY="100.0" mnemonicParsing="false" onAction="#handleBack" styleClass="btn-secondary" text="← Retour" />

    <!-- Main Content -->
    <HBox layoutX="50.0" layoutY="140.0" spacing="20.0" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" AnchorPane.topAnchor="140.0">

        <!-- Calendar -->
        <VBox spacing="15.0" styleClass="card" HBox.hgrow="ALWAYS">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <!-- Month Navigation -->
            <HBox alignment="CENTER" spacing="20.0">
                <Button onAction="#previousMonth" styleClass="btn-secondary" text="←" />
                <VBox alignment="CENTER">
                    <Label fx:id="monthLabel" styleClass="form-label" text="Janvier" />
                    <Label fx:id="yearLabel" styleClass="text-muted" text="2024" />
                </VBox>
                <Button onAction="#nextMonth" styleClass="btn-secondary" text="→" />
            </HBox>

            <!-- Calendar Grid -->
            <GridPane fx:id="calendarGrid" alignment="CENTER" hgap="8.0" vgap="8.0" VBox.vgrow="ALWAYS" />

            <!-- Legend -->
            <HBox spacing="20.0" alignment="CENTER">
                <HBox spacing="5.0" alignment="CENTER">
                    <Region prefHeight="15.0" prefWidth="15.0" style="-fx-background-color: -color-accent-subtle; -fx-background-radius: 3px;" />
                    <Label styleClass="text-muted" text="Avec événement" />
                </HBox>
                <HBox spacing="5.0" alignment="CENTER">
                    <Region prefHeight="15.0" prefWidth="15.0" style="-fx-background-color: transparent; -fx-border-color: -color-accent-emphasis; -fx-border-width: 2px; -fx-background-radius: 3px;" />
                    <Label styleClass="text-muted" text="Aujourd'hui" />
                </HBox>
            </HBox>
        </VBox>

        <!-- Event Details Panel -->
        <VBox fx:id="eventPanel" prefWidth="350.0" spacing="15.0" styleClass="card">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <Label fx:id="selectedDateTitle" styleClass="form-label" text="Sélectionnez une date" />

            <ScrollPane fx:id="eventsScrollPane" fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                <content>
                    <VBox fx:id="eventsContainer" spacing="15.0" />
                </content>
            </ScrollPane>

            <Label fx:id="noEventsLabel" styleClass="text-muted" text="Aucun événement pour cette date" visible="true" />
        </VBox>
    </HBox>
</AnchorPane>