<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="root" stylesheets="@Styles/custom.css" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.cashfly.controllers.AddJPOController">

    <!-- Header -->
    <HBox alignment="CENTER" prefHeight="80.0" prefWidth="1280.0" spacing="20.0" styleClass="app-header" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets left="30.0" right="30.0" />
        </padding>
        <Label styleClass="app-header-title" text="Créer une Journée Portes Ouvertes" />
    </HBox>

    <!-- Back Button -->
    <Button fx:id="backButton" layoutX="54.0" layoutY="100.0" mnemonicParsing="false" onAction="#handleBack" styleClass="btn-secondary" text="← Retour" />

    <!-- Main Form Card -->
    <ScrollPane fitToWidth="true" layoutX="200.0" layoutY="140.0" prefHeight="560.0" prefWidth="880.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="200.0" AnchorPane.rightAnchor="200.0" AnchorPane.topAnchor="140.0">
        <content>
            <VBox spacing="15.0" styleClass="card">
                <padding>
                    <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                </padding>

                <!-- Title Field -->
                <VBox spacing="5.0">
                    <Label styleClass="form-label" text="Titre *" />
                    <TextField fx:id="titreField" promptText="Entrez le titre de l'événement" />
                    <Label fx:id="titreError" styleClass="message-error" text="Le titre est obligatoire" visible="false" />
                </VBox>

                <!-- Date and Location Row -->
                <HBox spacing="20.0">
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="form-label" text="Date de l'événement *" />
                        <DatePicker fx:id="dateField" prefHeight="42.0" promptText="Sélectionnez une date" />
                        <Label fx:id="dateError" styleClass="message-error" text="La date est obligatoire" visible="false" />
                    </VBox>
                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="form-label" text="Lieu *" />
                        <TextField fx:id="lieuField" promptText="Entrez le lieu" />
                        <Label fx:id="lieuError" styleClass="message-error" text="Le lieu est obligatoire" visible="false" />
                    </VBox>
                </HBox>

                <!-- Max Participants -->
                <VBox spacing="5.0">
                    <Label styleClass="form-label" text="Nombre maximum de participants *" />
                    <Spinner fx:id="maxParticipantsSpinner" editable="true" />
                    <Label fx:id="maxParticipantsError" styleClass="message-error" text="Minimum 1 participant" visible="false" />
                </VBox>

                <!-- Description Field -->
                <VBox spacing="5.0">
                    <Label styleClass="form-label" text="Description" />
                    <TextArea fx:id="descriptionField" prefHeight="100.0" promptText="Entrez une description détaillée (optionnel)" wrapText="true" />
                </VBox>

                <!-- Image Upload -->
                <VBox spacing="8.0">
                    <Label styleClass="form-label" text="Image de l'événement" />
                    <HBox spacing="10.0">
                        <Button onAction="#handleSelectImage" styleClass="btn-secondary" text="Choisir une image" />
                        <Label fx:id="imageNameLabel" styleClass="text-muted" text="Aucune image sélectionnée" />
                    </HBox>
                    <ImageView fx:id="imagePreview" fitHeight="150.0" fitWidth="300.0" preserveRatio="true" />
                </VBox>

                <!-- Action Buttons -->
                <HBox alignment="CENTER_RIGHT" spacing="15.0">
                    <Button onAction="#handleClear" styleClass="btn-secondary" text="Effacer" />
                    <Button fx:id="saveButton" onAction="#handleSave" styleClass="btn-primary" text="Enregistrer" />
                </HBox>
            </VBox>
        </content>
    </ScrollPane>
</AnchorPane>