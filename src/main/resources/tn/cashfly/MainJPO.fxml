<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="root" stylesheets="@Styles/custom.css" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.cashfly.controllers.MainJPOController">

   <!-- Header -->
   <HBox alignment="CENTER" prefHeight="80.0" prefWidth="1280.0" styleClass="app-header" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <padding>
         <Insets left="30.0" right="30.0" />
      </padding>
      <Label styleClass="app-header-title" text="Gestion des Journées Portes Ouvertes" />
   </HBox>

   <!-- Sidebar -->
   <VBox prefHeight="640.0" prefWidth="220.0" spacing="10.0" styleClass="sidebar" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="80.0">
      <padding>
         <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
      </padding>

      <Label styleClass="sidebar-title" text="MENU PRINCIPAL" />

      <Button fx:id="addJPO" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="btn-icon" text="Calendrier JPO">
      </Button>

      <Region VBox.vgrow="ALWAYS" />

      <Button fx:id="logoutBtn" maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="btn-icon" text="🚪 Déconnexion" />
   </VBox>

   <!-- Content Area -->
   <AnchorPane fx:id="contentArea" prefHeight="640.0" prefWidth="1060.0" styleClass="content-area" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="220.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="80.0">
      <padding>
         <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
      </padding>

      <VBox fx:id="welcomeView" alignment="CENTER" prefWidth="500.0" spacing="15.0" styleClass="card" AnchorPane.leftAnchor="280.0" AnchorPane.rightAnchor="280.0" AnchorPane.topAnchor="150.0">
         <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
         </padding>

         <Label fx:id="welcomeLabel" text="Bienvenue dans CashFly JPO">
            <font>
               <Font name="System Bold" size="24.0" />
            </font>
         </Label>

         <Label styleClass="text-muted" text="Gérez vos journées portes ouvertes efficacement" wrapText="true" alignment="CENTER" />

         <Label styleClass="text-muted" text="Sélectionnez une action dans le menu de gauche pour commencer." wrapText="true" alignment="CENTER" />

         <HBox alignment="CENTER" spacing="15.0">
            <Label styleClass="text-success" text="✓ Système opérationnel" />
         </HBox>
      </VBox>
   </AnchorPane>
</AnchorPane>