<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.paint.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="1100.0" styleClass="root" stylesheets="@Styles/custom.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.cashfly.controllers.DeleteJPOController">
    <children>
        <!-- Header -->
        <HBox alignment="CENTER" prefHeight="80.0" prefWidth="1100.0" spacing="20.0" styleClass="app-header" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets left="30.0" right="30.0" />
            </padding>
            <children>
                <ImageView fx:id="cashflyLogoHeader" fitHeight="50.0" fitWidth="50.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@Images/Logo4.png" />
                    </image>
                </ImageView>
                <Label fx:id="ManageJPOTitleHeader" text="Gestion des Journées Portes Ouvertes">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                    <textFill>
                        <LinearGradient endX="1.0" endY="0.0">
                            <stops>
                                <Stop offset="0.0">
                                    <color>
                                        <Color red="0.0" green="0.5137254901960784" blue="1.0" />
                                    </color>
                                </Stop>
                                <Stop offset="1.0">
                                    <color>
                                        <Color red="0.0" green="1.0" blue="0.9921568627450981" />
                                    </color>
                                </Stop>
                            </stops>
                        </LinearGradient>
                    </textFill>
                </Label>
            </children>
        </HBox>

        <!-- Back Button -->
        <Button fx:id="backButton" layoutX="30.0" layoutY="100.0" mnemonicParsing="false" onAction="#handleBack" styleClass="btn-secondary" text="← Retour" />

        <!-- Search Section -->
        <HBox alignment="CENTER" layoutX="250.0" layoutY="100.0" spacing="10.0" AnchorPane.leftAnchor="250.0" AnchorPane.rightAnchor="250.0">
            <TextField fx:id="searchField" promptText="Rechercher par ID ou Titre" HBox.hgrow="ALWAYS" />
            <Button onAction="#handleSearch" styleClass="btn-primary" text="Rechercher" />
        </HBox>

        <!-- Results Card -->
        <VBox fx:id="resultCard" layoutX="250.0" layoutY="150.0" prefWidth="600.0" spacing="20.0" styleClass="card" visible="false" AnchorPane.leftAnchor="250.0" AnchorPane.rightAnchor="250.0" AnchorPane.topAnchor="150.0">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>

            <Label styleClass="form-label" text="JPO trouvée :" />

            <GridPane hgap="10.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="100.0" />
                    <ColumnConstraints />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
                <children>
                    <Label text="ID :" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <Label fx:id="idLabel" styleClass="text-muted" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Titre :" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <Label fx:id="titreLabel" styleClass="text-muted" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Date :" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                    <Label fx:id="dateLabel" styleClass="text-muted" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label text="Lieu :" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                    <Label fx:id="lieuLabel" styleClass="text-muted" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                </children>
            </GridPane>

            <!-- FIXED: Use styleClass instead of textFill -->
            <Label fx:id="confirmLabel" styleClass="text-danger" text="Êtes-vous sûr de vouloir supprimer cette JPO ?" />

            <!-- Action Buttons -->
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
                <Button onAction="#handleCancel" styleClass="btn-secondary" text="Annuler" />
                <Button onAction="#handleDelete" styleClass="btn-danger" text="Supprimer définitivement" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>