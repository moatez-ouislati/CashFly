<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" styleClass="root" stylesheets="@Styles/custom.css" xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.cashfly.controllers.DeleteJPOController">

    <!-- Header -->
    <HBox alignment="CENTER" prefHeight="80.0" prefWidth="1280.0" spacing="20.0" styleClass="app-header" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
        <padding>
            <Insets left="30.0" right="30.0" />
        </padding>
        <Label styleClass="app-header-title" text="Supprimer une Journée Portes Ouvertes" />
    </HBox>

    <!-- Back Button -->
    <Button fx:id="backButton" layoutX="57.0" layoutY="100.0" mnemonicParsing="false" onAction="#handleBack" styleClass="btn-secondary" text="← Retour" />

    <!-- Search Section -->
    <HBox alignment="CENTER" layoutX="250.0" layoutY="100.0" spacing="10.0" AnchorPane.leftAnchor="250.0" AnchorPane.rightAnchor="250.0">
        <TextField fx:id="searchField" promptText="Rechercher par ID ou Titre" HBox.hgrow="ALWAYS" />
        <Button onAction="#handleSearch" styleClass="btn-primary" text="Rechercher" />
    </HBox>

    <!-- Results Card -->
    <VBox fx:id="resultCard" layoutX="250.0" layoutY="160.0" prefWidth="780.0" spacing="20.0" styleClass="card" visible="false" AnchorPane.leftAnchor="250.0" AnchorPane.rightAnchor="250.0">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
        </padding>

        <Label styleClass="form-label" text="JPO trouvée :" />

        <HBox spacing="30.0" alignment="CENTER_LEFT">
            <GridPane fx:id="detailsGrid" hgap="10.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="80.0" />
                    <ColumnConstraints minWidth="200.0" />
                </columnConstraints>
                <Label text="ID :" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label fx:id="idLabel" styleClass="text-muted" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Label text="Titre :" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Label fx:id="titreLabel" styleClass="text-muted" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label text="Date :" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <Label fx:id="dateLabel" styleClass="text-muted" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Label text="Lieu :" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <Label fx:id="lieuLabel" styleClass="text-muted" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            </GridPane>

            <Region HBox.hgrow="ALWAYS" />
            <ImageView fx:id="eventImageView" fitHeight="150.0" fitWidth="200.0" preserveRatio="true" />
        </HBox>

        <Label fx:id="confirmLabel" styleClass="text-danger" text="Êtes-vous sûr de vouloir supprimer cette JPO ?" />

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <Button onAction="#handleCancel" styleClass="btn-secondary" text="Annuler" />
            <Button onAction="#handleDelete" styleClass="btn-danger" text="Supprimer définitivement" />
        </HBox>
    </VBox>
</AnchorPane>