<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/20"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.cashfly.controllers.StatistiqueUIController"
      spacing="16.0" style="-fx-background-color: #f8fafc;"
      stylesheets="@style.css" styleClass="root-pane">
    <padding>
        <Insets top="24.0" right="32.0" bottom="24.0" left="32.0"/>
    </padding>

    <HBox spacing="12.0" alignment="CENTER_LEFT">
        <children>
            <Label text="Statistiques" style="-fx-text-fill: #0f172a;">
                <font><Font name="System Bold" size="20.0"/></font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Périmètre"/>
            <ComboBox fx:id="scopeBox" prefWidth="160.0"/>
            <Label text="De"/>
            <DatePicker fx:id="fromDate"/>
            <Label text="à"/>
            <DatePicker fx:id="toDate"/>
            <Button text="Mettre à jour" onAction="#onRefresh" styleClass="btn-primary"/>
        </children>
    </HBox>

    <HBox spacing="16.0" VBox.vgrow="ALWAYS">
        <children>
            <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                <children>
                    <Label text="Répartition revenus vs dépenses" style="-fx-text-fill: #475569; -fx-font-size: 14; -fx-font-weight: bold;"/>
                    <PieChart fx:id="pieChart" prefHeight="300.0"/>
                    <HBox spacing="16.0">
                        <children>
                            <Label text="Revenus:"/>
                            <Label fx:id="revenusLabel" text="0 TND" style="-fx-font-weight: bold; -fx-text-fill: #059669;"/>
                            <Label text="Dépenses:"/>
                            <Label fx:id="depensesLabel" text="0 TND" style="-fx-font-weight: bold; -fx-text-fill: #dc2626;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Solde:"/>
                            <Label fx:id="soldeLabel" text="0 TND" style="-fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
                        </children>
                    </HBox>
                    <Separator/>
                    <Label text="Prédiction financière (Mois prochain)" style="-fx-text-fill: #475569; -fx-font-size: 14; -fx-font-weight: bold;"/>
                    <VBox style="-fx-background-color: #f1f5f9; -fx-padding: 15; -fx-background-radius: 10;">
                        <children>
                            <Label fx:id="predictionLabel" text="Analyse des données en cours..." wrapText="true" style="-fx-text-fill: #1e293b; -fx-font-style: italic;"/>
                        </children>
                    </VBox>
                </children>
            </VBox>
            <VBox spacing="8.0" prefWidth="520.0">
                <children>
                    <Label text="Évolution mensuelle" style="-fx-text-fill: #475569; -fx-font-size: 14; -fx-font-weight: bold;"/>
                    <LineChart fx:id="lineChart" prefHeight="300.0">
                        <xAxis><CategoryAxis label="Mois"/></xAxis>
                        <yAxis><NumberAxis label="Montant"/></yAxis>
                    </LineChart>
                    <Label text="Montants par catégorie" style="-fx-text-fill: #475569; -fx-font-size: 14; -fx-font-weight: bold;"/>
                    <BarChart fx:id="barChart" prefHeight="300.0">
                        <xAxis><CategoryAxis label="Catégorie"/></xAxis>
                        <yAxis><NumberAxis label="Montant (TND)"/></yAxis>
                    </BarChart>
                </children>
            </VBox>
        </children>
    </HBox>
</VBox>
