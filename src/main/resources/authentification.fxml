<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<HBox prefWidth="800" prefHeight="520"
      xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.cashfly.controllers.AuthentificationController"
      stylesheets="@styles/inscription.css">

    <!-- LEFT -->
    <VBox prefWidth="320"
          alignment="CENTER"
          spacing="10"
          styleClass="left-pane">
        <Label text="CASHFLY" styleClass="app-name"/>
        <Label text="Votre croissance, notre mission" styleClass="slogan"/>
    </VBox>

    <!-- RIGHT -->
    <VBox spacing="14"
          styleClass="right-pane"
          prefWidth="480">

        <padding>
            <Insets top="30" right="40" bottom="30" left="40"/>
        </padding>

        <Label fx:id="titleLabel" styleClass="title"/>
        <Label fx:id="subtitleLabel" styleClass="subtitle"/>

        <TextField fx:id="tfemail" styleClass="input"/>
        <PasswordField fx:id="tfmdp" styleClass="input"/>

        <Label fx:id="lblMessage" style="-fx-text-fill:red; -fx-wrap-text: true;"/>

        <Button fx:id="btn_auth"
                text="Se connecter"
                styleClass="btn-primary"
                onAction="#login"/>

        <!-- ========== SÉPARATEUR ========== -->
        <HBox alignment="CENTER" spacing="10">
            <Separator HBox.hgrow="ALWAYS"/>
            <Label text="OU" style="-fx-text-fill: #888; -fx-font-size: 12px;"/>
            <Separator HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- ========== BOUTON GOOGLE ========== -->
        <Button fx:id="btnGoogle"
                text="🔵  Se connecter avec Google"
                styleClass="btn-google"
                onAction="#loginWithGoogle"
                prefWidth="400"/>

        <HBox alignment="CENTER" spacing="20">
            <Hyperlink fx:id="linkForgot" onAction="#forgotPassword" text="Mot de passe oublié ?"/>
            <Hyperlink fx:id="linkRegister" onAction="#goToInscription" text="Créer un compte"/>
        </HBox>

    </VBox>
</HBox>
